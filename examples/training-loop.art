import relative {../src/learn}!

xTrain: tensor [0.0 1.0 2.0 3.0]
yTrain: tensor [1.0 3.0 5.0 7.0]

model: graph [
    x: input
    y: input
    w: parameter 0.0
    b: parameter 0.0
    scaled: x * w
    prediction: scaled + b
    residual: prediction - y
    loss: mean square residual
]

optimizer: sgd.rate: 0.05 (parameters model)
scheduler: stepLr.every: 50.factor: 0.8 optimizer
iterator: batcher.size: 2.seed: 7 xTrain yTrain
validation: #[features: xTrain targets: yTrain]
history: train.epochs: 100.validation: validation.clip: 10.0.scheduler: scheduler model optimizer iterator

print ~"w = |model\w|"
print ~"b = |model\b|"
print ~"final epoch = |last history\epochs|"
