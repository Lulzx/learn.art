import relative {../src/learn}!

do [
    x: tensor [[0.0] [1.0] [2.0] [3.0]]
    y: tensor [[1.0] [3.0] [5.0] [7.0]]

    model: graph [
        w: parameter.random [1 1]
        b: parameter.zeros [1]
        linear: matmul x w
        prediction: linear + b
        residual: prediction - y
        squared: square residual
        loss: mean squared
    ]

    optimizer: sgd.rate: 0.05 (parameters model)

    do.times: 500 [
        zeroGrad model
        forward model
        backward model\loss
        step optimizer
    ]

    print model\w
    print model\b
]
