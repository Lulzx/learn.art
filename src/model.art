; Named differentiable graphs, parameters, and stateful SGD.

import relative {./autograd}!

define :learnGraph [
    init: constructor [values names parameterList inputList source feeds training]

    get: method [what][
        if key? this\values what -> return this\values\[what]
        panic ~"learn: graph has no value named |what|"
    ]

    dictionary: method [][graphData this]

    string: method [][~"learn graph |this\names|"]
]

define :learnSgd [
    init: constructor [parameterList rate]
    string: method [][~"SGD(rate: |this\rate|, parameters: |size this\parameterList|)"]
]

define :learnMomentum [
    init: constructor [parameterList rate beta velocities]
]

define :learnAdam [
    init: constructor [parameterList rate beta1 beta2 epsilon firstMoments secondMoments timestep]
]

define :learnDenseLayer [
    init: constructor [name weight bias]
]

; `input` intentionally replaces Arturo's terminal-input word after import.
; In a graph block it constructs a symbolic, initially scalar placeholder.
input: function [][
    return lrMakeValue #[
        value: tensor 0.0
        requiresGradient: false
        operation: 'input
        parents: lrFreshBlock
        parameter: false
    ]
]

inputShape: function [dims][
    placeholder: tensor.zeros dims
    return lrMakeValue #[
        value: placeholder
        requiresGradient: false
        operation: 'input
        parents: lrFreshBlock
        parameter: false
    ]
]

parameter: function [dims][
    callAttrs: attrs
    makeZeros: key? callAttrs 'zeros
    makeRandom: key? callAttrs 'random

    unless or? [makeZeros][makeRandom] [
        source: lrAsTensor dims
        result: variable source
        result\parameter: true
        return result
    ]

    lrValidateShape dims
    data: lrFreshBlock
    count: lrCount dims
    if count > 0 [
        loop 1..count 'unused [
            item: 0.0
            if makeRandom -> item: lrRandomSmall
            'data ++ item
        ]
    ]
    source: lrMakeTensor dims data
    result: variable source
    result\parameter: true
    return result
]

lrGraphNames: function [body][
    result: lrFreshBlock
    loop body 'token [
        if label? token -> 'result ++ @[to :literal to :string token]
    ]
    return result
]

graph: function [body][
    unless block? body -> panic "learn: graph expects a block"
    bodyNames: lrGraphNames body
    if empty? bodyNames -> panic "learn: graph must contain labeled expressions"

    ; The block runs in this call frame. Its labels therefore become visible
    ; through `symbols`, while references to the caller's tensors remain valid.
    do body
    scope: symbols
    graphValues: lrFreshDictionary
    inputList: lrFreshBlock

    loop bodyNames 'name [
        unless key? scope name -> panic ~"learn: graph could not evaluate |name|"
        item: scope\[name]
        unless or? [is? :learnValue item][is? :learnTensor item] ->
            panic ~"learn: graph value |name| is not a tensor expression"
        set graphValues name item
        if and? [is? :learnValue item][item\operation = 'input] -> 'inputList ++ @[name]
    ]

    parameterList: lrFreshBlock
    parameterNames: lrFreshBlock
    nestedNames: lrFreshBlock
    loop bodyNames 'name [
        item: graphValues\[name]
        if is? :learnValue item [
            topoOrder: lrTopo item
            loop topoOrder 'node [
                if and? [node\parameter][not? lrContainsIdentity? parameterList node] [
                    parameterName: null
                    loop bodyNames 'candidate [
                        candidateValue: graphValues\[candidate]
                        if and? [is? :learnValue candidateValue][candidateValue\id = node\id] -> parameterName: candidate
                    ]
                    if null? parameterName [
                        if and? [dictionary? node\context][key? node\context 'parameterName] -> parameterName: node\context\parameterName
                        if null? parameterName -> parameterName: to :literal ~"parameter_|size parameterList|"
                        if key? graphValues parameterName -> panic ~"learn: nested parameter name |parameterName| collides with a graph value"
                        set graphValues parameterName node
                        'nestedNames ++ parameterName
                    ]
                    if null? node\context -> node\context: #[parameterName: parameterName group: 'default]
                    if dictionary? node\context [
                        unless key? node\context 'parameterName -> set node\context 'parameterName parameterName
                        unless key? node\context 'group -> set node\context 'group 'default
                        unless key? node\context 'trainable -> set node\context 'trainable true
                    ]
                    'parameterList ++ @[node]
                    'parameterNames ++ parameterName
                ]
            ]
        ]
    ]

    names: new nestedNames
    loop bodyNames 'name -> 'names ++ name

    args: lrArgs 7
    set args 0 graphValues
    set args 1 names
    set args 2 parameterList
    set args 3 inputList
    set args 4 new body
    graphFeeds: lrFreshDictionary
    set args 5 graphFeeds
    set args 6 true
    resultGraph: to :learnGraph args
    ; Arturo object construction aliases empty dictionary fields across
    ; instances, so install the per-graph feed store explicitly.
    set resultGraph 'feeds graphFeeds
    return resultGraph
]

trainMode: function [model][
    unless is? :learnGraph model -> panic "learn: trainMode expects a graph"
    model\training: true
    loop model\names 'name [
        item: model\values\[name]
        if and? [is? :learnValue item][item\operation = 'dropout] -> item\context\training: true
    ]
    return model
]

evalMode: function [model][
    unless is? :learnGraph model -> panic "learn: evalMode expects a graph"
    model\training: false
    loop model\names 'name [
        item: model\values\[name]
        if and? [is? :learnValue item][item\operation = 'dropout] -> item\context\training: false
    ]
    return model
]

trainingMode?: function [model][
    unless is? :learnGraph model -> panic "learn: trainingMode? expects a graph"
    return model\training
]

inputs: function [model][
    unless is? :learnGraph model -> panic "learn: inputs expects a graph"
    return new model\inputList
]

parameters: function [model][
    unless is? :learnGraph model -> panic "learn: parameters expects a graph"
    requestedGroup: attr 'group
    unless null? requestedGroup [
        groupName: to :literal requestedGroup
        groups: parameterGroups model
        if key? groups groupName -> return groups\[groupName]
        return lrFreshBlock
    ]
    return model\parameterList
]

trainableParameters: function [model][
    result: lrFreshBlock
    loop parameters model 'item [if lrParameterTrainable? item -> 'result ++ @[item]]
    return result
]

parameterGroups: function [model][
    unless is? :learnGraph model -> panic "learn: parameterGroups expects a graph"
    groups: lrFreshDictionary
    loop model\parameterList 'item [
        groupName: 'default
        if and? [dictionary? item\context][key? item\context 'group] -> groupName: item\context\group
        unless key? groups groupName -> set groups groupName lrFreshBlock
        groupItems: groups\[groupName]
        'groupItems ++ @[item]
    ]
    return groups
]

denseLayer: function [inputSize outputSize][
    callAttrs: attrs
    name: 'dense
    makeZeros: key? callAttrs 'zeros
    if key? callAttrs 'name -> name: to :literal callAttrs\name
    unless and? [integer? inputSize][inputSize > 0] -> panic "learn: denseLayer input size must be positive"
    unless and? [integer? outputSize][outputSize > 0] -> panic "learn: denseLayer output size must be positive"
    weightName: to :literal ~"|name|_weight"
    biasName: to :literal ~"|name|_bias"
    weight: (makeZeros)? -> parameter.zeros @[inputSize outputSize] -> parameter.random @[inputSize outputSize]
    bias: parameter.zeros @[outputSize]
    weight\context: #[parameterName: weightName group: name trainable: true]
    bias\context: #[parameterName: biasName group: name trainable: true]
    args: lrArgs 3
    set args 0 name
    set args 1 weight
    set args 2 bias
    return to :learnDenseLayer args
]

applyLayer: function [layer inputValue][
    unless is? :learnDenseLayer layer -> panic "learn: applyLayer expects a layer"
    return lrValueDense inputValue layer\weight layer\bias
]

layerParameters: function [layer][
    unless is? :learnDenseLayer layer -> panic "learn: layerParameters expects a layer"
    return @[layer\weight layer\bias]
]

lrSetTrainable: function [target enabled][
    if is? :learnDenseLayer target [
        target\weight\context\trainable: enabled
        target\bias\context\trainable: enabled
        unless enabled [
            target\weight\gradient: null
            target\bias\gradient: null
        ]
        return target
    ]
    if is? :learnGraph target [
        loop target\parameterList 'item [
            item\context\trainable: enabled
            unless enabled -> item\gradient: null
        ]
        return target
    ]
    items: lrFreshBlock
    if block? target -> items: target
    if and? [is? :learnValue target][target\parameter] -> items: @[target]
    if empty? items -> panic "learn: freeze target has no parameters"
    loop items 'item [
        unless and? [is? :learnValue item][item\parameter] -> panic "learn: freeze expects parameters, a layer, or a graph"
        if dictionary? item\context -> item\context\trainable: enabled
        unless enabled -> item\gradient: null
    ]
    return target
]

freezeParameters: function [target][lrSetTrainable target false]

unfreezeParameters: function [target][lrSetTrainable target true]

freezeGroup: function [model groupName][
    normalizedName: to :literal groupName
    groups: parameterGroups model
    unless key? groups normalizedName -> panic ~"learn: graph has no parameter group |normalizedName|"
    loop model\parameterList 'item [
        if item\context\group = normalizedName [
            item\context\trainable: false
            item\gradient: null
        ]
    ]
    return model
]

unfreezeGroup: function [model groupName][
    normalizedName: to :literal groupName
    groups: parameterGroups model
    unless key? groups normalizedName -> panic ~"learn: graph has no parameter group |normalizedName|"
    loop model\parameterList 'item [if item\context\group = normalizedName -> item\context\trainable: true]
    return model
]

trainabilityState: function [model][
    unless is? :learnGraph model -> panic "learn: trainabilityState expects a graph"
    entries: lrFreshBlock
    loop model\parameterList 'item -> 'entries ++ @[#[name: item\context\parameterName trainable: lrParameterTrainable? item]]
    return #[format: "learn.trainability-state" version: "0.19" parameters: entries]
]

lrValidateTrainabilityState: function [model state][
    unless is? :learnGraph model -> panic "learn: trainability state expects a graph"
    unless and? [dictionary? state][and? [key? state 'format][state\format = "learn.trainability-state"]] -> panic "learn: unsupported trainability state format"
    unless and? [key? state 'version][state\version = "0.19"] -> panic "learn: unsupported trainability state version"
    unless and? [key? state 'parameters][block? state\parameters] -> panic "learn: trainability parameters are invalid"
    unless (size state\parameters) = (size model\parameterList) -> panic "learn: trainability parameter count does not match"
    live: lrFreshDictionary
    loop model\parameterList 'item -> set live item\context\parameterName item
    seen: lrFreshDictionary
    validated: lrFreshBlock
    loop state\parameters 'entry [
        unless and? [dictionary? entry][and? [key? entry 'name][key? entry 'trainable]] -> panic "learn: trainability entry is malformed"
        name: to :literal entry\name
        unless key? live name -> panic ~"learn: graph has no parameter named |name|"
        if key? seen name -> panic ~"learn: duplicate trainability parameter |name|"
        unless logical? entry\trainable -> panic ~"learn: trainability flag for |name| is invalid"
        set seen name true
        'validated ++ @[#[parameter: live\[name] trainable: entry\trainable]]
    ]
    return validated
]

lrApplyValidatedTrainabilityState: function [validated][
    loop validated 'entry [
        entry\parameter\context\trainable: entry\trainable
        unless entry\trainable -> entry\parameter\gradient: null
    ]
    return null
]

loadTrainabilityState: function [model state][
    validated: lrValidateTrainabilityState model state
    lrApplyValidatedTrainabilityState validated
    return model
]

forward: function [model][
    callAttrs: attrs
    unless is? :learnGraph model -> panic "learn: forward expects a graph"

    if key? callAttrs 'with [
        feed: callAttrs\with
        unless dictionary? feed -> panic "learn: forward.with expects a dictionary of input values"
        loop keys feed 'name [
            unless contains? model\inputList to :literal name ->
                panic ~"learn: graph has no input named |name|"
        ]
        loop model\inputList 'name [
            if key? feed name [
            node: model\values\[name]
            node\value: lrAsTensor feed\[name]
            set model\feeds name true
            ]
        ]
    ]

    loop model\inputList 'name [
        unless key? model\feeds name -> panic ~"learn: input |name| has not been provided"
    ]

    recomputed: lrFreshBlock
    loop model\names 'name [
        item: model\values\[name]
        if is? :learnValue item [
            topoOrder: lrTopo item
            loop topoOrder 'node [
                unless lrContainsIdentity? recomputed node [
                    lrForwardNode node
                    'recomputed ++ @[node]
                ]
            ]
        ]
    ]
    return model
]

operations: function [model][
    unless is? :learnGraph model -> panic "learn: operations expects a graph"
    result: lrFreshBlock
    loop model\names 'name [
        item: model\values\[name]
        if is? :learnValue item [
            unless contains? ['leaf 'constant 'input] item\operation -> 'result ++ @[name]
        ]
    ]
    return result
]

lrGraphNameOf: function [model sought][
    loop model\names 'name [
        candidate: model\values\[name]
        if and? [is? :learnValue candidate][candidate\id = sought\id] -> return name
    ]
    return null
]

lrTensorData: function [value][
    source: lrAsTensor value
    return #[shape: new source\shape device: source\device data: new source\data]
]

lrGraphNodeData: function [model name][
    item: model\values\[name]
    if is? :learnTensor item ->
        return #[role: 'constant value: lrTensorData item]

    role: 'operation
    if contains? ['leaf 'constant] item\operation -> role: 'constant
    if item\operation = 'input -> role: 'input
    if item\parameter -> role: 'parameter

    parentData: lrFreshBlock
    loop item\parents 'parent [
        parentName: lrGraphNameOf model parent
        if null? parentName -> 'parentData ++ @[#[role: 'constant value: lrTensorData parent\value]]
        unless null? parentName -> 'parentData ++ @[parentName]
    ]

    contextData: item\context
    if item\operation = 'dropout -> contextData: #[rate: item\context\rate seed: item\context\seed pass: item\context\pass training: item\context\training]
    return #[
        role: role
        operation: item\operation
        shape: new item\value\shape
        device: item\value\device
        parents: parentData
        context: contextData
        value: (role = 'parameter)? -> lrTensorData item\value -> null
    ]
]

graphData: function [model][
    unless is? :learnGraph model -> panic "learn: graphData expects a graph"
    nodes: lrFreshDictionary
    parameterNames: lrFreshBlock
    loop model\names 'name [
        nodeData: lrGraphNodeData model name
        set nodes name nodeData
    ]
    loop model\parameterList 'item -> 'parameterNames ++ item\context\parameterName
    return #[
        format: "learn.graph"
        version: "0.2"
        inputs: new model\inputList
        parameters: parameterNames
        order: new model\names
        nodes: nodes
    ]
]

explain: function [model][
    data: graphData model
    lines: @[~"graph(inputs: |data\inputs|, parameters: |data\parameters|)"]
    loop data\order 'name [
        node: data\nodes\[name]
        'lines ++ ~"|name|: |node\role| |node\operation| <- |node\parents|"
    ]
    return join.with: "\n" lines
]

sgd: function [parameterList][
    rate: 0.01
    requestedRate: attr 'rate
    unless null? requestedRate -> rate: requestedRate
    unless lrNumeric? rate -> panic "learn: SGD rate must be numeric"
    unless rate > 0 -> panic "learn: SGD rate must be positive"

    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] ->
            panic "learn: SGD expects parameter values"
    ]

    args: lrArgs 2
    set args 0 parameterList
    set args 1 to :floating rate
    return to :learnSgd args
]

lrValidateParameters: function [parameterList][
    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] ->
            panic "learn: optimizer expects parameter values"
    ]
    return parameterList
]

momentum: function [parameterList][
    callAttrs: attrs
    rate: 0.01
    beta: 0.9
    if key? callAttrs 'rate -> rate: callAttrs\rate
    if key? callAttrs 'beta -> beta: callAttrs\beta
    unless and? [lrNumeric? rate][rate > 0.0] -> panic "learn: momentum rate must be positive"
    unless and? [lrNumeric? beta][and? [beta >= 0.0][beta < 1.0]] -> panic "learn: momentum beta must be in [0, 1)"
    lrValidateParameters parameterList
    velocities: lrFreshBlock
    loop parameterList 'item -> 'velocities ++ lrZerosLike item\value
    args: lrArgs 4
    set args 0 parameterList
    set args 1 to :floating rate
    set args 2 to :floating beta
    set args 3 velocities
    return to :learnMomentum args
]

adam: function [parameterList][
    callAttrs: attrs
    rate: 0.001
    beta1: 0.9
    beta2: 0.999
    epsilon: 0.00000001
    if key? callAttrs 'rate -> rate: callAttrs\rate
    if key? callAttrs 'beta1 -> beta1: callAttrs\beta1
    if key? callAttrs 'beta2 -> beta2: callAttrs\beta2
    if key? callAttrs 'epsilon -> epsilon: callAttrs\epsilon
    unless and? [lrNumeric? rate][rate > 0.0] -> panic "learn: Adam rate must be positive"
    unless and? [lrNumeric? beta1][and? [beta1 >= 0.0][beta1 < 1.0]] -> panic "learn: Adam beta1 must be in [0, 1)"
    unless and? [lrNumeric? beta2][and? [beta2 >= 0.0][beta2 < 1.0]] -> panic "learn: Adam beta2 must be in [0, 1)"
    unless and? [lrNumeric? epsilon][epsilon > 0.0] -> panic "learn: Adam epsilon must be positive"
    lrValidateParameters parameterList
    firstMoments: lrFreshBlock
    secondMoments: lrFreshBlock
    loop parameterList 'item [
        'firstMoments ++ lrZerosLike item\value
        'secondMoments ++ lrZerosLike item\value
    ]
    args: lrArgs 8
    set args 0 parameterList
    set args 1 to :floating rate
    set args 2 to :floating beta1
    set args 3 to :floating beta2
    set args 4 to :floating epsilon
    set args 5 firstMoments
    set args 6 secondMoments
    set args 7 0
    return to :learnAdam args
]

step: function [optimizer][
    supported: or? [is? :learnSgd optimizer][or? [is? :learnMomentum optimizer][is? :learnAdam optimizer]]
    unless supported -> panic "learn: step expects an optimizer"

    if is? :learnAdam optimizer -> optimizer\timestep: optimizer\timestep + 1
    itemCount: size optimizer\parameterList
    if itemCount > 0 [loop 0..(itemCount - 1) 'i [
        item: optimizer\parameterList\[i]
        unless lrParameterTrainable? item -> continue
        if null? item\gradient -> panic "learn: cannot step a parameter without a gradient"
        update: null

        if is? :learnSgd optimizer -> update: lrTensorBinary item\gradient optimizer\rate 'mul
        if is? :learnMomentum optimizer [
            oldVelocity: optimizer\velocities\[i]
            retained: lrTensorBinary oldVelocity optimizer\beta 'mul
            velocity: lrTensorBinary retained item\gradient 'add
            set optimizer\velocities i velocity
            update: lrTensorBinary velocity optimizer\rate 'mul
        ]
        if is? :learnAdam optimizer [
            oldFirst: optimizer\firstMoments\[i]
            oldSecond: optimizer\secondMoments\[i]
            retainedFirst: lrTensorBinary oldFirst optimizer\beta1 'mul
            newFirstPart: lrTensorBinary item\gradient (1.0 - optimizer\beta1) 'mul
            firstMoment: lrTensorBinary retainedFirst newFirstPart 'add
            gradientSquare: lrTensorBinary item\gradient 2.0 'pow
            retainedSecond: lrTensorBinary oldSecond optimizer\beta2 'mul
            newSecondPart: lrTensorBinary gradientSquare (1.0 - optimizer\beta2) 'mul
            secondMoment: lrTensorBinary retainedSecond newSecondPart 'add
            set optimizer\firstMoments i firstMoment
            set optimizer\secondMoments i secondMoment
            firstCorrection: 1.0 - (optimizer\beta1 ^ optimizer\timestep)
            secondCorrection: 1.0 - (optimizer\beta2 ^ optimizer\timestep)
            correctedFirst: lrTensorBinary firstMoment firstCorrection 'div
            correctedSecond: lrTensorBinary secondMoment secondCorrection 'div
            rootSecond: lrTensorBinary correctedSecond 0.5 'pow
            denominator: lrTensorBinary rootSecond optimizer\epsilon 'add
            direction: lrTensorBinary correctedFirst denominator 'div
            update: lrTensorBinary direction optimizer\rate 'mul
        ]

        nextValue: lrTensorBinary item\value update 'sub
        item\value\data: nextValue\data
    ]]
    return optimizer
]
