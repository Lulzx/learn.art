; Dense, owned, row-major tensors of arbitrary rank.

import relative {./backend}!

lrFreshDictionary: function [][
    ; Empty literals are reused by Arturo 0.10. A dynamically allocated block
    ; prevents mutable state from leaking between calls.
    return to :dictionary array 0
]

lrFreshBlock: function [][
    return remove (array 0) 0
]

lrArgs: function [count][
    result: lrFreshBlock
    if count > 0 [loop 1..count 'unused -> 'result ++ null]
    return result
]

define :learnTensor [
    init: constructor [shape strides data device storage]

    add: method [that][(is? :learnValue that)? -> lrValueBinary this that 'add -> lrTensorBinary this that 'add]
    sub: method [that][(is? :learnValue that)? -> lrValueBinary this that 'sub -> lrTensorBinary this that 'sub]
    mul: method [that][(is? :learnValue that)? -> lrValueBinary this that 'mul -> lrTensorBinary this that 'mul]
    div: method [that][(is? :learnValue that)? -> lrValueBinary this that 'div -> lrTensorBinary this that 'div]
    pow: method [that][(is? :learnValue that)? -> lrValueBinary this that 'pow -> lrTensorBinary this that 'pow]
    neg: method [][lrTensorUnary this 'neg]

    string: method [][lrTensorString this]
]

define :learnTensorView [
    init: constructor [source shape axis start count step data device dtype]
    add: method [that][lrTensorBinary this that 'add]
    sub: method [that][lrTensorBinary this that 'sub]
    mul: method [that][lrTensorBinary this that 'mul]
    div: method [that][lrTensorBinary this that 'div]
    pow: method [that][lrTensorBinary this that 'pow]
    neg: method [][lrTensorUnary this 'neg]
    string: method [][lrTensorViewString this]
]

lrMakeStorageOwner: function [device handle][
    if null? handle -> return null
    owner: #[device: device handle: null references: 1 released: false]
    ; Preserve backend handle identity: Arturo dictionary literals copy nested
    ; dictionaries, while a storage handle may itself be a mutable record.
    set owner 'handle handle
    return owner
]

lrRetainStorageOwner: function [owner][
    if null? owner -> return null
    if owner\released -> panic "learn: cannot retain released tensor storage"
    owner\references: owner\references + 1
    return owner
]

lrReleaseStorageOwner: function [owner][
    if null? owner -> return null
    if owner\released -> return null
    owner\references: owner\references - 1
    if owner\references < 0 -> panic "learn: tensor storage reference count underflow"
    if owner\references = 0 [
        lrBackendCall owner\device 'release @[owner\handle]
        owner\handle: null
        owner\released: true
    ]
    return null
]

lrTensorStorageOwner: function [value][
    if key? value 'storageOwner -> return value\storageOwner
    if null? value\storage -> return null
    owner: lrMakeStorageOwner value\device value\storage
    set value 'storageOwner owner
    return owner
]

define :learnInitializer [
    init: constructor [kind seed low high]
]

initializer: function [requestedKind][
    callAttrs: attrs
    kind: to :literal requestedKind
    seed: 0
    low: 0.0 - 0.05
    high: 0.05
    if key? callAttrs 'seed -> seed: callAttrs\seed
    if key? callAttrs 'low -> low: callAttrs\low
    if key? callAttrs 'high -> high: callAttrs\high
    unless contains? ['xavier 'he 'uniform 'zeros] kind -> panic ~"learn: unsupported initializer |kind|"
    unless and? [integer? seed][seed >= 0] -> panic "learn: initializer seed must be a non-negative integer"
    unless and? [lrNumeric? low][lrNumeric? high] -> panic "learn: initializer bounds must be numeric"
    unless low < high -> panic "learn: initializer low bound must be below high bound"
    args: lrArgs 4
    set args 0 kind
    set args 1 seed
    set args 2 to :floating low
    set args 3 to :floating high
    return to :learnInitializer args
]

initializerState: function [spec][
    unless is? :learnInitializer spec -> panic "learn: initializerState expects an initializer"
    return #[format: "learn.initializer-state" version: "0.20" kind: spec\kind seed: spec\seed low: spec\low high: spec\high]
]

initializerFromState: function [state][
    unless and? [dictionary? state][and? [key? state 'format][state\format = "learn.initializer-state"]] -> panic "learn: unsupported initializer state format"
    unless and? [key? state 'version][state\version = "0.20"] -> panic "learn: unsupported initializer state version"
    loop ['kind 'seed 'low 'high] 'field [unless key? state field -> panic ~"learn: initializer state is missing |field|"]
    return initializer.seed: state\seed.low: state\low.high: state\high state\kind
]

lrInitializerFans: function [dims][
    lrValidateShape dims
    if empty? dims -> panic "learn: fan initializer requires a non-scalar shape"
    rank: size dims
    fanIn: dims\0
    fanOut: (rank = 1)? -> dims\0 -> last dims
    if rank > 2 [
        receptive: 1
        loop 1..(rank - 2) 'axis -> receptive: receptive * dims\[axis]
        fanIn: fanIn * receptive
        fanOut: fanOut * receptive
    ]
    unless and? [fanIn > 0][fanOut > 0] -> panic "learn: fan initializer requires positive dimensions"
    return @[fanIn fanOut]
]

lrInitializerBounds: function [spec dims][
    if spec\kind = 'uniform -> return @[spec\low spec\high]
    if spec\kind = 'zeros -> return @[0.0 0.0]
    fans: lrInitializerFans dims
    limit: 0.0
    if spec\kind = 'xavier -> limit: (6.0 / (fans\0 + fans\1)) ^ 0.5
    if spec\kind = 'he -> limit: (6.0 / fans\0) ^ 0.5
    return @[0.0 - limit limit]
]

initializeTensor: function [spec dims][
    unless is? :learnInitializer spec -> panic "learn: initializeTensor expects an initializer"
    lrValidateShape dims
    bounds: lrInitializerBounds spec dims
    count: lrCount dims
    data: lrFreshBlock
    state: spec\seed + 1
    if count > 0 [loop 1..count 'unused [
        value: 0.0
        unless spec\kind = 'zeros [
            state: ((state * 1103515245) + 12345) % 2147483648
            fraction: (to :floating state) / 2147483648.0
            value: bounds\0 + (fraction * (bounds\1 - bounds\0))
        ]
        'data ++ value
    ]]
    return lrMakeTensor dims data
]

lrNumeric?: function [value][
    return or? [integer? value][floating? value]
]

lrFloat: function [value][
    unless lrNumeric? value -> panic ~"learn: tensor values must be numeric, got |type value|"
    return to :floating value
]

lrRandomSmall: function [][
    return (random 0.0 0.2) - 0.1
]

lrCount: function [dims][
    if empty? dims -> return 1
    count: 1
    loop dims 'dim -> count: count * dim
    return count
]

lrStrides: function [dims][
    result: lrFreshBlock
    running: 1
    loop reverse dims 'dim [
        'result ++ running
        running: running * dim
    ]
    return reverse result
]

lrValidateShape: function [dims][
    unless block? dims -> panic "learn: a tensor shape must be a block"
    loop dims 'dim [
        unless integer? dim -> panic "learn: tensor dimensions must be integers"
        if dim < 0 -> panic "learn: tensor dimensions cannot be negative"
    ]
    return dims
]

lrNormalizeDevice: function [requested][
    device: requested
    if string? device -> device: to :literal device
    unless literal? device -> panic "learn: a tensor device must be a literal or string"
    unless backendAvailable? device -> panic ~"learn: device |device| is not available"
    return device
]

lrNormalizeDtype: function [requested][
    dtype: requested
    if string? dtype -> dtype: to :literal dtype
    unless contains? ['float32 'float64] dtype -> panic ~"learn: tensor dtype |dtype| is unsupported"
    return dtype
]

lrDefaultDtype: function [device][
    descriptor: lrBackend device
    if key? descriptor 'defaultDtype -> return lrNormalizeDtype descriptor\defaultDtype
    return 'float64
]

lrValidateDeviceDtype: function [device dtype][
    descriptor: lrBackend device
    if key? descriptor 'dtypes [
        unless contains? descriptor\dtypes dtype -> panic ~"learn: device |device| does not support dtype |dtype|"
    ]
    return dtype
]

lrPromoteDtype: function [left right][
    if or? [left = 'float64][right = 'float64] -> return 'float64
    return 'float32
]

lrInferShape: function [source][
    if lrNumeric? source -> return lrFreshBlock
    unless block? source -> panic ~"learn: tensor values must be numeric or nested blocks, got |type source|"
    if empty? source -> return [0]

    childShape: lrInferShape first source
    loop source 'item [
        itemShape: lrInferShape item
        unless itemShape = childShape -> panic "learn: tensor blocks must have a rectangular shape"
    ]
    result: @[(size source)]
    loop childShape 'dim -> 'result ++ dim
    return result
]

lrFlattenTensorData: function [source output][
    if lrNumeric? source [
        'output ++ lrFloat source
        return null
    ]
    loop source 'item -> lrFlattenTensorData item output
    return null
]

lrMakeTensor: function [dims data][
    return lrMakeTensorOn dims data 'cpu
]

lrMakeTensorOn: function [dims data requestedDevice][
    device: lrNormalizeDevice requestedDevice
    return lrMakeTensorTypedOn dims data device (lrDefaultDtype device)
]

lrMakeTensorTypedOn: function [dims data requestedDevice requestedDtype][
    lrValidateShape dims
    device: lrNormalizeDevice requestedDevice
    dtype: lrValidateDeviceDtype device (lrNormalizeDtype requestedDtype)
    unless (lrCount dims) = (size data) ->
        panic ~"learn: shape |dims| requires |lrCount dims| values, got |size data|"

    floats: lrFreshBlock
    loop data 'item -> 'floats ++ lrFloat item
    storage: null
    unless device = 'cpu -> storage: lrBackendCall device 'upload @[dims floats]
    return lrMakeTensorTypedWithStorage dims floats device dtype storage
]

lrMakeTensorWithStorage: function [dims data device storage][
    return lrMakeTensorTypedWithStorage dims data device (lrDefaultDtype device) storage
]

lrMakeTensorTypedWithStorage: function [dims data device dtype storage][
    normalizedDtype: lrValidateDeviceDtype device (lrNormalizeDtype dtype)
    args: lrArgs 5
    set args 0 new dims
    set args 1 lrStrides dims
    set args 2 data
    set args 3 device
    set args 4 storage
    result: to :learnTensor args
    ; Arturo may intern structurally equal constructor arguments. Reinstall
    ; owned blocks so equal tensors never share mutable storage.
    set result 'shape new dims
    set result 'strides lrStrides dims
    ownedData: lrFreshBlock
    unless null? data -> ownedData: new data
    set result 'data ownedData
    set result 'device device
    set result 'dtype normalizedDtype
    set result 'storage storage
    set result 'storageOwner lrMakeStorageOwner device storage
    return result
]

lrMakeTensorTypedWithStorageOwner: function [dims data device dtype owner][
    result: lrMakeTensorTypedWithStorage dims data device dtype null
    retained: lrRetainStorageOwner owner
    set result 'storageOwner retained
    unless null? retained -> result\storage: retained\handle
    return result
]

lrMakeTensorLike: function [dims data source][
    return lrMakeTensorTypedOn dims data source\device source\dtype
]

lrSliceHostRecord: function [record operation][
    dims: new record\shape
    set dims operation\axis operation\count
    output: lrFreshBlock
    count: lrCount dims
    if count > 0 [loop 0..(count - 1) 'outputIndex [
        coordinates: lrCoordinates dims outputIndex
        sourceCoordinates: new coordinates
        set sourceCoordinates operation\axis (operation\start + (coordinates\[operation\axis] * operation\step))
        sourceIndex: lrFlatIndex record\shape sourceCoordinates
        'output ++ record\data\[sourceIndex]
    ]]
    return #[shape: dims data: output]
]

lrTensorViewNativeStorage: function [view][
    if key? view 'nativeStorageOwner [
        unless null? view\nativeStorageOwner -> return view\nativeStorageOwner
    ]
    if (lrCount view\shape) = 0 -> return null
    owner: view\storageOwner
    if null? owner -> return null
    descriptor: lrBackend view\device
    unless key? descriptor 'slice -> return null
    working: owner\handle
    ownsWorking: false
    loop view\operations 'operation [
        next: lrBackendCall view\device 'slice @[working operation\axis operation\start operation\count operation\step]
        if ownsWorking -> lrBackendCall view\device 'release @[working]
        working: next
        ownsWorking: true
    ]
    nativeOwner: lrMakeStorageOwner view\device working
    set view 'nativeStorageOwner nativeOwner
    return nativeOwner
]

lrTensorViewHostData: function [view][
    if (size view\data) = (lrCount view\shape) -> return view\data
    if (lrCount view\shape) = 0 [
        view\data: lrFreshBlock
        return view\data
    ]
    nativeOwner: lrTensorViewNativeStorage view
    unless null? nativeOwner [
        downloaded: lrBackendCall view\device 'download @[nativeOwner\handle]
        unless and? [block? downloaded][(size downloaded) = (lrCount view\shape)] -> panic "learn: backend returned malformed slice data"
        output: lrFreshBlock
        loop downloaded 'item -> 'output ++ lrFloat item
        view\data: output
        return view\data
    ]
    rootData: null
    unless null? view\storageOwner -> rootData: lrBackendCall view\device 'download @[view\storageOwner\handle]
    if null? rootData -> rootData: lrTensorHostData view\root
    record: #[shape: new view\root\shape data: rootData]
    loop view\operations 'operation -> record: lrSliceHostRecord record operation
    view\data: record\data
    return view\data
]

hostMaterialized?: function [value][
    if is? :learnTensorView value -> return (size value\data) = (lrCount value\shape)
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    return (size source\data) = (lrCount source\shape)
]

lrTensorHostData: function [value][
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    unless hostMaterialized? source [
        if null? source\storage -> panic "learn: tensor has no host data or device storage"
        downloaded: lrBackendCall source\device 'download @[source\storage]
        unless block? downloaded -> panic ~"learn: backend |source\device| returned malformed tensor data"
        unless (size downloaded) = (lrCount source\shape) -> panic ~"learn: backend |source\device| returned the wrong tensor data count"
        floats: lrFreshBlock
        loop downloaded 'item -> 'floats ++ lrFloat item
        source\data: floats
    ]
    return source\data
]

materializeTensor: function [value][
    if is? :learnTensorView value [
        lrTensorViewHostData value
        return value
    ]
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    lrTensorHostData source
    return source
]

tensorData: function [value][
    if is? :learnTensorView value [
        viewData: lrTensorViewHostData value
        return new viewData
    ]
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    hostData: lrTensorHostData source
    return new hostData
]

releaseTensor: function [value][
    if is? :learnTensorView value [
        value\data: lrFreshBlock
        if key? value 'nativeStorageOwner [
            lrReleaseStorageOwner value\nativeStorageOwner
            value\nativeStorageOwner: null
        ]
        if key? value 'storageOwner [
            lrReleaseStorageOwner value\storageOwner
            value\storageOwner: null
        ]
        return null
    ]
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    owner: lrTensorStorageOwner source
    lrReleaseStorageOwner owner
    set source 'storageOwner null
    source\storage: null
    return null
]

lrTensorFromData: function [source][
    if lrNumeric? source -> return lrMakeTensor [] @[source]
    unless block? source -> panic "learn: tensor expects a number or a block"
    dims: lrInferShape source
    flat: lrFreshBlock
    lrFlattenTensorData source flat
    return lrMakeTensor dims flat
]

tensor: function [source][
    callAttrs: attrs
    requestedDevice: 'cpu
    if key? callAttrs 'device -> requestedDevice: lrNormalizeDevice callAttrs\device
    requestedDtype: lrDefaultDtype requestedDevice
    if key? callAttrs 'dtype -> requestedDtype: lrNormalizeDtype callAttrs\dtype
    lrValidateDeviceDtype requestedDevice requestedDtype
    makeZeros: key? callAttrs 'zeros
    makeOnes: key? callAttrs 'ones
    makeRandom: key? callAttrs 'random
    makeFilled: or? [makeZeros][or? [makeOnes][makeRandom]]

    if makeFilled [
        dims: lrValidateShape source
        data: lrFreshBlock
        count: lrCount dims
        if count > 0 [
            loop 1..count 'unused [
                value: 0.0
                if makeOnes -> value: 1.0
                if makeRandom -> value: lrRandomSmall
                'data ++ value
            ]
        ]
        return lrMakeTensorTypedOn dims data requestedDevice requestedDtype
    ]
    result: lrTensorFromData source
    return lrMakeTensorTypedOn result\shape result\data requestedDevice requestedDtype
]

lrAsTensor: function [value][
    if is? :learnTensor value -> return value
    if is? :learnTensorView value -> return lrMakeTensorTypedOn value\shape (lrTensorViewHostData value) value\device value\dtype
    if lrNumeric? value -> return lrTensorFromData value
    panic ~"learn: expected a tensor or number, got |type value|"
]

shape: function [value][
    if is? :learnTensor value -> return new value\shape
    if is? :learnTensorView value -> return new value\shape
    if is? :learnValue value -> return new value\value\shape
    panic ~"learn: shape expects a tensor or differentiable value, got |type value|"
]

deviceOf: function [value][
    if is? :learnTensor value -> return value\device
    if is? :learnTensorView value -> return value\device
    if is? :learnValue value -> return value\value\device
    panic ~"learn: deviceOf expects a tensor or differentiable value, got |type value|"
]

dtypeOf: function [value][
    if is? :learnTensor value -> return value\dtype
    if is? :learnTensorView value -> return value\dtype
    if is? :learnValue value -> return value\value\dtype
    panic ~"learn: dtypeOf expects a tensor or differentiable value, got |type value|"
]

toDtype: function [value requestedDtype][
    source: lrAsTensor value
    dtype: lrValidateDeviceDtype source\device (lrNormalizeDtype requestedDtype)
    return lrMakeTensorTypedOn source\shape (lrTensorHostData source) source\device dtype
]

lrTensorTransfer: function [value requestedDevice][
    source: lrAsTensor value
    device: lrNormalizeDevice requestedDevice
    dtype: source\dtype
    descriptor: lrBackend device
    if and? [key? descriptor 'dtypes][not? contains? descriptor\dtypes dtype] -> dtype: lrDefaultDtype device
    return lrMakeTensorTypedOn source\shape (lrTensorHostData source) device dtype
]

toDevice: function [value requestedDevice][
    if is? :learnValue value -> return lrValueTransfer value requestedDevice
    return lrTensorTransfer value requestedDevice
]

tensorBuffer: function [value][
    if is? :learnTensorView value [
        viewData: lrTensorViewHostData value
        return #[
            format: "learn.buffer"
            version: "0.9"
            device: value\device
            dtype: value\dtype
            count: size viewData
            data: new viewData
        ]
    ]
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    hostData: lrTensorHostData source
    return #[
        format: "learn.buffer"
        version: "0.9"
        device: source\device
        dtype: source\dtype
        count: size hostData
        data: new hostData
    ]
]

tensorFromBuffer: function [dims buffer][
    lrValidateShape dims
    unless dictionary? buffer -> panic "learn: tensorFromBuffer expects a buffer dictionary"
    unless and? [key? buffer 'format][buffer\format = "learn.buffer"] -> panic "learn: unsupported tensor buffer format"
    loop ['version 'device 'dtype 'count 'data] 'field [
        unless key? buffer field -> panic ~"learn: tensor buffer is missing |field|"
    ]
    unless buffer\version = "0.9" -> panic ~"learn: tensor buffer version |buffer\version| is unsupported"
    dtype: lrNormalizeDtype buffer\dtype
    unless block? buffer\data -> panic "learn: tensor buffer data must be a block"
    unless and? [integer? buffer\count][buffer\count >= 0] -> panic "learn: tensor buffer count must be a non-negative integer"
    unless buffer\count = (size buffer\data) -> panic "learn: tensor buffer count does not match its data"
    unless buffer\count = (lrCount dims) -> panic ~"learn: shape |dims| does not match buffer count |buffer\count|"
    return lrMakeTensorTypedOn dims buffer\data buffer\device dtype
]

tensorSlice: function [value][
    callAttrs: attrs
    source: value
    unless or? [is? :learnTensor source][is? :learnTensorView source] -> source: lrAsTensor source
    rank: size source\shape
    if rank = 0 -> panic "learn: tensorSlice requires a non-scalar tensor"
    axis: lrNormalizeAxis 0 rank
    start: 0
    sliceCount: null
    step: 1
    if key? callAttrs 'axis -> axis: lrNormalizeAxis callAttrs\axis rank
    if key? callAttrs 'start -> start: callAttrs\start
    if key? callAttrs 'count -> sliceCount: callAttrs\count
    if key? callAttrs 'step -> step: callAttrs\step
    unless and? [integer? start][integer? step] -> panic "learn: tensorSlice start and step must be integers"
    unless step > 0 -> panic "learn: tensorSlice step must be positive"
    extent: source\shape\[axis]
    if start < 0 -> start: start + extent
    unless and? [start >= 0][start =< extent] -> panic "learn: tensorSlice start is out of bounds"
    sliceAvailable: 0
    if start < extent [
        remaining: extent - start
        lastOffset: remaining - 1
        completeSteps: to :integer floor (lastOffset / step)
        sliceAvailable: 1 + completeSteps
    ]
    if null? sliceCount -> sliceCount: sliceAvailable
    unless and? [integer? sliceCount][and? [sliceCount >= 0][sliceCount =< sliceAvailable]] -> panic "learn: tensorSlice count is out of bounds"
    dims: new source\shape
    set dims axis sliceCount
    args: lrArgs 9
    set args 0 source
    set args 1 dims
    set args 2 axis
    set args 3 start
    set args 4 sliceCount
    set args 5 step
    set args 6 lrFreshBlock
    set args 7 source\device
    set args 8 source\dtype
    result: to :learnTensorView args
    set result 'shape new dims
    set result 'data lrFreshBlock
    root: source
    operations: lrFreshBlock
    owner: null
    if is? :learnTensorView source [
        root: source\root
        operations: new source\operations
        owner: source\storageOwner
    ]
    if is? :learnTensor source -> owner: lrTensorStorageOwner source
    'operations ++ #[axis: axis start: start count: sliceCount step: step]
    set result 'root root
    set result 'operations operations
    set result 'storageOwner lrRetainStorageOwner owner
    set result 'nativeStorageOwner null
    return result
]

lrTensorViewString: function [view][
    return ~"tensor view(shape: |view\shape|, device: |view\device|, dtype: |view\dtype|)"
]

lrBroadcastShape: function [left right][
    rank: max @[(size left) (size right)]
    result: lrFreshBlock
    if rank > 0 [loop 0..(rank - 1) 'axis [
        leftOffset: axis - (rank - (size left))
        rightOffset: axis - (rank - (size right))
        a: (leftOffset < 0)? -> 1 -> left\[leftOffset]
        b: (rightOffset < 0)? -> 1 -> right\[rightOffset]
        unless or? [a = b][or? [a = 1][b = 1]] ->
            panic ~"learn: cannot broadcast shapes |left| and |right|"
        outputDim: a
        if a = 1 -> outputDim: b
        if b = 1 -> outputDim: a
        'result ++ outputDim
    ]]
    return result
]

lrBroadcastIndex: function [dims outDims flatIndex][
    if empty? dims -> return 0
    outStrides: lrStrides outDims
    sourceStrides: lrStrides dims
    offset: (size outDims) - (size dims)
    sourceIndex: 0
    loop 0..((size dims) - 1) 'sourceAxis [
        outAxis: sourceAxis + offset
        coordinate: to :integer floor (flatIndex / outStrides\[outAxis])
        coordinate: coordinate % outDims\[outAxis]
        if dims\[sourceAxis] = 1 -> coordinate: 0
        sourceIndex: sourceIndex + (coordinate * sourceStrides\[sourceAxis])
    ]
    return sourceIndex
]

lrNormalizeAxis: function [axis rank][
    unless integer? axis -> panic "learn: tensor axis must be an integer"
    normalized: axis
    if normalized < 0 -> normalized: normalized + rank
    unless and? [normalized >= 0][normalized < rank] ->
        panic ~"learn: axis |axis| is out of bounds for rank |rank|"
    return normalized
]

lrCoordinates: function [dims flatIndex][
    strides: lrStrides dims
    result: lrFreshBlock
    if not? empty? dims [loop 0..((size dims) - 1) 'axis [
        coordinate: to :integer floor (flatIndex / strides\[axis])
        'result ++ (coordinate % dims\[axis])
    ]]
    return result
]

lrFlatIndex: function [dims coordinates][
    unless (size dims) = (size coordinates) ->
        panic ~"learn: expected |size dims| indices, got |size coordinates|"
    strides: lrStrides dims
    result: 0
    if not? empty? dims [loop 0..((size dims) - 1) 'axis [
        coordinate: coordinates\[axis]
        unless integer? coordinate -> panic "learn: tensor indices must be integers"
        if coordinate < 0 -> coordinate: coordinate + dims\[axis]
        unless and? [coordinate >= 0][coordinate < dims\[axis]] ->
            panic ~"learn: index |coordinates\[axis]| is out of bounds for axis |axis| of size |dims\[axis]|"
        result: result + (coordinate * strides\[axis])
    ]]
    return result
]

tensorAt: function [value indices][
    if is? :learnValue value -> return lrValueAt value indices
    source: lrAsTensor value
    lrTensorHostData source
    coordinates: indices
    if and? [integer? indices][(size source\shape) = 1] -> coordinates: @[indices]
    unless block? coordinates -> panic "learn: tensorAt expects an index block"
    offset: lrFlatIndex source\shape coordinates
    return lrMakeTensorLike [] @[source\data\[offset]] source
]

lrTensorBinary: function [left right operation][
    a: lrAsTensor left
    b: lrAsTensor right
    lrTensorHostData a
    lrTensorHostData b
    unless a\device = b\device -> panic ~"learn: tensor devices |a\device| and |b\device| do not match"
    dims: lrBroadcastShape a\shape b\shape
    data: lrFreshBlock
    count: lrCount dims

    if count > 0 [
        loop 0..(count - 1) 'i [
            av: a\data\[lrBroadcastIndex a\shape dims i]
            bv: b\data\[lrBroadcastIndex b\shape dims i]
            value: null
            if operation = 'add -> value: av + bv
            if operation = 'sub -> value: av - bv
            if operation = 'mul -> value: av * bv
            if operation = 'div -> value: av / bv
            if operation = 'pow -> value: av ^ bv
            if null? value -> panic ~"learn: unknown tensor operation |operation|"
            'data ++ value
        ]
    ]
    dtype: lrPromoteDtype a\dtype b\dtype
    return lrMakeTensorTypedOn dims data a\device dtype
]

lrTensorUnary: function [value operation][
    source: lrAsTensor value
    lrTensorHostData source
    data: lrFreshBlock
    loop source\data 'item [
        result: null
        if operation = 'neg -> result: 0.0 - item
        if operation = 'exp -> result: exp item
        if operation = 'log -> result: ln item
        if operation = 'abs -> result: abs item
        if operation = 'relu -> result: (item > 0.0)? -> item -> 0.0
        if operation = 'tanh [
            twice: 2.0 * item
            result: (2.0 / (1.0 + exp (0.0 - twice))) - 1.0
        ]
        if operation = 'sigmoid [
            if item >= 0.0 [
                negativeItem: 0.0 - item
                result: 1.0 / (1.0 + exp negativeItem)
            ]
            if item < 0.0 [
                positiveExp: exp item
                result: positiveExp / (1.0 + positiveExp)
            ]
        ]
        if null? result -> panic ~"learn: unknown unary tensor operation |operation|"
        'data ++ result
    ]
    return lrMakeTensorLike source\shape data source
]

lrSoftmaxSpec: function [source][
    lrTensorHostData source
    rank: size source\shape
    classes: (rank = 0)? -> 1 -> last source\shape
    unless classes > 0 -> panic "learn: softmax requires a non-empty class axis"
    groups: (size source\data) / classes
    return @[to :integer groups classes]
]

lrTensorSoftmax: function [value][
    source: lrAsTensor value
    spec: lrSoftmaxSpec source
    groups: spec\0
    classes: spec\1
    output: lrFreshBlock
    if groups > 0 [loop 0..(groups - 1) 'groupIndex [
        offset: groupIndex * classes
        maximum: source\data\[offset]
        if classes > 1 [loop 1..(classes - 1) 'classIndex -> maximum: max @[maximum source\data\[offset + classIndex]]]
        denominator: 0.0
        exponentials: lrFreshBlock
        loop 0..(classes - 1) 'classIndex [
            shifted: source\data\[offset + classIndex] - maximum
            item: exp shifted
            'exponentials ++ item
            denominator: denominator + item
        ]
        loop exponentials 'item -> 'output ++ item / denominator
    ]]
    return lrMakeTensorLike source\shape output source
]

lrClassIndex: function [value classes][
    unless lrNumeric? value -> panic "learn: class targets must be numeric indices"
    classIndex: to :integer value
    unless (to :floating classIndex) = (to :floating value) -> panic "learn: class targets must be integer indices"
    unless and? [classIndex >= 0][classIndex < classes] -> panic ~"learn: class target |classIndex| is out of bounds"
    return classIndex
]

lrCrossEntropySpec: function [logits targets][
    rank: size logits\shape
    unless rank =< 2 -> panic "learn: crossEntropy supports a class vector or sample-by-class matrix"
    unless (size targets\shape) =< 1 -> panic "learn: crossEntropy targets must be a scalar or vector"
    softmaxSpec: lrSoftmaxSpec logits
    samples: softmaxSpec\0
    classes: softmaxSpec\1
    unless (size targets\data) = samples -> panic "learn: crossEntropy requires one class target per sample"
    return @[samples classes]
]

lrTensorCrossEntropy: function [logitsValue targetsValue][
    logits: lrAsTensor logitsValue
    targets: lrAsTensor targetsValue
    lrTensorHostData logits
    lrTensorHostData targets
    unless logits\device = targets\device -> panic "learn: crossEntropy operands must be on the same device"
    spec: lrCrossEntropySpec logits targets
    samples: spec\0
    classes: spec\1
    unless samples > 0 -> panic "learn: crossEntropy is undefined for an empty batch"
    total: 0.0
    loop 0..(samples - 1) 'sampleIndex [
        offset: sampleIndex * classes
        maximum: logits\data\[offset]
        if classes > 1 [loop 1..(classes - 1) 'classIndex -> maximum: max @[maximum logits\data\[offset + classIndex]]]
        exponentialSum: 0.0
        loop 0..(classes - 1) 'classIndex -> exponentialSum: exponentialSum + exp (logits\data\[offset + classIndex] - maximum)
        targetIndex: lrClassIndex targets\data\[sampleIndex] classes
        logNormalizer: maximum + ln exponentialSum
        total: total + logNormalizer - logits\data\[offset + targetIndex]
    ]
    return lrMakeTensorLike [] @[total / samples] logits
]

lrImagePair: function [value fallback][
    if integer? value -> return @[value value]
    unless and? [block? value][(size value) = 2] -> panic "learn: expected an integer or two-element block"
    result: new value
    loop result 'item [unless and? [integer? item][item >= 0] -> panic "learn: image parameters must be non-negative integers"]
    if and? [fallback > 0][or? [result\0 = 0][result\1 = 0]] -> panic "learn: image kernel and stride values must be positive"
    return result
]

lrImageOutputSize: function [extent kernel stride padding][
    twicePadding: 2 * padding
    paddedExtent: extent + twicePadding
    numerator: paddedExtent - kernel
    unless numerator >= 0 -> panic "learn: image kernel exceeds padded input"
    return (to :integer floor (numerator / stride)) + 1
]

lrTensorConv2d: function [inputValue weightValue strideValue paddingValue][
    source: lrAsTensor inputValue
    weights: lrAsTensor weightValue
    lrTensorHostData source
    lrTensorHostData weights
    unless source\device = weights\device -> panic "learn: conv2d operands must be on the same device"
    unless (size source\shape) = 4 -> panic "learn: conv2d input must be NCHW rank 4"
    unless (size weights\shape) = 4 -> panic "learn: conv2d weights must be OIHW rank 4"
    unless source\shape\1 = weights\shape\1 -> panic "learn: conv2d channel counts do not match"
    stride: lrImagePair strideValue 1
    padding: lrImagePair paddingValue 0
    batches: source\shape\0
    channels: source\shape\1
    inputHeight: source\shape\2
    inputWidth: source\shape\3
    outputs: weights\shape\0
    kernelHeight: weights\shape\2
    kernelWidth: weights\shape\3
    outputHeight: lrImageOutputSize inputHeight kernelHeight stride\0 padding\0
    outputWidth: lrImageOutputSize inputWidth kernelWidth stride\1 padding\1
    outputData: lrFreshBlock
    loop 0..(batches - 1) 'batch [
        loop 0..(outputs - 1) 'outputChannel [
            loop 0..(outputHeight - 1) 'outputY [
                loop 0..(outputWidth - 1) 'outputX [
                    total: 0.0
                    loop 0..(channels - 1) 'channel [
                        loop 0..(kernelHeight - 1) 'kernelY [
                            loop 0..(kernelWidth - 1) 'kernelX [
                                inputY: outputY * stride\0
                                inputY: inputY + kernelY
                                inputY: inputY - padding\0
                                inputX: outputX * stride\1
                                inputX: inputX + kernelX
                                inputX: inputX - padding\1
                                if and? [and? [inputY >= 0][inputY < inputHeight]][and? [inputX >= 0][inputX < inputWidth]] [
                                    inputPlane: batch * channels
                                    inputPlane: inputPlane + channel
                                    inputRow: inputPlane * inputHeight
                                    inputRow: inputRow + inputY
                                    inputIndex: inputRow * inputWidth
                                    inputIndex: inputIndex + inputX
                                    weightPlane: outputChannel * channels
                                    weightPlane: weightPlane + channel
                                    weightRow: weightPlane * kernelHeight
                                    weightRow: weightRow + kernelY
                                    weightIndex: weightRow * kernelWidth
                                    weightIndex: weightIndex + kernelX
                                    total: total + (source\data\[inputIndex] * weights\data\[weightIndex])
                                ]
                            ]
                        ]
                    ]
                    'outputData ++ total
                ]
            ]
        ]
    ]
    dtype: lrPromoteDtype source\dtype weights\dtype
    return lrMakeTensorTypedOn @[batches outputs outputHeight outputWidth] outputData source\device dtype
]

lrTensorPool2d: function [inputValue kernelValue strideValue paddingValue operation][
    source: lrAsTensor inputValue
    lrTensorHostData source
    unless (size source\shape) = 4 -> panic "learn: pool2d input must be NCHW rank 4"
    kernel: lrImagePair kernelValue 1
    stride: (null? strideValue)? -> new kernel -> lrImagePair strideValue 1
    padding: lrImagePair paddingValue 0
    batches: source\shape\0
    channels: source\shape\1
    inputHeight: source\shape\2
    inputWidth: source\shape\3
    outputHeight: lrImageOutputSize inputHeight kernel\0 stride\0 padding\0
    outputWidth: lrImageOutputSize inputWidth kernel\1 stride\1 padding\1
    outputData: lrFreshBlock
    loop 0..(batches - 1) 'batch [
        loop 0..(channels - 1) 'channel [
            loop 0..(outputHeight - 1) 'outputY [
                loop 0..(outputWidth - 1) 'outputX [
                    total: 0.0
                    maximum: null
                    count: 0
                    loop 0..(kernel\0 - 1) 'kernelY [
                        loop 0..(kernel\1 - 1) 'kernelX [
                            inputY: outputY * stride\0
                            inputY: inputY + kernelY
                            inputY: inputY - padding\0
                            inputX: outputX * stride\1
                            inputX: inputX + kernelX
                            inputX: inputX - padding\1
                            if and? [and? [inputY >= 0][inputY < inputHeight]][and? [inputX >= 0][inputX < inputWidth]] [
                                inputPlane: batch * channels
                                inputPlane: inputPlane + channel
                                inputRow: inputPlane * inputHeight
                                inputRow: inputRow + inputY
                                inputIndex: inputRow * inputWidth
                                inputIndex: inputIndex + inputX
                                item: source\data\[inputIndex]
                                total: total + item
                                if or? [null? maximum][item > maximum] -> maximum: item
                                count: count + 1
                            ]
                        ]
                    ]
                    if operation = 'max -> 'outputData ++ maximum
                    if operation = 'average -> 'outputData ++ total / count
                ]
            ]
        ]
    ]
    return lrMakeTensorLike @[batches channels outputHeight outputWidth] outputData source
]

conv2d: function [inputValue weights][
    callAttrs: attrs
    stride: [1 1]
    padding: [0 0]
    if key? callAttrs 'stride -> stride: callAttrs\stride
    if key? callAttrs 'padding -> padding: callAttrs\padding
    if is? :learnValue inputValue -> return lrValueConv2d inputValue weights stride padding
    if is? :learnValue weights -> return lrValueConv2d inputValue weights stride padding
    return lrTensorConv2d inputValue weights stride padding
]

maxPool2d: function [inputValue kernel][
    callAttrs: attrs
    stride: null
    padding: [0 0]
    if key? callAttrs 'stride -> stride: callAttrs\stride
    if key? callAttrs 'padding -> padding: callAttrs\padding
    if is? :learnValue inputValue -> return lrValuePool2d inputValue kernel stride padding 'max
    return lrTensorPool2d inputValue kernel stride padding 'max
]

avgPool2d: function [inputValue kernel][
    callAttrs: attrs
    stride: null
    padding: [0 0]
    if key? callAttrs 'stride -> stride: callAttrs\stride
    if key? callAttrs 'padding -> padding: callAttrs\padding
    if is? :learnValue inputValue -> return lrValuePool2d inputValue kernel stride padding 'average
    return lrTensorPool2d inputValue kernel stride padding 'average
]

reshape: function [value dims][
    if is? :learnValue value -> return lrValueReshape value dims
    source: lrAsTensor value
    lrTensorHostData source
    lrValidateShape dims
    unless (lrCount dims) = (size source\data) ->
        panic ~"learn: cannot reshape |source\shape| to |dims|"
    return lrMakeTensorLike dims source\data source
]

lrTransposeAxes: function [dims requestedAxes][
    rank: size dims
    axes: lrFreshBlock
    if null? requestedAxes [
        if rank > 0 [loop 0..(rank - 1) 'axis -> 'axes ++ axis]
        if rank >= 2 [
            previous: axes\[rank - 2]
            set axes (rank - 2) axes\[rank - 1]
            set axes (rank - 1) previous
        ]
    ]
    unless null? requestedAxes -> axes: new requestedAxes
    unless (size axes) = rank -> panic ~"learn: transpose needs |rank| axes"
    loop axes 'axis [
        normalized: lrNormalizeAxis axis rank
        unless normalized = axis -> panic "learn: transpose axes must use non-negative indices"
        occurrences: size (select axes 'candidate -> candidate = axis)
        unless occurrences = 1 ->
            panic "learn: transpose axes must be a permutation"
    ]
    return axes
]

transpose: function [value][
    callAttrs: attrs
    requestedAxes: null
    if key? callAttrs 'axes -> requestedAxes: callAttrs\axes
    if is? :learnValue value -> return lrValueTranspose value requestedAxes
    source: lrAsTensor value
    lrTensorHostData source
    rank: size source\shape
    axes: lrTransposeAxes source\shape requestedAxes

    outputShape: lrFreshBlock
    loop axes 'axis -> 'outputShape ++ source\shape\[axis]
    data: lrFreshBlock
    count: lrCount outputShape
    if count > 0 [
        loop 0..(count - 1) 'outputIndex [
            outputCoordinates: lrCoordinates outputShape outputIndex
            sourceCoordinates: lrArgs rank
            if rank > 0 [
                loop 0..(rank - 1) 'outputAxis [
                    sourceAxis: axes\[outputAxis]
                    coordinate: outputCoordinates\[outputAxis]
                    set sourceCoordinates sourceAxis coordinate
                ]
            ]
            sourceIndex: lrFlatIndex source\shape sourceCoordinates
            'data ++ source\data\[sourceIndex]
        ]
    ]
    return lrMakeTensorLike outputShape data source
]

tensorSum: function [value][
    requestedAxis: attr 'axis
    if is? :learnValue value -> return lrValueReduce value 'sum requestedAxis
    source: lrAsTensor value
    lrTensorHostData source
    unless null? requestedAxis -> return lrTensorReduceAxis source requestedAxis 'sum
    total: 0.0
    loop source\data 'item -> total: total + item
    return lrMakeTensorLike [] @[total] source
]

mean: function [value][
    requestedAxis: attr 'axis
    if is? :learnValue value -> return lrValueReduce value 'mean requestedAxis
    source: lrAsTensor value
    lrTensorHostData source
    unless null? requestedAxis -> return lrTensorReduceAxis source requestedAxis 'mean
    if empty? source\data -> panic "learn: mean is undefined for an empty tensor"
    total: 0.0
    loop source\data 'item -> total: total + item
    return lrMakeTensorLike [] @[total / size source\data] source
]

lrTensorReduceAxis: function [source requestedAxis operation][
    rank: size source\shape
    axis: lrNormalizeAxis requestedAxis rank
    if and? [operation = 'mean][source\shape\[axis] = 0] ->
        panic "learn: mean is undefined over an empty axis"
    outputShape: lrFreshBlock
    if rank > 1 [loop 0..(rank - 1) 'candidate [
        unless candidate = axis -> 'outputShape ++ source\shape\[candidate]
    ]]
    outputData: lrFreshBlock
    outputCount: lrCount outputShape
    if outputCount > 0 [loop 1..outputCount 'unused -> 'outputData ++ 0.0]
    if not? empty? source\data [loop 0..((size source\data) - 1) 'inputIndex [
        coordinates: lrCoordinates source\shape inputIndex
        outputCoordinates: lrFreshBlock
        loop 0..(rank - 1) 'candidate [
            unless candidate = axis -> 'outputCoordinates ++ coordinates\[candidate]
        ]
        outputIndex: lrFlatIndex outputShape outputCoordinates
        set outputData outputIndex (outputData\[outputIndex] + source\data\[inputIndex])
    ]]
    if operation = 'mean [
        divisor: source\shape\[axis]
        outputData: map outputData 'item -> item / divisor
    ]
    return lrMakeTensorLike outputShape outputData source
]

square: function [value][
    return value ^ 2.0
]

sigmoid: function [value][
    if is? :learnValue value -> return lrValueUnary value 'sigmoid
    return lrTensorUnary value 'sigmoid
]

relu: function [value][
    if is? :learnValue value -> return lrValueUnary value 'relu
    return lrTensorUnary value 'relu
]

tensorTanh: function [value][
    if is? :learnValue value -> return lrValueUnary value 'tanh
    return lrTensorUnary value 'tanh
]

tensorExp: function [value][
    if is? :learnValue value -> return lrValueUnary value 'exp
    return lrTensorUnary value 'exp
]

tensorLog: function [value][
    if is? :learnValue value -> return lrValueUnary value 'log
    return lrTensorUnary value 'log
]

tensorAbs: function [value][
    if is? :learnValue value -> return lrValueUnary value 'abs
    return lrTensorUnary value 'abs
]

lrDropoutTensor: function [value context][
    source: lrAsTensor value
    lrTensorHostData source
    unless context\training [
        context\mask: lrOnesLike source
        return lrMakeTensorLike source\shape source\data source
    ]
    context\pass: context\pass + 1
    state: context\seed + (context\pass * 104729) + 1
    scale: 1.0 / (1.0 - context\rate)
    maskData: lrFreshBlock
    loop source\data 'item [
        state: ((state * 1103515245) + 12345) % 2147483648
        fraction: (to :floating state) / 2147483648.0
        maskValue: (fraction >= context\rate)? -> scale -> 0.0
        'maskData ++ maskValue
    ]
    mask: lrMakeTensorLike source\shape maskData source
    context\mask: mask
    return lrTensorBinary source mask 'mul
]

dropout: function [value][
    callAttrs: attrs
    rate: 0.5
    seed: 0
    if key? callAttrs 'rate -> rate: callAttrs\rate
    if key? callAttrs 'seed -> seed: callAttrs\seed
    unless and? [lrNumeric? rate][and? [rate >= 0.0][rate < 1.0]] -> panic "learn: dropout rate must be in [0, 1)"
    unless and? [integer? seed][seed >= 0] -> panic "learn: dropout seed must be a non-negative integer"
    if is? :learnValue value -> return lrValueDropout value (to :floating rate) seed
    context: #[rate: to :floating rate seed: seed pass: 0 training: true mask: null]
    return lrDropoutTensor value context
]

lrValidatePenaltyParameters: function [parameterList label][
    unless and? [block? parameterList][not? empty? parameterList] -> panic ~"learn: |label| expects a non-empty parameter block"
    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] -> panic ~"learn: |label| expects parameter values"
    ]
    return parameterList
]

l1Penalty: function [parameterList][
    rate: attr 'rate
    if null? rate -> rate: 1.0
    unless and? [lrNumeric? rate][rate >= 0.0] -> panic "learn: l1Penalty rate must be non-negative"
    lrValidatePenaltyParameters parameterList "l1Penalty"
    total: tensorSum tensorAbs parameterList\0
    if (size parameterList) > 1 [loop 1..((size parameterList) - 1) 'itemIndex [
        itemPenalty: tensorSum tensorAbs parameterList\[itemIndex]
        total: total + itemPenalty
    ]]
    return total * rate
]

l2Penalty: function [parameterList][
    rate: attr 'rate
    if null? rate -> rate: 1.0
    unless and? [lrNumeric? rate][rate >= 0.0] -> panic "learn: l2Penalty rate must be non-negative"
    lrValidatePenaltyParameters parameterList "l2Penalty"
    total: tensorSum square parameterList\0
    if (size parameterList) > 1 [loop 1..((size parameterList) - 1) 'itemIndex [
        itemPenalty: tensorSum square parameterList\[itemIndex]
        total: total + itemPenalty
    ]]
    return total * rate
]

softmax: function [value][
    if is? :learnValue value -> return lrValueUnary value 'softmax
    return lrTensorSoftmax value
]

crossEntropy: function [logits targets][
    if or? [is? :learnValue logits][is? :learnValue targets] -> return lrValueCrossEntropy logits targets
    return lrTensorCrossEntropy logits targets
]

classPrediction: function [logitsValue][
    logits: (is? :learnValue logitsValue)? -> logitsValue\value -> lrAsTensor logitsValue
    lrTensorHostData logits
    spec: lrSoftmaxSpec logits
    groups: spec\0
    classes: spec\1
    predictions: lrFreshBlock
    if groups > 0 [loop 0..(groups - 1) 'groupIndex [
        offset: groupIndex * classes
        bestIndex: 0
        bestValue: logits\data\[offset]
        if classes > 1 [loop 1..(classes - 1) 'classIndex [
            candidate: logits\data\[offset + classIndex]
            if candidate > bestValue [bestValue: candidate bestIndex: classIndex]
        ]]
        'predictions ++ to :floating bestIndex
    ]]
    outputShape: lrLeadingShape logits\shape 1
    return lrMakeTensorLike outputShape predictions logits
]

multiclassAccuracy: function [actual predicted][
    targets: lrAsTensor actual
    classes: lrAsTensor predicted
    targetData: lrTensorHostData targets
    classData: lrTensorHostData classes
    unless targets\shape = classes\shape -> panic "learn: multiclass accuracy values must have equal shape"
    if empty? targetData -> panic "learn: multiclass accuracy is undefined for empty values"
    correct: 0
    loop 0..((size targetData) - 1) 'itemIndex [
        expected: lrClassIndex targetData\[itemIndex] 2147483647
        actualClass: lrClassIndex classData\[itemIndex] 2147483647
        if expected = actualClass -> correct: correct + 1
    ]
    return (to :floating correct) / size targetData
]

binaryCrossEntropy: function [prediction target][
    p: lrAsValue prediction
    y: lrAsValue target
    one: lrOnesLike p\value
    epsilonValue: tensor 0.0000001
    safeP: p + epsilonValue
    oneMinusP: one - p
    safeOneMinusP: oneMinusP + epsilonValue
    logP: tensorLog safeP
    positive: y * logP
    oneMinusY: one - y
    logOneMinusP: tensorLog safeOneMinusP
    negative: oneMinusY * logOneMinusP
    combined: positive + negative
    negativeCombined: neg combined
    return mean negativeCombined
]

lrLeadingShape: function [dims trailingCount][
    result: lrFreshBlock
    leadingCount: (size dims) - trailingCount
    if leadingCount > 0 [loop 0..(leadingCount - 1) 'axis -> 'result ++ dims\[axis]]
    return result
]

lrMatmulSpec: function [leftShape rightShape][
    leftRank: size leftShape
    rightRank: size rightShape
    if leftRank < 1 -> panic "learn: matmul left operand must have rank at least 1"
    if rightRank < 1 -> panic "learn: matmul right operand must have rank at least 1"

    leftVector: leftRank = 1
    rightVector: rightRank = 1
    rows: 1
    unless leftVector -> rows: leftShape\[leftRank - 2]
    inner: leftShape\[leftRank - 1]
    rightInner: rightShape\0
    unless rightVector -> rightInner: rightShape\[rightRank - 2]
    cols: 1
    unless rightVector -> cols: rightShape\[rightRank - 1]
    unless inner = rightInner -> panic ~"learn: matmul shapes |leftShape| and |rightShape| are incompatible"

    leftBatch: lrFreshBlock
    unless leftVector -> leftBatch: lrLeadingShape leftShape 2
    rightBatch: lrFreshBlock
    unless rightVector -> rightBatch: lrLeadingShape rightShape 2
    batchShape: lrBroadcastShape leftBatch rightBatch
    outputShape: new batchShape
    unless leftVector -> 'outputShape ++ rows
    unless rightVector -> 'outputShape ++ cols
    return #[
        leftVector: leftVector
        rightVector: rightVector
        rows: rows
        inner: inner
        cols: cols
        leftBatch: leftBatch
        rightBatch: rightBatch
        batchShape: batchShape
        outputShape: outputShape
    ]
]

lrMatmulIndices: function [spec batchIndex row col k][
    leftBatchIndex: lrBroadcastIndex spec\leftBatch spec\batchShape batchIndex
    rightBatchIndex: lrBroadcastIndex spec\rightBatch spec\batchShape batchIndex
    leftMatrixSize: spec\rows * spec\inner
    rightMatrixSize: spec\inner * spec\cols
    leftIndex: (leftBatchIndex * leftMatrixSize) + (row * spec\inner) + k
    rightIndex: (rightBatchIndex * rightMatrixSize) + (k * spec\cols) + col
    outputIndex: (batchIndex * spec\rows * spec\cols) + (row * spec\cols) + col
    return @[leftIndex rightIndex outputIndex]
]

matmul: function [left right][
    if or? [is? :learnValue left][is? :learnValue right] ->
        return lrValueMatmul left right

    a: lrAsTensor left
    b: lrAsTensor right
    lrTensorHostData a
    lrTensorHostData b
    unless a\device = b\device -> panic ~"learn: tensor devices |a\device| and |b\device| do not match"
    spec: lrMatmulSpec a\shape b\shape
    data: lrFreshBlock
    batchCount: lrCount spec\batchShape
    if and? [batchCount > 0][and? [spec\rows > 0][spec\cols > 0]] [
        loop 0..(batchCount - 1) 'batchIndex [
            loop 0..(spec\rows - 1) 'row [
                loop 0..(spec\cols - 1) 'col [
                    total: 0.0
                    if spec\inner > 0 [loop 0..(spec\inner - 1) 'k [
                        indices: lrMatmulIndices spec batchIndex row col k
                        total: total + (a\data\[indices\0] * b\data\[indices\1])
                    ]]
                    'data ++ total
                ]
            ]
        ]
    ]
    dtype: lrPromoteDtype a\dtype b\dtype
    return lrMakeTensorTypedOn spec\outputShape data a\device dtype
]

lrTensorString: function [value][
    lrTensorHostData value
    dims: value\shape
    if empty? dims -> return to :string value\data\0
    if (size dims) = 1 -> return to :string value\data
    if (size dims) = 2 [
        rows: lrFreshBlock
        cols: dims\1
        if dims\0 > 0 [
            loop 0..(dims\0 - 1) 'row [
                rowValues: lrFreshBlock
                if cols > 0 [
                    loop 0..(cols - 1) 'col [
                        offset: (row * cols) + col
                        'rowValues ++ value\data\[offset]
                    ]
                ]
                'rows ++ @[rowValues]
            ]
        ]
        return to :string rows
    ]
    return ~"tensor(shape: |dims|, data: |value\data|)"
]
