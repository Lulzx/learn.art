import'unitt!
import relative {../src/learn}!

suite "deterministic mini-batch training" [
    test "iterates paired rows in deterministic batches" [
        features: tensor [[1] [2] [3] [4] [5]]
        targets: tensor [10 20 30 40 50]
        firstIterator: batcher.size: 2.seed: 7 features targets
        secondIterator: batcher.size: 2.seed: 7 features targets
        firstBatch: nextBatch firstIterator
        matchingBatch: nextBatch secondIterator
        tailBatch: nextBatch firstIterator
        assert -> firstBatch\indices = matchingBatch\indices
        assert -> firstBatch\features\data = matchingBatch\features\data
        assert -> 2 = size firstBatch\indices
        assert -> 2 = size tailBatch\indices
        firstIndex: firstBatch\indices\0
        assert -> firstBatch\targets\data\0 = targets\data\[firstIndex]
    ]

    test "advances epochs and reshuffles deterministically" [
        features: tensor [[1] [2] [3]]
        targets: tensor [1 2 3]
        iterator: batcher.size: 2.seed: 11 features targets
        firstBatch: nextBatch iterator
        discard nextBatch iterator
        nextEpoch: nextBatch iterator
        assert -> 0 = firstBatch\epoch
        assert -> 1 = nextEpoch\epoch
        assert -> 2 = size nextEpoch\indices
    ]

    test "restores exact data-order position" [
        features: tensor [[1] [2] [3] [4]]
        targets: tensor [1 2 3 4]
        source: batcher.size: 2.seed: 5 features targets
        discard nextBatch source
        state: batcherState source
        expected: nextBatch source

        restored: batcher.size: 2.seed: 5 features targets
        loadBatcherState restored state
        actual: nextBatch restored
        assert -> expected\indices = actual\indices
        assert -> expected\features\data = actual\features\data
        assert -> state\position = 2
    ]

    test "round-trips an atomic training session checkpoint" [
        features: tensor [[1] [2] [3] [4]]
        targets: tensor [1 2 3 4]
        iterator: batcher.size: 2.seed: 3 features targets
        model: graph [p: parameter 1.0]
        optimizer: adam (parameters model)
        model\p\gradient: tensor 2.0
        step optimizer
        discard nextBatch iterator
        path: ".learn-checkpoint-test.state"
        saveSessionCheckpoint model optimizer iterator path
        expectedBatch: nextBatch iterator

        model\p\value\data: [9.0]
        optimizer\timestep: 9
        iterator\position: 0
        loadSessionCheckpoint model optimizer iterator path
        actualBatch: nextBatch iterator
        assert -> expectedBatch\indices = actualBatch\indices
        assert -> 1 = optimizer\timestep
        assert -> model\p\value\data\0 < 1.0
    ]

    test "validates paired data and batcher state" [
        features: tensor [[1] [2]]
        targets: tensor [1]
        mismatch?: throws? [batcher features targets]
        validTargets: tensor [1 2]
        iterator: batcher features validTargets
        state: batcherState iterator
        state\order: [0 0]
        invalidState?: throws? [loadBatcherState iterator state]
        assert -> mismatch?
        assert -> invalidState?
    ]

    test "trains named graph inputs and records epoch history" [
        features: tensor [0.0 1.0 2.0 3.0]
        targets: tensor [1.0 3.0 5.0 7.0]
        model: graph [
            featuresIn: input
            targetsIn: input
            weight: parameter 0.0
            bias: parameter 0.0
            scaled: featuresIn * weight
            prediction: scaled + bias
            error: prediction - targetsIn
            objective: mean square error
        ]
        optimizer: sgd.rate: 0.05 (parameters model)
        iterator: batcher.size: 2.shuffle: false features targets
        history: train.epochs: 80.inputs: ['featuresIn 'targetsIn].loss: 'objective model optimizer iterator
        firstEpoch: history\epochs\0
        lastEpoch: history\epochs\79
        assert -> "learn.training-history" = history\format
        assert -> 160 = history\batches
        assert -> firstEpoch\trainLoss > lastEpoch\trainLoss
        assert -> iterator\epoch = 80
        assert -> iterator\position = 0
        weightError: abs (model\weight\value\data\0 - 2.0)
        assert -> weightError < 0.1
    ]

    test "reports validation loss without optimizer steps" [
        features: tensor [1.0 2.0]
        targets: tensor [2.0 4.0]
        model: graph [
            x: input
            y: input
            weight: parameter 0.0
            prediction: x * weight
            error: prediction - y
            loss: mean square error
        ]
        optimizer: adam.rate: 0.1 (parameters model)
        iterator: batcher.size: 1.shuffle: false features targets
        validation: #[features: features targets: targets]
        history: train.epochs: 2.validation: validation model optimizer iterator
        assert -> 4 = history\batches
        assert -> 4 = optimizer\timestep
        assert -> floating? history\epochs\0\validationLoss
    ]

    test "stops when an epoch callback returns false" [
        stopAfterEpochZero: function [record][record\epoch < 0]
        features: tensor [1.0 2.0]
        targets: tensor [2.0 4.0]
        model: graph [
            x: input
            y: input
            weight: parameter 0.0
            prediction: x * weight
            error: prediction - y
            loss: mean square error
        ]
        optimizer: sgd.rate: 0.1 (parameters model)
        iterator: batcher.size: 2.shuffle: false features targets
        history: train.epochs: 5.callback: 'stopAfterEpochZero model optimizer iterator
        assert -> history\stoppedEarly
        assert -> "callback" = history\stopReason
        assert -> 1 = size history\epochs
        assert -> 1 = history\batches
    ]

    test "continues a partially consumed epoch" [
        features: tensor [1.0 2.0 3.0 4.0]
        targets: tensor [2.0 4.0 6.0 8.0]
        model: graph [
            x: input
            y: input
            weight: parameter 0.0
            prediction: x * weight
            error: prediction - y
            loss: mean square error
        ]
        optimizer: sgd.rate: 0.01 (parameters model)
        iterator: batcher.size: 2.shuffle: false features targets
        discard nextBatch iterator
        history: train model optimizer iterator
        record: history\epochs\0
        assert -> record\partial
        assert -> 1 = record\batches
        assert -> 2 = record\rows
        assert -> 1 = iterator\epoch
    ]

    test "validates training-loop configuration" [
        features: tensor [1.0]
        targets: tensor [2.0]
        model: graph [x: input y: input weight: parameter 0.0 prediction: x * weight error: prediction - y loss: mean square error]
        optimizer: sgd (parameters model)
        iterator: batcher features targets
        badEpochs?: throws? [train.epochs: 0 model optimizer iterator]
        badInputs?: throws? [train.inputs: ['missing 'y] model optimizer iterator]
        assert -> badEpochs?
        assert -> badInputs?
    ]

    test "measures and clips the global parameter gradient norm" [
        left: parameter 0.0
        right: parameter 0.0
        left\gradient: tensor [3.0]
        right\gradient: tensor [4.0]
        before: clipGradNorm.max: 2.5 @[left right]
        after: gradientNorm @[left right]
        assert -> 5.0 = before
        assert -> 2.5 = after
        assert -> 1.5 = left\gradient\data\0
        assert -> 2.0 = right\gradient\data\0
    ]

    test "applies clipping and an epoch learning-rate schedule in train" [
        features: tensor [1.0]
        targets: tensor [100.0]
        model: graph [
            x: input
            y: input
            weight: parameter 0.0
            prediction: x * weight
            error: prediction - y
            loss: mean square error
        ]
        optimizer: sgd.rate: 0.1 (parameters model)
        scheduler: stepLr.every: 2.factor: 0.5 optimizer
        iterator: batcher.size: 1.shuffle: false features targets
        history: train.epochs: 3.clip: 1.0.scheduler: scheduler model optimizer iterator
        assert -> "0.15" = history\version
        assert -> 0.1 = history\epochs\0\learningRate
        assert -> 0.1 = history\epochs\1\learningRate
        assert -> 0.05 = history\epochs\2\learningRate
        assert -> 0.05 = optimizer\rate
        assert -> 3 = scheduler\epochs
        assert -> model\weight\value\data\0 < 0.3
    ]

    test "round-trips scheduler progress in a session checkpoint" [
        features: tensor [1.0 2.0]
        targets: tensor [2.0 4.0]
        model: graph [p: parameter 1.0]
        optimizer: momentum.rate: 0.2 (parameters model)
        scheduler: stepLr.every: 2.factor: 0.5 optimizer
        iterator: batcher.size: 1.seed: 3 features targets
        discard schedulerStep scheduler
        discard schedulerStep scheduler
        discard nextBatch iterator
        path: ".learn-scheduler-checkpoint-test.state"
        saveSessionCheckpoint.scheduler: scheduler model optimizer iterator path

        optimizer\rate: 9.0
        scheduler\epochs: 9
        iterator\position: 0
        loadSessionCheckpoint.scheduler: scheduler model optimizer iterator path
        assert -> 0.1 = optimizer\rate
        assert -> 2 = scheduler\epochs
        assert -> 1 = iterator\position
    ]
]
