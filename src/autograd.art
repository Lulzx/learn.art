; Reverse-mode automatic differentiation over learn tensors.

import relative {./tensor}!

lrValueId: function [][
    high: random 0 2147483647
    low: random 0 2147483647
    return ~"|high|-|low|"
]

define :learnValue [
    init: constructor [id value gradient requiresGradient operation parents parameter context]

    add: method [that][lrValueBinary this that 'add]
    sub: method [that][lrValueBinary this that 'sub]
    mul: method [that][lrValueBinary this that 'mul]
    div: method [that][lrValueBinary this that 'div]
    pow: method [that][lrValueBinary this that 'pow]
    neg: method [][
        minusOne: 0.0 - 1.0
        raw: this\value * minusOne
        lrMakeValue #[
            value: raw
            requiresGradient: this\requiresGradient
            operation: 'neg
            parents: @[this]
            parameter: false
        ]
    ]

    string: method [][to :string this\value]
]

lrMakeValue: function [spec][
    args: lrArgs 8
    set args 0 lrValueId
    set args 1 lrAsTensor spec\value
    set args 2 null
    set args 3 spec\requiresGradient
    set args 4 spec\operation
    set args 5 spec\parents
    set args 6 spec\parameter
    context: null
    if key? spec 'context -> context: spec\context
    set args 7 context
    return to :learnValue args
]

lrAsValue: function [value][
    if is? :learnValue value -> return value
    return lrMakeValue #[value: lrAsTensor value requiresGradient: false operation: 'constant parents: lrFreshBlock parameter: false]
]

variable: function [value][
    return lrMakeValue #[value: lrAsTensor value requiresGradient: true operation: 'leaf parents: lrFreshBlock parameter: false]
]

detach: function [value][
    if is? :learnValue value -> return lrMakeTensorOn value\value\shape (lrTensorHostData value\value) value\value\device
    source: lrAsTensor value
    return lrMakeTensorOn source\shape (lrTensorHostData source) source\device
]

gradient: function [value][
    unless is? :learnValue value -> panic "learn: gradient expects a differentiable value"
    return value\gradient
]

lrValueBinary: function [left right operation][
    a: lrAsValue left
    b: lrAsValue right
    if and? [operation = 'pow][b\requiresGradient] ->
        panic "learn: differentiating with respect to a tensor exponent is not supported"

    result: lrTensorBinary a\value b\value operation
    requires: or? [a\requiresGradient][b\requiresGradient]
    return lrMakeValue #[value: result requiresGradient: requires operation: operation parents: @[a b] parameter: false]
]

lrValueUnary: function [value operation][
    source: lrAsValue value
    result: (operation = 'softmax)? -> lrTensorSoftmax source\value -> lrTensorUnary source\value operation
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: operation parents: @[source] parameter: false]
]

lrValueCrossEntropy: function [logits targets][
    scores: lrAsValue logits
    labels: lrAsValue targets
    if labels\requiresGradient -> panic "learn: crossEntropy targets cannot require gradients"
    result: lrTensorCrossEntropy scores\value labels\value
    return lrMakeValue #[value: result requiresGradient: scores\requiresGradient operation: 'crossEntropy parents: @[scores labels] parameter: false]
]

lrValueDropout: function [value rate seed][
    source: lrAsValue value
    context: #[rate: rate seed: seed pass: 0 training: true mask: null]
    result: lrDropoutTensor source\value context
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: 'dropout parents: @[source] parameter: false context: context]
]

lrValueDense: function [inputValue weight bias][
    source: lrAsValue inputValue
    weightValue: lrAsValue weight
    biasValue: lrAsValue bias
    linear: matmul source\value weightValue\value
    result: lrTensorBinary linear biasValue\value 'add
    requires: or? [source\requiresGradient][or? [weightValue\requiresGradient][biasValue\requiresGradient]]
    return lrMakeValue #[value: result requiresGradient: requires operation: 'dense parents: @[source weightValue biasValue] parameter: false]
]

lrValueConv2d: function [inputValue weights stride padding][
    source: lrAsValue inputValue
    kernel: lrAsValue weights
    result: lrTensorConv2d source\value kernel\value stride padding
    requires: or? [source\requiresGradient][kernel\requiresGradient]
    context: #[stride: new stride padding: new padding]
    return lrMakeValue #[value: result requiresGradient: requires operation: 'conv2d parents: @[source kernel] parameter: false context: context]
]

lrValuePool2d: function [inputValue kernel stride padding operation][
    source: lrAsValue inputValue
    result: lrTensorPool2d source\value kernel stride padding operation
    context: #[kernel: lrImagePair kernel 1 stride: (null? stride)? -> new (lrImagePair kernel 1) -> lrImagePair stride 1 padding: lrImagePair padding 0]
    operationName: (operation = 'max)? -> 'maxPool2d -> 'avgPool2d
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: operationName parents: @[source] parameter: false context: context]
]

lrValueReduce: function [value operation requestedAxis][
    source: lrAsValue value
    result: null
    resultOperation: operation
    context: null
    if null? requestedAxis -> result: (operation = 'sum)? -> tensorSum source\value -> mean source\value
    unless null? requestedAxis [
        axis: lrNormalizeAxis requestedAxis (size source\value\shape)
        result: (operation = 'sum)? -> tensorSum.axis: axis source\value -> mean.axis: axis source\value
        resultOperation: (operation = 'sum)? -> 'sumAxis -> 'meanAxis
        context: #[axis: axis]
    ]
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: resultOperation parents: @[source] parameter: false context: context]
]

lrValueReshape: function [value dims][
    source: lrAsValue value
    result: reshape source\value dims
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: 'reshape parents: @[source] parameter: false]
]

lrValueTranspose: function [value requestedAxes][
    source: lrAsValue value
    axes: lrTransposeAxes source\value\shape requestedAxes
    result: transpose.axes: axes source\value
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: 'transpose parents: @[source] parameter: false context: #[axes: axes]]
]

lrValueAt: function [value indices][
    source: lrAsValue value
    coordinates: indices
    if and? [integer? indices][(size source\value\shape) = 1] -> coordinates: @[indices]
    unless block? coordinates -> panic "learn: tensorAt expects an index block"
    ; Validate and normalize negative indices now so recomputation is stable.
    offset: lrFlatIndex source\value\shape coordinates
    normalized: lrCoordinates source\value\shape offset
    result: tensorAt source\value normalized
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: 'index parents: @[source] parameter: false context: #[indices: normalized]]
]

lrValueTransfer: function [value requestedDevice][
    source: lrAsValue value
    device: lrNormalizeDevice requestedDevice
    result: lrTensorTransfer source\value device
    return lrMakeValue #[value: result requiresGradient: source\requiresGradient operation: 'transfer parents: @[source] parameter: false context: #[device: device]]
]

lrValueMatmul: function [left right][
    a: lrAsValue left
    b: lrAsValue right
    result: matmul a\value b\value
    return lrMakeValue #[value: result requiresGradient: or? [a\requiresGradient][b\requiresGradient] operation: 'matmul parents: @[a b] parameter: false]
]

lrZerosLike: function [value][
    lrTensorHostData value
    return lrMakeTensorOn value\shape (map value\data 'unused -> 0.0) value\device
]

lrOnesLike: function [value][
    lrTensorHostData value
    return lrMakeTensorOn value\shape (map value\data 'unused -> 1.0) value\device
]

lrUnbroadcast: function [value targetShape][
    lrTensorHostData value
    if value\shape = targetShape -> return lrMakeTensorOn value\shape value\data value\device
    data: lrFreshBlock
    targetCount: lrCount targetShape
    if targetCount > 0 [loop 1..targetCount 'unused -> 'data ++ 0.0]

    if not? empty? value\data [
        loop 0..((size value\data) - 1) 'i [
            targetIndex: lrBroadcastIndex targetShape value\shape i
            set data targetIndex (data\[targetIndex] + value\data\[i])
        ]
    ]
    return lrMakeTensorOn targetShape data value\device
]

lrExpandReductionGradient: function [up sourceShape axis scale][
    lrTensorHostData up
    data: lrFreshBlock
    count: lrCount sourceShape
    if count > 0 [
        loop 0..(count - 1) 'inputIndex [
            coordinates: lrCoordinates sourceShape inputIndex
            outputCoordinates: lrFreshBlock
            loop 0..((size sourceShape) - 1) 'candidate [
                unless candidate = axis -> 'outputCoordinates ++ coordinates\[candidate]
            ]
            outputShape: lrFreshBlock
            loop 0..((size sourceShape) - 1) 'candidate [
                unless candidate = axis -> 'outputShape ++ sourceShape\[candidate]
            ]
            outputIndex: lrFlatIndex outputShape outputCoordinates
            'data ++ (up\data\[outputIndex] * scale)
        ]
    ]
    return lrMakeTensorOn sourceShape data up\device
]

lrMatmulGradients: function [left right up][
    lrTensorHostData left
    lrTensorHostData right
    lrTensorHostData up
    spec: lrMatmulSpec left\shape right\shape
    leftData: lrFreshBlock
    rightData: lrFreshBlock
    if not? empty? left\data [loop 1..(size left\data) 'unused -> 'leftData ++ 0.0]
    if not? empty? right\data [loop 1..(size right\data) 'unused -> 'rightData ++ 0.0]

    batchCount: lrCount spec\batchShape
    if and? [batchCount > 0][and? [spec\rows > 0][spec\cols > 0]] [
        loop 0..(batchCount - 1) 'batchIndex [
            loop 0..(spec\rows - 1) 'row [
                loop 0..(spec\cols - 1) 'col [
                    outputIndex: (batchIndex * spec\rows * spec\cols) + (row * spec\cols) + col
                    upstream: up\data\[outputIndex]
                    if spec\inner > 0 [loop 0..(spec\inner - 1) 'k [
                        indices: lrMatmulIndices spec batchIndex row col k
                        leftContribution: upstream * right\data\[indices\1]
                        rightContribution: upstream * left\data\[indices\0]
                        set leftData indices\0 (leftData\[indices\0] + leftContribution)
                        set rightData indices\1 (rightData\[indices\1] + rightContribution)
                    ]]
                ]
            ]
        ]
    ]
    leftGradient: lrMakeTensorOn left\shape leftData left\device
    rightGradient: lrMakeTensorOn right\shape rightData right\device
    return @[leftGradient rightGradient]
]

lrConv2dGradients: function [source weights up stride padding][
    lrTensorHostData source
    lrTensorHostData weights
    lrTensorHostData up
    sourceData: map source\data 'unused -> 0.0
    weightData: map weights\data 'unused -> 0.0
    batches: source\shape\0
    channels: source\shape\1
    inputHeight: source\shape\2
    inputWidth: source\shape\3
    outputs: weights\shape\0
    kernelHeight: weights\shape\2
    kernelWidth: weights\shape\3
    outputHeight: up\shape\2
    outputWidth: up\shape\3
    loop 0..(batches - 1) 'batch [
        loop 0..(outputs - 1) 'outputChannel [
            loop 0..(outputHeight - 1) 'outputY [
                loop 0..(outputWidth - 1) 'outputX [
                    outputPlane: batch * outputs
                    outputPlane: outputPlane + outputChannel
                    outputRow: outputPlane * outputHeight
                    outputRow: outputRow + outputY
                    outputIndex: outputRow * outputWidth
                    outputIndex: outputIndex + outputX
                    upstream: up\data\[outputIndex]
                    loop 0..(channels - 1) 'channel [
                        loop 0..(kernelHeight - 1) 'kernelY [
                            loop 0..(kernelWidth - 1) 'kernelX [
                                inputY: outputY * stride\0
                                inputY: inputY + kernelY
                                inputY: inputY - padding\0
                                inputX: outputX * stride\1
                                inputX: inputX + kernelX
                                inputX: inputX - padding\1
                                if and? [and? [inputY >= 0][inputY < inputHeight]][and? [inputX >= 0][inputX < inputWidth]] [
                                    inputPlane: batch * channels
                                    inputPlane: inputPlane + channel
                                    inputRow: inputPlane * inputHeight
                                    inputRow: inputRow + inputY
                                    inputIndex: inputRow * inputWidth
                                    inputIndex: inputIndex + inputX
                                    weightPlane: outputChannel * channels
                                    weightPlane: weightPlane + channel
                                    weightRow: weightPlane * kernelHeight
                                    weightRow: weightRow + kernelY
                                    weightIndex: weightRow * kernelWidth
                                    weightIndex: weightIndex + kernelX
                                    sourceContribution: upstream * weights\data\[weightIndex]
                                    weightContribution: upstream * source\data\[inputIndex]
                                    set sourceData inputIndex (sourceData\[inputIndex] + sourceContribution)
                                    set weightData weightIndex (weightData\[weightIndex] + weightContribution)
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
    sourceGradient: lrMakeTensorOn source\shape sourceData source\device
    weightGradient: lrMakeTensorOn weights\shape weightData weights\device
    return @[sourceGradient weightGradient]
]

lrPool2dGradient: function [source up kernel stride padding operation][
    data: map source\data 'unused -> 0.0
    batches: source\shape\0
    channels: source\shape\1
    inputHeight: source\shape\2
    inputWidth: source\shape\3
    outputHeight: up\shape\2
    outputWidth: up\shape\3
    loop 0..(batches - 1) 'batch [
        loop 0..(channels - 1) 'channel [
            loop 0..(outputHeight - 1) 'outputY [
                loop 0..(outputWidth - 1) 'outputX [
                    outputPlane: batch * channels
                    outputPlane: outputPlane + channel
                    outputRow: outputPlane * outputHeight
                    outputRow: outputRow + outputY
                    outputIndex: outputRow * outputWidth
                    outputIndex: outputIndex + outputX
                    validIndices: lrFreshBlock
                    maximumIndex: null
                    loop 0..(kernel\0 - 1) 'kernelY [
                        loop 0..(kernel\1 - 1) 'kernelX [
                            inputY: outputY * stride\0
                            inputY: inputY + kernelY
                            inputY: inputY - padding\0
                            inputX: outputX * stride\1
                            inputX: inputX + kernelX
                            inputX: inputX - padding\1
                            if and? [and? [inputY >= 0][inputY < inputHeight]][and? [inputX >= 0][inputX < inputWidth]] [
                                inputPlane: batch * channels
                                inputPlane: inputPlane + channel
                                inputRow: inputPlane * inputHeight
                                inputRow: inputRow + inputY
                                inputIndex: inputRow * inputWidth
                                inputIndex: inputIndex + inputX
                                'validIndices ++ inputIndex
                                if null? maximumIndex -> maximumIndex: inputIndex
                                if source\data\[inputIndex] > source\data\[maximumIndex] -> maximumIndex: inputIndex
                            ]
                        ]
                    ]
                    if operation = 'max -> set data maximumIndex (data\[maximumIndex] + up\data\[outputIndex])
                    if operation = 'average [
                        contribution: up\data\[outputIndex] / size validIndices
                        loop validIndices 'inputIndex -> set data inputIndex (data\[inputIndex] + contribution)
                    ]
                ]
            ]
        ]
    ]
    return lrMakeTensorOn source\shape data source\device
]

lrParameterTrainable?: function [item][
    if and? [dictionary? item\context][key? item\context 'trainable] -> return item\context\trainable
    return item\requiresGradient
]

lrAccumulate: function [node contribution][
    unless node\requiresGradient -> return null
    if and? [node\parameter][not? lrParameterTrainable? node] -> return null
    reduced: lrUnbroadcast contribution node\value\shape
    emptyGradient: null? node\gradient
    if emptyGradient -> node\gradient: reduced
    unless emptyGradient -> node\gradient: lrTensorBinary node\gradient reduced 'add
    return null
]

lrContainsIdentity?: function [items sought][
    loop items 'item [if item\id = sought\id -> return true]
    return false
]

lrTopo: function [node][
    seen: lrFreshBlock
    result: lrFreshBlock
    pending: @[@[node false]]

    while [not? empty? pending][
        item: pop 'pending
        current: item\0
        expanded: item\1

        if expanded [
            unless lrContainsIdentity? result current -> 'result ++ @[current]
        ]
        unless expanded [
            unless lrContainsIdentity? seen current [
                'seen ++ @[current]
                'pending ++ @[@[current true]]
                loop reverse current\parents 'parent -> 'pending ++ @[@[parent false]]
            ]
        ]
    ]
    return result
]

lrForwardNode: function [node][
    op: node\operation
    if or? [op = 'leaf][op = 'constant] -> return null

    if op = 'neg [
        minusOne: 0.0 - 1.0
        node\value: lrTensorBinary node\parents\0\value minusOne 'mul
    ]
    if op = 'exp -> node\value: lrTensorUnary node\parents\0\value 'exp
    if op = 'log -> node\value: lrTensorUnary node\parents\0\value 'log
    if op = 'abs -> node\value: lrTensorUnary node\parents\0\value 'abs
    if op = 'sigmoid -> node\value: lrTensorUnary node\parents\0\value 'sigmoid
    if op = 'relu -> node\value: lrTensorUnary node\parents\0\value 'relu
    if op = 'tanh -> node\value: lrTensorUnary node\parents\0\value 'tanh
    if op = 'softmax -> node\value: lrTensorSoftmax node\parents\0\value
    if op = 'crossEntropy -> node\value: lrTensorCrossEntropy node\parents\0\value node\parents\1\value
    if op = 'dropout -> node\value: lrDropoutTensor node\parents\0\value node\context
    if op = 'dense [
        linear: matmul node\parents\0\value node\parents\1\value
        node\value: lrTensorBinary linear node\parents\2\value 'add
    ]
    if op = 'conv2d -> node\value: lrTensorConv2d node\parents\0\value node\parents\1\value node\context\stride node\context\padding
    if op = 'maxPool2d -> node\value: lrTensorPool2d node\parents\0\value node\context\kernel node\context\stride node\context\padding 'max
    if op = 'avgPool2d -> node\value: lrTensorPool2d node\parents\0\value node\context\kernel node\context\stride node\context\padding 'average
    if op = 'add -> node\value: lrTensorBinary node\parents\0\value node\parents\1\value 'add
    if op = 'sub -> node\value: lrTensorBinary node\parents\0\value node\parents\1\value 'sub
    if op = 'mul -> node\value: lrTensorBinary node\parents\0\value node\parents\1\value 'mul
    if op = 'div -> node\value: lrTensorBinary node\parents\0\value node\parents\1\value 'div
    if op = 'pow -> node\value: lrTensorBinary node\parents\0\value node\parents\1\value 'pow
    if op = 'sum -> node\value: tensorSum node\parents\0\value
    if op = 'mean -> node\value: mean node\parents\0\value
    if op = 'sumAxis -> node\value: tensorSum.axis: node\context\axis node\parents\0\value
    if op = 'meanAxis -> node\value: mean.axis: node\context\axis node\parents\0\value
    if op = 'reshape -> node\value: reshape node\parents\0\value node\value\shape
    if op = 'transpose -> node\value: transpose.axes: node\context\axes node\parents\0\value
    if op = 'index -> node\value: tensorAt node\parents\0\value node\context\indices
    if op = 'transfer -> node\value: lrTensorTransfer node\parents\0\value node\context\device
    if op = 'matmul -> node\value: matmul node\parents\0\value node\parents\1\value
    return null
]

forwardValue: function [value][
    unless is? :learnValue value -> panic "learn: forwardValue expects a differentiable value"
    topoOrder: lrTopo value
    loop topoOrder 'node [lrForwardNode node]
    return value
]

zeroGrad: function [target][
    if is? :learnGraph target [
        graphItems: values target\values
        loop graphItems 'graphNode [
            if is? :learnValue graphNode [
                graphTopo: lrTopo graphNode
                loop graphTopo 'reachable -> reachable\gradient: null
            ]
        ]
        return target
    ]
    unless is? :learnValue target -> panic "learn: zeroGrad expects a value or graph"
    topoOrder: lrTopo target
    loop topoOrder 'node [node\gradient: null]
    return target
]

backward: function [output][
    unless is? :learnValue output -> panic "learn: backward expects a differentiable value"
    unless (size output\value\data) = 1 -> panic "learn: backward requires a one-element output"

    topoOrder: lrTopo output
    output\gradient: lrOnesLike output\value

    loop reverse topoOrder 'node [
        if or? [null? node\gradient][empty? node\parents] -> continue
        up: node\gradient
        op: node\operation

        if op = 'add [
            lrAccumulate node\parents\0 up
            lrAccumulate node\parents\1 up
        ]
        if op = 'sub [
            lrAccumulate node\parents\0 up
            minusOne: 0.0 - 1.0
            negativeUp: lrTensorBinary up minusOne 'mul
            lrAccumulate node\parents\1 negativeUp
        ]
        if op = 'mul [
            lrAccumulate node\parents\0 (lrTensorBinary up node\parents\1\value 'mul)
            lrAccumulate node\parents\1 (lrTensorBinary up node\parents\0\value 'mul)
        ]
        if op = 'div [
            lrAccumulate node\parents\0 (lrTensorBinary up node\parents\1\value 'div)
            denom2: lrTensorBinary node\parents\1\value 2.0 'pow
            numerator: lrTensorBinary up node\parents\0\value 'mul
            quotient: lrTensorBinary numerator denom2 'div
            minusOne: 0.0 - 1.0
            negativeQuotient: lrTensorBinary quotient minusOne 'mul
            lrAccumulate node\parents\1 negativeQuotient
        ]
        if op = 'neg [
            minusOne: 0.0 - 1.0
            negativeUp: lrTensorBinary up minusOne 'mul
            lrAccumulate node\parents\0 negativeUp
        ]
        if op = 'exp [
            local: lrTensorUnary node\parents\0\value 'exp
            contribution: lrTensorBinary up local 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'log [
            contribution: lrTensorBinary up node\parents\0\value 'div
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'abs [
            signData: map node\parents\0\value\data 'item -> (item > 0.0)? -> 1.0 -> (item < 0.0)? -> (0.0 - 1.0) -> 0.0
            sign: lrMakeTensorOn node\parents\0\value\shape signData node\parents\0\value\device
            contribution: lrTensorBinary up sign 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'sigmoid [
            one: lrOnesLike node\value
            complement: lrTensorBinary one node\value 'sub
            local: lrTensorBinary node\value complement 'mul
            contribution: lrTensorBinary up local 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'relu [
            maskData: map node\parents\0\value\data 'item -> (item > 0.0)? -> 1.0 -> 0.0
            mask: lrMakeTensor node\parents\0\value\shape maskData
            contribution: lrTensorBinary up mask 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'tanh [
            localValue: lrTensorUnary node\parents\0\value 'tanh
            localSquare: lrTensorBinary localValue 2.0 'pow
            one: lrOnesLike localValue
            local: lrTensorBinary one localSquare 'sub
            contribution: lrTensorBinary up local 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'softmax [
            probabilities: node\value
            spec: lrSoftmaxSpec probabilities
            groups: spec\0
            classes: spec\1
            data: lrFreshBlock
            if groups > 0 [loop 0..(groups - 1) 'groupIndex [
                offset: groupIndex * classes
                dot: 0.0
                loop 0..(classes - 1) 'classIndex -> dot: dot + (up\data\[offset + classIndex] * probabilities\data\[offset + classIndex])
                loop 0..(classes - 1) 'classIndex [
                    probability: probabilities\data\[offset + classIndex]
                    'data ++ probability * (up\data\[offset + classIndex] - dot)
                ]
            ]]
            contribution: lrMakeTensorOn probabilities\shape data probabilities\device
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'crossEntropy [
            scores: node\parents\0\value
            labels: node\parents\1\value
            spec: lrCrossEntropySpec scores labels
            samples: spec\0
            classes: spec\1
            probabilities: lrTensorSoftmax scores
            data: new probabilities\data
            loop 0..(samples - 1) 'sampleIndex [
                targetIndex: lrClassIndex labels\data\[sampleIndex] classes
                flatIndex: (sampleIndex * classes) + targetIndex
                set data flatIndex (data\[flatIndex] - 1.0)
            ]
            scale: up\data\0 / samples
            rawContribution: lrMakeTensorOn scores\shape data scores\device
            contribution: lrTensorBinary rawContribution scale 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'dropout [
            contribution: lrTensorBinary up node\context\mask 'mul
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'dense [
            gradients: lrMatmulGradients node\parents\0\value node\parents\1\value up
            lrAccumulate node\parents\0 gradients\0
            lrAccumulate node\parents\1 gradients\1
            lrAccumulate node\parents\2 up
        ]
        if op = 'conv2d [
            gradients: lrConv2dGradients node\parents\0\value node\parents\1\value up node\context\stride node\context\padding
            lrAccumulate node\parents\0 gradients\0
            lrAccumulate node\parents\1 gradients\1
        ]
        if op = 'maxPool2d [
            contribution: lrPool2dGradient node\parents\0\value up node\context\kernel node\context\stride node\context\padding 'max
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'avgPool2d [
            contribution: lrPool2dGradient node\parents\0\value up node\context\kernel node\context\stride node\context\padding 'average
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'pow [
            exponent: node\parents\1\value
            unless (size exponent\data) = 1 -> panic "learn: differentiable power requires a scalar exponent"
            p: exponent\data\0
            basePower: lrTensorBinary node\parents\0\value (p - 1.0) 'pow
            local: lrTensorBinary p basePower 'mul
            lrAccumulate node\parents\0 (lrTensorBinary up local 'mul)
        ]
        if op = 'sum [
            ones: lrOnesLike node\parents\0\value
            local: lrTensorBinary ones up 'mul
            lrAccumulate node\parents\0 local
        ]
        if op = 'mean [
            ones: lrOnesLike node\parents\0\value
            elementCount: size node\parents\0\value\data
            scale: up\data\0 / elementCount
            local: lrTensorBinary ones scale 'mul
            lrAccumulate node\parents\0 local
        ]
        if op = 'sumAxis [
            contribution: lrExpandReductionGradient up node\parents\0\value\shape node\context\axis 1.0
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'meanAxis [
            divisor: node\parents\0\value\shape\[node\context\axis]
            contribution: lrExpandReductionGradient up node\parents\0\value\shape node\context\axis (1.0 / divisor)
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'reshape ->
            lrAccumulate node\parents\0 (reshape up node\parents\0\value\shape)
        if op = 'transpose [
            axes: node\context\axes
            inverse: lrArgs (size axes)
            if not? empty? axes [
                loop 0..((size axes) - 1) 'outputAxis [
                    sourceAxis: axes\[outputAxis]
                    set inverse sourceAxis outputAxis
                ]
            ]
            lrAccumulate node\parents\0 (transpose.axes: inverse up)
        ]
        if op = 'index [
            contribution: lrZerosLike node\parents\0\value
            offset: lrFlatIndex contribution\shape node\context\indices
            set contribution\data offset up\data\0
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'transfer [
            contribution: lrTensorTransfer up node\parents\0\value\device
            lrAccumulate node\parents\0 contribution
        ]
        if op = 'matmul [
            gradients: lrMatmulGradients node\parents\0\value node\parents\1\value up
            lrAccumulate node\parents\0 gradients\0
            lrAccumulate node\parents\1 gradients\1
        ]
    ]
    return output
]
