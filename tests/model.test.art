import'unitt!
import relative {../src/learn}!

suite "graphs and optimization" [
    test "declares shaped input placeholders for matrix graphs" [
        model: graph [
            x: inputShape [1 2]
            weight: parameter.zeros [2 3]
            logits: matmul x weight
            loss: mean logits
        ]
        assert -> [1 2] = model\x\value\shape
        assert -> [1 3] = model\logits\value\shape
        runtimeInput: tensor [[1.0 2.0] [3.0 4.0]]
        forward.with: #[x: runtimeInput] model
        assert -> [2 3] = model\logits\value\shape
    ]

    test "feeds declared inputs and exposes ordinary graph data" [
        model: graph [
            x: input
            y: input
            w: parameter 0.0
            prediction: x * w
            residual: prediction - y
            loss: mean square residual
        ]
        feed: #[x: tensor [1.0 2.0] y: tensor [2.0 4.0]]
        forward.with: feed model
        declaredInputs: inputs model
        namedOperations: operations model
        data: graphData model
        plainData?: dictionary? data
        assert -> ['x 'y] = declaredInputs
        assert -> contains? namedOperations 'loss
        assert -> plainData?
        assert -> "learn.graph" = data\format
        assert -> 'input = data\nodes\x\role
        assert -> 'parameter = data\nodes\w\role
    ]

    test "requires complete and known input feeds" [
        model: graph [
            x: input
            y: input
            total: x + y
            loss: mean total
        ]
        firstFeed: #[x: 1.0]
        missingFeedRejected: throws? [forward.with: firstFeed model]
        unknownFeedRejected: throws? [forward.with: #[x: 1.0 y: 2.0 z: 3.0] model]
        assert -> missingFeedRejected
        assert -> unknownFeedRejected
    ]

    test "discovers parameters in declaration order" [
        x: tensor [[1.0]]
        model: graph [
            w: parameter.zeros [1 1]
            b: parameter.zeros [1]
            linear: matmul x w
            prediction: linear + b
            loss: mean square prediction
        ]
        found: parameters model
        firstParameter: found\0
        secondParameter: found\1
        modelW: model\w
        modelB: model\b
        assert -> 2 = size found
        assert -> same? firstParameter modelW
        assert -> same? secondParameter modelB
    ]

    test "SGD performs an update and forward recomputes values" [
        x: tensor [[2.0]]
        model: graph [
            w: parameter.zeros [1 1]
            prediction: matmul x w
            residual: prediction - (tensor [[4.0]])
            loss: mean square residual
        ]
        optimizer: sgd.rate: 0.1 (parameters model)
        zeroGrad model
        forward model
        backward model\loss
        step optimizer
        forward model
        weight: model\w\value\data\0
        lossValue: model\loss\value\data\0
        assert -> 1.6 = weight
        assert -> 0.64 > lossValue
    ]

    test "learns y = 2x + 1" [
        xTrain: tensor [0.0 1.0 2.0 3.0]
        yTrain: tensor [1.0 3.0 5.0 7.0]
        model: graph [
            x: input
            y: input
            w: parameter 0.0
            b: parameter 0.0
            linear: x * w
            prediction: linear + b
            residual: prediction - y
            squared: square residual
            loss: mean squared
        ]
        optimizer: sgd.rate: 0.05 (parameters model)
        do.times: 500 [
            zeroGrad model
            forward.with: #[x: xTrain y: yTrain] model
            backward model\loss
            step optimizer
        ]
        weight: model\w\value\data\0
        bias: model\b\value\data\0
        weightError: abs weight - 2.0
        biasError: abs bias - 1.0
        assert -> weightError < 0.05
        assert -> biasError < 0.05
    ]
]
