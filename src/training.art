; Deterministic mini-batch iteration and resumable data order.

import relative {./state}!

define :learnBatcher [
    init: constructor [features targets batchSize shuffle seed epoch position order]
]

define :learnStepLr [
    init: constructor [optimizer factor every epochs]
]

gradientNorm: function [parameterList][
    unless block? parameterList -> panic "learn: gradientNorm expects a parameter block"
    squaredTotal: 0.0
    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] -> panic "learn: gradientNorm expects parameter values"
        if null? item\gradient -> panic "learn: cannot measure a parameter without a gradient"
        loop item\gradient\data 'component -> squaredTotal: squaredTotal + (component * component)
    ]
    return squaredTotal ^ 0.5
]

clipGradNorm: function [parameterList][
    maximum: attr 'max
    unless and? [lrNumeric? maximum][maximum > 0.0] -> panic "learn: clipGradNorm.max must be positive"
    norm: gradientNorm parameterList
    if norm > maximum [
        scale: maximum / norm
        loop parameterList 'item -> item\gradient: lrTensorBinary item\gradient scale 'mul
    ]
    return norm
]

stepLr: function [optimizer][
    callAttrs: attrs
    factor: 0.1
    every: 10
    if key? callAttrs 'factor -> factor: callAttrs\factor
    if key? callAttrs 'every -> every: callAttrs\every
    unless or? [is? :learnSgd optimizer][or? [is? :learnMomentum optimizer][is? :learnAdam optimizer]] -> panic "learn: stepLr expects an optimizer"
    unless and? [lrNumeric? factor][factor > 0.0] -> panic "learn: stepLr.factor must be positive"
    unless and? [integer? every][every > 0] -> panic "learn: stepLr.every must be a positive integer"
    args: lrArgs 4
    set args 0 optimizer
    set args 1 to :floating factor
    set args 2 every
    set args 3 0
    return to :learnStepLr args
]

schedulerStep: function [scheduler][
    unless is? :learnStepLr scheduler -> panic "learn: schedulerStep expects a learning-rate scheduler"
    scheduler\epochs: scheduler\epochs + 1
    if (scheduler\epochs % scheduler\every) = 0 -> scheduler\optimizer\rate: scheduler\optimizer\rate * scheduler\factor
    return scheduler\optimizer\rate
]

schedulerState: function [scheduler][
    unless is? :learnStepLr scheduler -> panic "learn: schedulerState expects a learning-rate scheduler"
    return #[format: "learn.scheduler-state" version: "0.15" kind: 'step factor: scheduler\factor every: scheduler\every epochs: scheduler\epochs rate: scheduler\optimizer\rate]
]

lrValidateSchedulerState: function [scheduler state][
    unless is? :learnStepLr scheduler -> panic "learn: scheduler state expects a learning-rate scheduler"
    unless and? [dictionary? state][and? [key? state 'format][state\format = "learn.scheduler-state"]] -> panic "learn: unsupported scheduler state format"
    unless and? [key? state 'version][state\version = "0.15"] -> panic "learn: unsupported scheduler state version"
    unless and? [key? state 'kind][state\kind = 'step] -> panic "learn: unsupported scheduler state kind"
    loop ['factor 'every 'epochs 'rate] 'field [unless key? state field -> panic ~"learn: scheduler state is missing |field|"]
    unless state\factor = scheduler\factor -> panic "learn: scheduler state factor does not match"
    unless state\every = scheduler\every -> panic "learn: scheduler state interval does not match"
    unless and? [integer? state\epochs][state\epochs >= 0] -> panic "learn: scheduler state epoch count is invalid"
    unless and? [lrNumeric? state\rate][state\rate > 0.0] -> panic "learn: scheduler state rate is invalid"
    return state
]

loadSchedulerState: function [scheduler state][
    valid: lrValidateSchedulerState scheduler state
    scheduler\epochs: valid\epochs
    scheduler\optimizer\rate: to :floating valid\rate
    return scheduler
]

lrSchedulerCheckpointPayload: function [state][@[state\factor state\every state\epochs state\rate]]

lrSchedulerStateFromPayload: function [payload][
    unless and? [block? payload][(size payload) = 4] -> panic "learn: malformed scheduler checkpoint payload"
    return #[format: "learn.scheduler-state" version: "0.15" kind: 'step factor: payload\0 every: payload\1 epochs: payload\2 rate: payload\3]
]

lrDatasetRows: function [value label][
    source: lrAsTensor value
    if empty? source\shape -> panic ~"learn: |label| must have a row dimension"
    return source\shape\0
]

lrTrailingShape: function [dims startAxis][
    result: lrFreshBlock
    if startAxis < (size dims) [loop startAxis..((size dims) - 1) 'axis -> 'result ++ dims\[axis]]
    return result
]

lrTakeRows: function [value indices][
    source: lrAsTensor value
    unless block? indices -> panic "learn: row indices must be a block"
    rows: lrDatasetRows source "tensor"
    rowWidth: (rows = 0)? -> lrCount lrLeadingShape source\shape 1 -> (size source\data) / rows
    rowWidth: to :integer rowWidth
    data: lrFreshBlock
    loop indices 'row [
        unless integer? row -> panic "learn: row indices must be integers"
        if row < 0 -> row: row + rows
        unless and? [row >= 0][row < rows] -> panic ~"learn: row index |row| is out of bounds"
        if rowWidth > 0 [loop 0..(rowWidth - 1) 'offset -> 'data ++ source\data\[(row * rowWidth) + offset]]
    ]
    outputShape: @[(size indices)]
    trailing: lrTrailingShape source\shape 1
    loop trailing 'dim -> 'outputShape ++ dim
    return lrMakeTensorOn outputShape data source\device
]

lrBatchOrder: function [count seed epoch shuffle][
    order: lrFreshBlock
    if count > 0 [loop 0..(count - 1) 'indexValue -> 'order ++ indexValue]
    unless shuffle -> return order
    state: seed + (epoch * 104729) + 1
    if count > 1 [
        candidates: reverse 1..(count - 1)
        loop candidates 'shuffleIndex [
            state: ((state * 1103515245) + 12345) % 2147483648
            chosen: state % (shuffleIndex + 1)
            held: order\[shuffleIndex]
            set order shuffleIndex order\[chosen]
            set order chosen held
        ]
    ]
    return order
]

batcher: function [features targets][
    callAttrs: attrs
    batchSize: 32
    shuffle: true
    seed: 0
    if key? callAttrs 'size -> batchSize: callAttrs\size
    if key? callAttrs 'shuffle -> shuffle: callAttrs\shuffle
    if key? callAttrs 'seed -> seed: callAttrs\seed
    unless and? [integer? batchSize][batchSize > 0] -> panic "learn: batch size must be a positive integer"
    unless logical? shuffle -> panic "learn: batcher.shuffle must be logical"
    unless integer? seed -> panic "learn: batcher seed must be an integer"
    x: lrAsTensor features
    y: lrAsTensor targets
    rows: lrDatasetRows x "features"
    unless rows = (lrDatasetRows y "targets") -> panic "learn: features and targets must have equal rows"
    args: lrArgs 8
    set args 0 x
    set args 1 y
    set args 2 batchSize
    set args 3 shuffle
    set args 4 seed
    set args 5 0
    set args 6 0
    set args 7 lrBatchOrder rows seed 0 shuffle
    return to :learnBatcher args
]

nextBatch: function [iterator][
    unless is? :learnBatcher iterator -> panic "learn: nextBatch expects a batcher"
    rows: iterator\features\shape\0
    if rows = 0 -> panic "learn: cannot iterate an empty dataset"
    if iterator\position >= rows [
        iterator\epoch: iterator\epoch + 1
        iterator\position: 0
        iterator\order: lrBatchOrder rows iterator\seed iterator\epoch iterator\shuffle
    ]
    stop: min @[rows (iterator\position + iterator\batchSize)]
    indices: lrFreshBlock
    loop iterator\position..(stop - 1) 'position -> 'indices ++ iterator\order\[position]
    iterator\position: stop
    return #[
        features: lrTakeRows iterator\features indices
        targets: lrTakeRows iterator\targets indices
        indices: indices
        epoch: iterator\epoch
    ]
]

batcherState: function [iterator][
    unless is? :learnBatcher iterator -> panic "learn: batcherState expects a batcher"
    return #[format: "learn.batcher-state" version: "0.13" rows: iterator\features\shape\0 batchSize: iterator\batchSize shuffle: iterator\shuffle seed: iterator\seed epoch: iterator\epoch position: iterator\position order: new iterator\order]
]

lrValidateBatcherState: function [iterator state][
    unless is? :learnBatcher iterator -> panic "learn: batcher state expects a batcher"
    unless and? [dictionary? state][and? [key? state 'format][state\format = "learn.batcher-state"]] -> panic "learn: unsupported batcher state format"
    unless and? [key? state 'version][state\version = "0.13"] -> panic "learn: unsupported batcher state version"
    loop ['rows 'batchSize 'shuffle 'seed 'epoch 'position 'order] 'field [unless key? state field -> panic ~"learn: batcher state is missing |field|"]
    rows: iterator\features\shape\0
    unless state\rows = rows -> panic "learn: batcher state row count does not match"
    unless state\batchSize = iterator\batchSize -> panic "learn: batcher state batch size does not match"
    unless logical? state\shuffle -> panic "learn: batcher state shuffle flag is invalid"
    unless integer? state\seed -> panic "learn: batcher state seed is invalid"
    unless and? [integer? state\epoch][state\epoch >= 0] -> panic "learn: batcher state epoch is invalid"
    unless and? [integer? state\position][and? [state\position >= 0][state\position =< rows]] -> panic "learn: batcher state position is invalid"
    unless and? [block? state\order][(size state\order) = rows] -> panic "learn: batcher state order is invalid"
    sortedOrder: sort new state\order
    expected: lrBatchOrder rows 0 0 false
    unless sortedOrder = expected -> panic "learn: batcher state order is not a permutation"
    return state
]

loadBatcherState: function [iterator state][
    valid: lrValidateBatcherState iterator state
    iterator\shuffle: valid\shuffle
    iterator\seed: valid\seed
    iterator\epoch: valid\epoch
    iterator\position: valid\position
    iterator\order: new valid\order
    return iterator
]

lrBatcherCheckpointPayload: function [state][
    shuffleCode: 0
    if state\shuffle -> shuffleCode: 1
    return @[state\rows state\batchSize shuffleCode state\seed state\epoch state\position new state\order]
]

lrBatcherStateFromPayload: function [payload][
    unless and? [block? payload][(size payload) = 7] -> panic "learn: malformed batcher checkpoint payload"
    unless contains? [0 1] payload\2 -> panic "learn: malformed batcher shuffle flag"
    shuffle: payload\2 = 1
    return #[format: "learn.batcher-state" version: "0.13" rows: payload\0 batchSize: payload\1 shuffle: shuffle seed: payload\3 epoch: payload\4 position: payload\5 order: payload\6]
]

saveSessionCheckpoint: function [model optimizer iterator path][
    callAttrs: attrs
    modelPayload: lrModelCheckpointPayload stateDict model
    optimizerPayload: lrOptimizerCheckpointPayload optimizerState optimizer
    batcherPayload: lrBatcherCheckpointPayload batcherState iterator
    payload: @[10013 modelPayload optimizerPayload batcherPayload]
    if key? callAttrs 'scheduler [
        unless is? :learnStepLr callAttrs\scheduler -> panic "learn: checkpoint scheduler must be a learning-rate scheduler"
        unless same? callAttrs\scheduler\optimizer optimizer -> panic "learn: checkpoint scheduler belongs to a different optimizer"
        savedSchedulerState: schedulerState callAttrs\scheduler
        schedulerPayload: lrSchedulerCheckpointPayload savedSchedulerState
        payload: @[10015 modelPayload optimizerPayload batcherPayload schedulerPayload]
    ]
    write (to :string payload) path
    return path
]

loadSessionCheckpoint: function [model optimizer iterator path][
    callAttrs: attrs
    payload: parse read path
    unless and? [block? payload][not? empty? payload] -> panic "learn: malformed session checkpoint payload"
    unless contains? [10013 10015] payload\0 -> panic "learn: unsupported session checkpoint header"
    expectedSize: (payload\0 = 10015)? -> 5 -> 4
    unless (size payload) = expectedSize -> panic "learn: malformed session checkpoint payload"
    modelState: lrStateFromCheckpointPayload payload\1
    optimizerStateValue: lrOptimizerStateFromCheckpointPayload payload\2 (size optimizer\parameterList)
    batcherStateValue: lrBatcherStateFromPayload payload\3
    validatedModel: lrValidateState model modelState true
    validatedOptimizer: lrValidateOptimizerState optimizer optimizerStateValue
    validatedBatcher: lrValidateBatcherState iterator batcherStateValue
    validatedScheduler: null
    if payload\0 = 10015 [
        unless key? callAttrs 'scheduler -> panic "learn: scheduler checkpoint requires loadSessionCheckpoint.scheduler"
        unless is? :learnStepLr callAttrs\scheduler -> panic "learn: checkpoint scheduler must be a learning-rate scheduler"
        unless same? callAttrs\scheduler\optimizer optimizer -> panic "learn: checkpoint scheduler belongs to a different optimizer"
        schedulerStateValue: lrSchedulerStateFromPayload payload\4
        validatedScheduler: lrValidateSchedulerState callAttrs\scheduler schedulerStateValue
    ]
    lrApplyValidatedState validatedModel
    lrApplyValidatedOptimizerState validatedOptimizer
    loadBatcherState iterator validatedBatcher
    unless null? validatedScheduler -> loadSchedulerState callAttrs\scheduler validatedScheduler
    return model
]

lrTrainingFeed: function [inputNames batch][
    feed: lrFreshDictionary
    set feed inputNames\0 batch\features
    set feed inputNames\1 batch\targets
    return feed
]

lrTrainingLoss: function [model lossName][
    lossValue: model\values\[lossName]
    unless is? :learnValue lossValue -> panic ~"learn: training loss |lossName| must be differentiable"
    unless (size lossValue\value\data) = 1 -> panic ~"learn: training loss |lossName| must be scalar"
    return lossValue\value\data\0
]

lrValidateTrainingNames: function [model inputNames lossName][
    unless and? [block? inputNames][(size inputNames) = 2] -> panic "learn: train.inputs must contain feature and target input names"
    normalized: lrFreshBlock
    loop inputNames 'inputName [
        literalName: to :literal inputName
        unless contains? model\inputList literalName -> panic ~"learn: graph has no training input named |literalName|"
        'normalized ++ literalName
    ]
    unless key? model\values lossName -> panic ~"learn: graph has no loss named |lossName|"
    return normalized
]

lrValidationLoss: function [model validation inputNames lossName batchSize][
    unless dictionary? validation -> panic "learn: train.validation must be a features/targets dictionary"
    unless and? [key? validation 'features][key? validation 'targets] -> panic "learn: train.validation requires features and targets"
    validationIterator: batcher.size: batchSize.shuffle: false validation\features validation\targets
    validationRows: validationIterator\features\shape\0
    if validationRows = 0 -> panic "learn: validation dataset cannot be empty"
    weightedLoss: 0.0
    while [validationIterator\position < validationRows][
        batch: nextBatch validationIterator
        feed: lrTrainingFeed inputNames batch
        forward.with: feed model
        batchRows: size batch\indices
        batchLoss: lrTrainingLoss model lossName
        weightedLoss: weightedLoss + (batchLoss * batchRows)
    ]
    return weightedLoss / validationRows
]

; Train for a number of additional epochs. A callback is named with a literal,
; receives the completed epoch record, and returns false to stop early.
train: function [model optimizer iterator][
    callAttrs: attrs
    epochs: 1
    inputNames: ['x 'y]
    lossName: 'loss
    validation: null
    callbackName: null
    clipMaximum: null
    scheduler: null
    if key? callAttrs 'epochs -> epochs: callAttrs\epochs
    if key? callAttrs 'inputs -> inputNames: callAttrs\inputs
    if key? callAttrs 'loss -> lossName: to :literal callAttrs\loss
    if key? callAttrs 'validation -> validation: callAttrs\validation
    if key? callAttrs 'callback -> callbackName: callAttrs\callback
    if key? callAttrs 'clip -> clipMaximum: callAttrs\clip
    if key? callAttrs 'scheduler -> scheduler: callAttrs\scheduler

    unless is? :learnGraph model -> panic "learn: train expects a graph"
    unless or? [is? :learnSgd optimizer][or? [is? :learnMomentum optimizer][is? :learnAdam optimizer]] -> panic "learn: train expects an optimizer"
    unless is? :learnBatcher iterator -> panic "learn: train expects a batcher"
    unless and? [integer? epochs][epochs > 0] -> panic "learn: train.epochs must be a positive integer"
    names: lrValidateTrainingNames model inputNames lossName
    unless null? callbackName [unless literal? callbackName -> panic "learn: train.callback must be a function name literal"]
    unless null? clipMaximum [unless and? [lrNumeric? clipMaximum][clipMaximum > 0.0] -> panic "learn: train.clip must be positive"]
    unless null? scheduler [
        unless is? :learnStepLr scheduler -> panic "learn: train.scheduler must be a learning-rate scheduler"
        unless same? scheduler\optimizer optimizer -> panic "learn: training scheduler belongs to a different optimizer"
    ]

    records: lrFreshBlock
    totalBatches: 0
    stoppedEarly: false
    stopReason: null
    completed: 0
    rows: iterator\features\shape\0
    if rows = 0 -> panic "learn: training dataset cannot be empty"

    while [completed < epochs][
        if iterator\position >= rows [
            iterator\epoch: iterator\epoch + 1
            iterator\position: 0
            iterator\order: lrBatchOrder rows iterator\seed iterator\epoch iterator\shuffle
        ]
        partialEpoch: iterator\position > 0
        epochLoss: 0.0
        epochRows: 0
        epochBatches: 0
        epochNumber: iterator\epoch
        epochRate: optimizer\rate
        while [iterator\position < rows][
            batch: nextBatch iterator
            feed: lrTrainingFeed names batch
            zeroGrad model
            forward.with: feed model
            backward model\values\[lossName]
            unless null? clipMaximum -> clipGradNorm.max: clipMaximum optimizer\parameterList
            step optimizer
            batchRows: size batch\indices
            batchLoss: lrTrainingLoss model lossName
            epochLoss: epochLoss + (batchLoss * batchRows)
            epochRows: epochRows + batchRows
            epochBatches: epochBatches + 1
            totalBatches: totalBatches + 1
        ]
        meanLoss: epochLoss / epochRows
        validationLoss: null
        unless null? validation -> validationLoss: lrValidationLoss model validation names lossName iterator\batchSize
        record: #[epoch: epochNumber trainLoss: meanLoss validationLoss: validationLoss learningRate: epochRate batches: epochBatches rows: epochRows partial: partialEpoch]
        'records ++ @[record]
        completed: completed + 1
        iterator\epoch: iterator\epoch + 1
        iterator\position: 0
        iterator\order: lrBatchOrder rows iterator\seed iterator\epoch iterator\shuffle
        unless null? scheduler -> schedulerStep scheduler

        unless null? callbackName [
            shouldContinue: call callbackName @[record]
            unless logical? shouldContinue -> panic "learn: training callback must return a logical value"
            unless shouldContinue [
                stoppedEarly: true
                stopReason: "callback"
                break
            ]
        ]
    ]

    return #[format: "learn.training-history" version: "0.15" epochs: records batches: totalBatches stoppedEarly: stoppedEarly stopReason: stopReason]
]
