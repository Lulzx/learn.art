; Named differentiable graphs, parameters, and stateful SGD.

import relative {./autograd}!

define :learnGraph [
    init: constructor [values names parameterList inputList source feeds]

    get: method [what][
        if key? this\values what -> return this\values\[what]
        panic ~"learn: graph has no value named |what|"
    ]

    dictionary: method [][graphData this]

    string: method [][~"learn graph |this\names|"]
]

define :learnSgd [
    init: constructor [parameterList rate]
    string: method [][~"SGD(rate: |this\rate|, parameters: |size this\parameterList|)"]
]

define :learnMomentum [
    init: constructor [parameterList rate beta velocities]
]

define :learnAdam [
    init: constructor [parameterList rate beta1 beta2 epsilon firstMoments secondMoments timestep]
]

; `input` intentionally replaces Arturo's terminal-input word after import.
; In a graph block it constructs a symbolic, initially scalar placeholder.
input: function [][
    return lrMakeValue #[
        value: tensor 0.0
        requiresGradient: false
        operation: 'input
        parents: lrFreshBlock
        parameter: false
    ]
]

parameter: function [dims][
    callAttrs: attrs
    makeZeros: key? callAttrs 'zeros
    makeRandom: key? callAttrs 'random

    unless or? [makeZeros][makeRandom] [
        source: lrAsTensor dims
        result: variable source
        result\parameter: true
        return result
    ]

    lrValidateShape dims
    data: lrFreshBlock
    count: lrCount dims
    if count > 0 [
        loop 1..count 'unused [
            item: 0.0
            if makeRandom -> item: lrRandomSmall
            'data ++ item
        ]
    ]
    source: lrMakeTensor dims data
    result: variable source
    result\parameter: true
    return result
]

lrGraphNames: function [body][
    result: lrFreshBlock
    loop body 'token [
        if label? token -> 'result ++ @[to :literal to :string token]
    ]
    return result
]

graph: function [body][
    unless block? body -> panic "learn: graph expects a block"
    names: lrGraphNames body
    if empty? names -> panic "learn: graph must contain labeled expressions"

    ; The block runs in this call frame. Its labels therefore become visible
    ; through `symbols`, while references to the caller's tensors remain valid.
    do body
    scope: symbols
    graphValues: lrFreshDictionary
    parameterList: lrFreshBlock
    inputList: lrFreshBlock

    loop names 'name [
        unless key? scope name -> panic ~"learn: graph could not evaluate |name|"
        item: scope\[name]
        unless or? [is? :learnValue item][is? :learnTensor item] ->
            panic ~"learn: graph value |name| is not a tensor expression"
        set graphValues name item
        if and? [is? :learnValue item][item\parameter] -> 'parameterList ++ @[item]
        if and? [is? :learnValue item][item\operation = 'input] -> 'inputList ++ @[name]
    ]

    args: lrArgs 6
    set args 0 graphValues
    set args 1 names
    set args 2 parameterList
    set args 3 inputList
    set args 4 new body
    graphFeeds: lrFreshDictionary
    set args 5 graphFeeds
    resultGraph: to :learnGraph args
    ; Arturo object construction aliases empty dictionary fields across
    ; instances, so install the per-graph feed store explicitly.
    set resultGraph 'feeds graphFeeds
    return resultGraph
]

inputs: function [model][
    unless is? :learnGraph model -> panic "learn: inputs expects a graph"
    return new model\inputList
]

parameters: function [model][
    unless is? :learnGraph model -> panic "learn: parameters expects a graph"
    return model\parameterList
]

forward: function [model][
    callAttrs: attrs
    unless is? :learnGraph model -> panic "learn: forward expects a graph"

    if key? callAttrs 'with [
        feed: callAttrs\with
        unless dictionary? feed -> panic "learn: forward.with expects a dictionary of input values"
        loop keys feed 'name [
            unless contains? model\inputList to :literal name ->
                panic ~"learn: graph has no input named |name|"
        ]
        loop model\inputList 'name [
            if key? feed name [
            node: model\values\[name]
            node\value: lrAsTensor feed\[name]
            set model\feeds name true
            ]
        ]
    ]

    loop model\inputList 'name [
        unless key? model\feeds name -> panic ~"learn: input |name| has not been provided"
    ]

    loop model\names 'name [
        item: model\values\[name]
        if is? :learnValue item -> forwardValue item
    ]
    return model
]

operations: function [model][
    unless is? :learnGraph model -> panic "learn: operations expects a graph"
    result: lrFreshBlock
    loop model\names 'name [
        item: model\values\[name]
        if is? :learnValue item [
            unless contains? ['leaf 'constant 'input] item\operation -> 'result ++ @[name]
        ]
    ]
    return result
]

lrGraphNameOf: function [model sought][
    loop model\names 'name [
        candidate: model\values\[name]
        if and? [is? :learnValue candidate][candidate\id = sought\id] -> return name
    ]
    return null
]

lrTensorData: function [value][
    source: lrAsTensor value
    return #[shape: new source\shape data: new source\data]
]

lrGraphNodeData: function [model name][
    item: model\values\[name]
    if is? :learnTensor item ->
        return #[role: 'constant value: lrTensorData item]

    role: 'operation
    if contains? ['leaf 'constant] item\operation -> role: 'constant
    if item\operation = 'input -> role: 'input
    if item\parameter -> role: 'parameter

    parentData: lrFreshBlock
    loop item\parents 'parent [
        parentName: lrGraphNameOf model parent
        if null? parentName -> 'parentData ++ @[#[role: 'constant value: lrTensorData parent\value]]
        unless null? parentName -> 'parentData ++ @[parentName]
    ]

    return #[
        role: role
        operation: item\operation
        shape: new item\value\shape
        parents: parentData
        context: item\context
        value: (role = 'parameter)? -> lrTensorData item\value -> null
    ]
]

graphData: function [model][
    unless is? :learnGraph model -> panic "learn: graphData expects a graph"
    nodes: lrFreshDictionary
    parameterNames: lrFreshBlock
    loop model\names 'name [
        nodeData: lrGraphNodeData model name
        set nodes name nodeData
        if nodeData\role = 'parameter -> 'parameterNames ++ @[name]
    ]
    return #[
        format: "learn.graph"
        version: "0.2"
        inputs: new model\inputList
        parameters: parameterNames
        order: new model\names
        nodes: nodes
    ]
]

explain: function [model][
    data: graphData model
    lines: @[~"graph(inputs: |data\inputs|, parameters: |data\parameters|)"]
    loop data\order 'name [
        node: data\nodes\[name]
        'lines ++ ~"|name|: |node\role| |node\operation| <- |node\parents|"
    ]
    return join.with: "\n" lines
]

sgd: function [parameterList][
    rate: 0.01
    requestedRate: attr 'rate
    unless null? requestedRate -> rate: requestedRate
    unless lrNumeric? rate -> panic "learn: SGD rate must be numeric"
    unless rate > 0 -> panic "learn: SGD rate must be positive"

    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] ->
            panic "learn: SGD expects parameter values"
    ]

    args: lrArgs 2
    set args 0 parameterList
    set args 1 to :floating rate
    return to :learnSgd args
]

lrValidateParameters: function [parameterList][
    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] ->
            panic "learn: optimizer expects parameter values"
    ]
    return parameterList
]

momentum: function [parameterList][
    callAttrs: attrs
    rate: 0.01
    beta: 0.9
    if key? callAttrs 'rate -> rate: callAttrs\rate
    if key? callAttrs 'beta -> beta: callAttrs\beta
    unless and? [lrNumeric? rate][rate > 0.0] -> panic "learn: momentum rate must be positive"
    unless and? [lrNumeric? beta][and? [beta >= 0.0][beta < 1.0]] -> panic "learn: momentum beta must be in [0, 1)"
    lrValidateParameters parameterList
    velocities: lrFreshBlock
    loop parameterList 'item -> 'velocities ++ lrZerosLike item\value
    args: lrArgs 4
    set args 0 parameterList
    set args 1 to :floating rate
    set args 2 to :floating beta
    set args 3 velocities
    return to :learnMomentum args
]

adam: function [parameterList][
    callAttrs: attrs
    rate: 0.001
    beta1: 0.9
    beta2: 0.999
    epsilon: 0.00000001
    if key? callAttrs 'rate -> rate: callAttrs\rate
    if key? callAttrs 'beta1 -> beta1: callAttrs\beta1
    if key? callAttrs 'beta2 -> beta2: callAttrs\beta2
    if key? callAttrs 'epsilon -> epsilon: callAttrs\epsilon
    unless and? [lrNumeric? rate][rate > 0.0] -> panic "learn: Adam rate must be positive"
    lrValidateParameters parameterList
    firstMoments: lrFreshBlock
    secondMoments: lrFreshBlock
    loop parameterList 'item [
        'firstMoments ++ lrZerosLike item\value
        'secondMoments ++ lrZerosLike item\value
    ]
    args: lrArgs 8
    set args 0 parameterList
    set args 1 to :floating rate
    set args 2 to :floating beta1
    set args 3 to :floating beta2
    set args 4 to :floating epsilon
    set args 5 firstMoments
    set args 6 secondMoments
    set args 7 0
    return to :learnAdam args
]

step: function [optimizer][
    supported: or? [is? :learnSgd optimizer][or? [is? :learnMomentum optimizer][is? :learnAdam optimizer]]
    unless supported -> panic "learn: step expects an optimizer"

    if is? :learnAdam optimizer -> optimizer\timestep: optimizer\timestep + 1
    itemCount: size optimizer\parameterList
    if itemCount > 0 [loop 0..(itemCount - 1) 'i [
        item: optimizer\parameterList\[i]
        if null? item\gradient -> panic "learn: cannot step a parameter without a gradient"
        update: null

        if is? :learnSgd optimizer -> update: lrTensorBinary item\gradient optimizer\rate 'mul
        if is? :learnMomentum optimizer [
            oldVelocity: optimizer\velocities\[i]
            retained: lrTensorBinary oldVelocity optimizer\beta 'mul
            velocity: lrTensorBinary retained item\gradient 'add
            set optimizer\velocities i velocity
            update: lrTensorBinary velocity optimizer\rate 'mul
        ]
        if is? :learnAdam optimizer [
            oldFirst: optimizer\firstMoments\[i]
            oldSecond: optimizer\secondMoments\[i]
            retainedFirst: lrTensorBinary oldFirst optimizer\beta1 'mul
            newFirstPart: lrTensorBinary item\gradient (1.0 - optimizer\beta1) 'mul
            firstMoment: lrTensorBinary retainedFirst newFirstPart 'add
            gradientSquare: lrTensorBinary item\gradient 2.0 'pow
            retainedSecond: lrTensorBinary oldSecond optimizer\beta2 'mul
            newSecondPart: lrTensorBinary gradientSquare (1.0 - optimizer\beta2) 'mul
            secondMoment: lrTensorBinary retainedSecond newSecondPart 'add
            set optimizer\firstMoments i firstMoment
            set optimizer\secondMoments i secondMoment
            firstCorrection: 1.0 - (optimizer\beta1 ^ optimizer\timestep)
            secondCorrection: 1.0 - (optimizer\beta2 ^ optimizer\timestep)
            correctedFirst: lrTensorBinary firstMoment firstCorrection 'div
            correctedSecond: lrTensorBinary secondMoment secondCorrection 'div
            rootSecond: lrTensorBinary correctedSecond 0.5 'pow
            denominator: lrTensorBinary rootSecond optimizer\epsilon 'add
            direction: lrTensorBinary correctedFirst denominator 'div
            update: lrTensorBinary direction optimizer\rate 'mul
        ]

        nextValue: lrTensorBinary item\value update 'sub
        item\value\data: nextValue\data
    ]]
    return optimizer
]
