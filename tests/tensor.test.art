import'unitt!
import relative {../src/learn}!

suite "dense tensors" [
    test "constructs scalar, vector, and matrix tensors" [
        scalarTensor: tensor 2
        vectorTensor: tensor [1 2 3]
        matrixTensor: tensor [[1 2] [3 4]]
        scalarShape: shape scalarTensor
        vectorShape: shape vectorTensor
        matrixShape: shape matrixTensor
        matrixData: matrixTensor\data
        matrixStrides: matrixTensor\strides
        assert -> [] = scalarShape
        assert -> [3] = vectorShape
        assert -> [2 2] = matrixShape
        assert -> [1.0 2.0 3.0 4.0] = matrixData
        assert -> [2 1] = matrixStrides
    ]

    test "creates filled tensors" [
        z: tensor.zeros [2 2]
        o: tensor.ones [3]
        r: tensor.random [2]
        zData: z\data
        oData: o\data
        rShape: shape r
        randomValue: r\data\0
        randomLowerBound: 0.0 - 0.1000001
        randomAboveLower?: randomValue >= randomLowerBound
        randomBelowUpper?: randomValue =< 0.1000001
        randomInRange?: and? [randomAboveLower?][randomBelowUpper?]
        assert -> [0.0 0.0 0.0 0.0] = zData
        assert -> [1.0 1.0 1.0] = oData
        assert -> [2] = rShape
        assert -> randomInRange?
    ]

    test "broadcasts vectors and scalars over matrices" [
        a: tensor [[1 2] [3 4]]
        b: tensor [10 20]
        shifted: a + b
        result: shifted * 2.0
        actual: result\data
        assert -> [22.0 44.0 26.0 48.0] = actual
    ]

    test "supports arithmetic, reshape, transpose, and reductions" [
        a: tensor [2 4]
        divided: a / 2.0
        powered: a ^ 2.0
        negative: neg a
        dividedData: divided\data
        poweredData: powered\data
        negativeData: negative\data
        minusTwo: 0.0 - 2.0
        minusFour: 0.0 - 4.0
        expectedNegativeTensor: tensor @[minusTwo minusFour]
        expectedNegative: expectedNegativeTensor\data
        assert -> [1.0 2.0] = dividedData
        assert -> [4.0 16.0] = poweredData
        assert -> expectedNegative = negativeData
        m: reshape a [2 1]
        mt: transpose m
        mtShape: shape mt
        total: tensorSum a
        averageValue: mean a
        totalValue: total\data\0
        meanValue: averageValue\data\0
        assert -> [1 2] = mtShape
        assert -> 6.0 = totalValue
        assert -> 3.0 = meanValue
    ]

    test "multiplies matrices" [
        a: tensor [[1 2] [3 4]]
        b: tensor [[5] [6]]
        result: matmul a b
        resultShape: shape result
        resultData: result\data
        assert -> [2 1] = resultShape
        assert -> [17.0 39.0] = resultData
    ]

    test "rejects malformed and incompatible tensors" [
        malformed?: throws? [tensor [[1] [2 3]]]
        broadcastMismatch?: throws? [(tensor [1 2]) + (tensor [1 2 3])]
        matmulRanks?: throws? [matmul (tensor [1 2]) (tensor [1 2])]
        assert -> malformed?
        assert -> broadcastMismatch?
        assert -> matmulRanks?
    ]

    test "infers arbitrary-rank rectangular shapes" [
        value: tensor [[[1 2] [3 4]] [[5 6] [7 8]]]
        nestedEmpty: tensor [[[]] [[]]]
        valueShape: shape value
        valueStrides: value\strides
        emptyShape: shape nestedEmpty
        assert -> [2 2 2] = valueShape
        assert -> [4 2 1] = valueStrides
        assert -> [2 1 0] = emptyShape
    ]

    test "broadcasts across arbitrary trailing dimensions" [
        leftData: tensor [1 2 3 4 5 6]
        rightData: tensor [10 11 12 13]
        left: reshape leftData [2 1 3]
        right: reshape rightData [1 4 1]
        result: left + right
        resultShape: shape result
        resultData: result\data
        assert -> [2 4 3] = resultShape
        assert -> [11.0 12.0 13.0 12.0 13.0 14.0 13.0 14.0 15.0 14.0 15.0 16.0 14.0 15.0 16.0 15.0 16.0 17.0 16.0 17.0 18.0 17.0 18.0 19.0] = resultData
        emptyVector: tensor.zeros [0]
        singleton: tensor.ones [1]
        emptyResult: emptyVector + singleton
        assert -> [0] = shape emptyResult
    ]

    test "reduces explicit axes and permutes axes" [
        value: tensor [[[1 2] [3 4]] [[5 6] [7 8]]]
        summed: tensorSum.axis: 1 value
        lastAxis: 0 - 1
        averaged: mean.axis: lastAxis value
        permuted: transpose.axes: [2 0 1] value
        assert -> [2 2] = shape summed
        assert -> [4.0 6.0 12.0 14.0] = summed\data
        assert -> [1.5 3.5 5.5 7.5] = averaged\data
        assert -> [2 2 2] = shape permuted
        assert -> [1.0 3.0 5.0 7.0 2.0 4.0 6.0 8.0] = permuted\data
    ]

    test "indexes by coordinate without exposing a view" [
        source: tensor [[[1 2] [3 4]] [[5 6] [7 8]]]
        lastIndex: 0 - 1
        picked: tensorAt source @[1 0 lastIndex]
        set picked\data 0 99.0
        original: tensorAt source [1 0 1]
        assert -> [] = shape picked
        assert -> 99.0 = picked\data\0
        assert -> 6.0 = original\data\0
    ]

    test "validates generalized axes, indices, and shapes" [
        value: tensor.zeros [2 3 4]
        ragged?: throws? [tensor [[[1] [2 3]]]]
        axis?: throws? [tensorSum.axis: 3 value]
        index?: throws? [tensorAt value [0 3 0]]
        permutation?: throws? [transpose.axes: [0 0 1] value]
        assert -> ragged?
        assert -> axis?
        assert -> index?
        assert -> permutation?
    ]
]
