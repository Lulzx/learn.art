import relative {../src/learn}!

do [
    xTrain: tensor [0.0 1.0 2.0 3.0]
    yTrain: tensor [1.0 3.0 5.0 7.0]

    model: graph [
        x: input
        y: input
        w: parameter 0.0
        b: parameter 0.0
        linear: x * w
        prediction: linear + b
        residual: prediction - y
        squared: square residual
        loss: mean squared
    ]

    optimizer: sgd.rate: 0.05 (parameters model)

    do.times: 500 [
        zeroGrad model
        forward.with: #[x: xTrain y: yTrain] model
        backward model\loss
        step optimizer
    ]

    print model\w
    print model\b
]
