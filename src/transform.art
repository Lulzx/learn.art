; Graph analysis and transformations over the ordinary-data representation.

import relative {./model}!

validateGraphData: function [data][
    unless dictionary? data -> panic "learn: graph data must be a dictionary"
    unless and? [key? data 'format][data\format = "learn.graph"] -> panic "learn: unsupported graph data format"
    loop ['order 'nodes 'inputs 'parameters] 'required [
        unless key? data required -> panic ~"learn: graph data is missing |required|"
    ]

    seen: lrFreshBlock
    loop data\order 'name [
        unless key? data\nodes name -> panic ~"learn: graph order references missing node |name|"
        node: data\nodes\[name]
        unless dictionary? node -> panic ~"learn: graph node |name| must be a dictionary"
        if key? node 'parents [
            loop node\parents 'parent [
                if literal? parent [
                    unless contains? seen parent -> panic ~"learn: node |name| references unavailable parent |parent|"
                ]
            ]
        ]
        'seen ++ name
    ]
    return true
]

deadCodeEliminate: function [data outputName][
    validateGraphData data
    output: to :literal outputName
    unless key? data\nodes output -> panic ~"learn: graph has no output named |output|"

    reachable: lrFreshBlock
    pending: @[output]
    while [not? empty? pending][
        name: pop 'pending
        unless contains? reachable name [
            'reachable ++ name
            node: data\nodes\[name]
            if key? node 'parents [
                loop node\parents 'parent [if literal? parent -> 'pending ++ parent]
            ]
        ]
    ]

    nextOrder: select data\order 'name -> contains? reachable name
    nextNodes: lrFreshDictionary
    loop nextOrder 'name -> set nextNodes name data\nodes\[name]
    nextInputs: select data\inputs 'name -> contains? reachable name
    nextParameters: select data\parameters 'name -> contains? reachable name
    return #[
        format: data\format
        version: data\version
        inputs: nextInputs
        parameters: nextParameters
        order: nextOrder
        nodes: nextNodes
    ]
]

commonSubexpressions: function [data][
    validateGraphData data
    buckets: lrFreshDictionary
    loop data\order 'name [
        node: data\nodes\[name]
        if node\role = 'operation [
            context: null
            if key? node 'context -> context: node\context
            device: 'cpu
            if key? node 'device -> device: node\device
            signature: to :string @[node\operation node\shape device node\parents context]
            names: lrFreshBlock
            if key? buckets signature -> names: new buckets\[signature]
            'names ++ name
            set buckets signature names
        ]
    ]
    groups: lrFreshBlock
    loop values buckets 'names [if (size names) > 1 -> 'groups ++ @[names]]
    return groups
]

lrTensorFromRecord: function [record][
    unless and? [dictionary? record][and? [key? record 'shape][key? record 'data]] ->
        panic "learn: malformed tensor record in graph data"
    device: 'cpu
    if key? record 'device -> device: record\device
    return lrMakeTensorOn record\shape record\data device
]

lrParentValue: function [environment parent][
    if literal? parent [
        unless key? environment parent -> panic ~"learn: scheduled parent |parent| has no value"
        return environment\[parent]
    ]
    unless dictionary? parent -> panic "learn: malformed inline graph constant"
    unless and? [key? parent 'role][parent\role = 'constant] -> panic "learn: unsupported inline graph parent"
    return lrTensorFromRecord parent\value
]

lrExecuteDataNode: function [node parentValues][
    operation: node\operation
    if operation = 'alias -> return parentValues\0
    if operation = 'neg -> return lrTensorUnary parentValues\0 'neg
    if operation = 'exp -> return lrTensorUnary parentValues\0 'exp
    if operation = 'log -> return lrTensorUnary parentValues\0 'log
    if operation = 'abs -> return lrTensorUnary parentValues\0 'abs
    if operation = 'sigmoid -> return lrTensorUnary parentValues\0 'sigmoid
    if operation = 'relu -> return lrTensorUnary parentValues\0 'relu
    if operation = 'tanh -> return lrTensorUnary parentValues\0 'tanh
    if operation = 'softmax -> return lrTensorSoftmax parentValues\0
    if operation = 'crossEntropy -> return lrTensorCrossEntropy parentValues\0 parentValues\1
    if operation = 'dropout -> return lrDropoutTensor parentValues\0 node\context
    if operation = 'dense [
        linear: matmul parentValues\0 parentValues\1
        return lrTensorBinary linear parentValues\2 'add
    ]
    if operation = 'conv2d -> return lrTensorConv2d parentValues\0 parentValues\1 node\context\stride node\context\padding
    if operation = 'maxPool2d -> return lrTensorPool2d parentValues\0 node\context\kernel node\context\stride node\context\padding 'max
    if operation = 'avgPool2d -> return lrTensorPool2d parentValues\0 node\context\kernel node\context\stride node\context\padding 'average
    if operation = 'add -> return lrTensorBinary parentValues\0 parentValues\1 'add
    if operation = 'sub -> return lrTensorBinary parentValues\0 parentValues\1 'sub
    if operation = 'mul -> return lrTensorBinary parentValues\0 parentValues\1 'mul
    if operation = 'div -> return lrTensorBinary parentValues\0 parentValues\1 'div
    if operation = 'pow -> return lrTensorBinary parentValues\0 parentValues\1 'pow
    if operation = 'sum -> return tensorSum parentValues\0
    if operation = 'mean -> return mean parentValues\0
    if operation = 'sumAxis [
        axis: node\context\axis
        source: parentValues\0
        return tensorSum.axis: axis source
    ]
    if operation = 'meanAxis [
        axis: node\context\axis
        source: parentValues\0
        return mean.axis: axis source
    ]
    if operation = 'reshape -> return reshape parentValues\0 node\shape
    if operation = 'transpose [
        axes: node\context\axes
        source: parentValues\0
        return transpose.axes: axes source
    ]
    if operation = 'index [
        source: parentValues\0
        indices: node\context\indices
        return tensorAt source indices
    ]
    if operation = 'transfer [
        source: parentValues\0
        device: node\context\device
        return lrTensorTransfer source device
    ]
    if operation = 'matmul -> return matmul parentValues\0 parentValues\1
    panic ~"learn: CPU backend does not support operation |operation|"
]

lrNodeWithParents: function [node nextParents][
    context: null
    if key? node 'context -> context: node\context
    device: 'cpu
    if key? node 'device -> device: node\device
    return #[
        role: node\role
        operation: node\operation
        shape: new node\shape
        device: device
        parents: nextParents
        context: context
        value: node\value
    ]
]

lrGraphDataWithNodes: function [data nextOrder nextNodes nextInputs nextParameters][
    return #[
        format: data\format
        version: data\version
        inputs: nextInputs
        parameters: nextParameters
        order: nextOrder
        nodes: nextNodes
    ]
]

constantFold: function [data][
    validateGraphData data
    constants: lrFreshDictionary
    nextNodes: lrFreshDictionary

    loop data\order 'name [
        node: data\nodes\[name]
        nextNode: node
        if node\role = 'constant [
            constantValue: lrTensorFromRecord node\value
            set constants name constantValue
        ]
        if node\role = 'operation [
            foldable: true
            parentValues: lrFreshBlock
            loop node\parents 'parent [
                if literal? parent [
                    if key? constants parent -> 'parentValues ++ @[constants\[parent]]
                    unless key? constants parent -> foldable: false
                ]
                unless literal? parent -> 'parentValues ++ @[lrParentValue constants parent]
            ]
            if foldable [
                foldedValue: lrExecuteDataNode node parentValues
                nextNode: #[
                    role: 'constant
                    operation: 'constant
                    shape: new foldedValue\shape
                    device: foldedValue\device
                    parents: lrFreshBlock
                    context: null
                    value: lrTensorData foldedValue
                ]
                set constants name foldedValue
            ]
        ]
        set nextNodes name nextNode
    ]
    return lrGraphDataWithNodes data (new data\order) nextNodes (new data\inputs) (new data\parameters)
]

eliminateCommonSubexpressions: function [data][
    validateGraphData data
    signatures: lrFreshDictionary
    aliases: lrFreshDictionary
    nextNodes: lrFreshDictionary

    loop data\order 'name [
        node: data\nodes\[name]
        nextParents: lrFreshBlock
        loop node\parents 'parent [
            canonicalParent: parent
            if and? [literal? parent][key? aliases parent] -> canonicalParent: aliases\[parent]
            'nextParents ++ @[canonicalParent]
        ]
        nextNode: lrNodeWithParents node nextParents

        if node\role = 'operation [
            context: null
            if key? node 'context -> context: node\context
            device: 'cpu
            if key? node 'device -> device: node\device
            signature: to :string @[node\operation node\shape device nextParents context]
            if key? signatures signature [
                canonical: signatures\[signature]
                set aliases name canonical
                nextNode: #[
                    role: 'alias
                    operation: 'alias
                    shape: new node\shape
                    device: device
                    parents: @[canonical]
                    context: null
                    value: null
                ]
            ]
            unless key? signatures signature -> set signatures signature name
        ]
        set nextNodes name nextNode
    ]
    return lrGraphDataWithNodes data (new data\order) nextNodes (new data\inputs) (new data\parameters)
]

optimizeGraph: function [data outputName][
    pruned: deadCodeEliminate data outputName
    folded: constantFold pruned
    deduplicated: eliminateCommonSubexpressions folded
    return deadCodeEliminate deduplicated outputName
]

lrFusibleOperation?: function [operation][
    return contains? ['add 'sub 'mul 'div 'pow 'neg 'exp 'log 'sigmoid 'relu 'tanh 'alias] operation
]

fusionGroups: function [data][
    validateGraphData data
    groups: lrFreshBlock
    current: lrFreshBlock

    loop data\order 'name [
        node: data\nodes\[name]
        eligible: or? [node\role = 'alias][and? [node\role = 'operation][lrFusibleOperation? node\operation]]
        connected: empty? current
        unless empty? current [
            connected: false
            loop node\parents 'parent [
                if and? [literal? parent][contains? current parent] -> connected: true
            ]
        ]
        unless and? [eligible][connected] [
            unless empty? current -> 'groups ++ @[current]
            current: lrFreshBlock
        ]
        if eligible -> 'current ++ name
    ]
    unless empty? current -> 'groups ++ @[current]
    return groups
]

scheduleGraph: function [data outputName][
    optimized: optimizeGraph data outputName
    output: to :literal outputName
    groups: fusionGroups optimized
    grouped: lrFreshDictionary
    groupIndex: 0
    loop groups 'group [
        loop group 'name -> set grouped name groupIndex
        groupIndex: groupIndex + 1
    ]

    emittedGroups: lrFreshBlock
    steps: lrFreshBlock
    loop optimized\order 'name [
        node: optimized\nodes\[name]
        if key? grouped name [
            index: grouped\[name]
            unless contains? emittedGroups index [
                'steps ++ @[#[kind: 'fusion nodes: groups\[index]]]
                'emittedGroups ++ index
            ]
        ]
        unless key? grouped name [
            stepKind: (contains? ['input 'parameter 'constant] node\role)? -> 'load -> 'kernel
            'steps ++ @[#[kind: stepKind nodes: @[name]]]
        ]
    ]
    return #[
        format: "learn.schedule"
        version: "0.8"
        backend: 'cpu
        output: output
        graph: optimized
        fusionGroups: groups
        steps: steps
    ]
]

executeCpu: function [schedule][
    callAttrs: attrs
    unless and? [dictionary? schedule][schedule\format = "learn.schedule"] -> panic "learn: executeCpu expects a schedule"
    feeds: lrFreshDictionary
    if key? callAttrs 'with -> feeds: callAttrs\with
    unless dictionary? feeds -> panic "learn: executeCpu.with expects a dictionary"

    data: schedule\graph
    validateGraphData data
    loop keys feeds 'feedName [
        unless contains? data\inputs to :literal feedName -> panic ~"learn: CPU schedule has no input named |feedName|"
    ]
    environment: lrFreshDictionary
    loop schedule\steps 'scheduledStep [
        loop scheduledStep\nodes 'name [
            node: data\nodes\[name]
            value: null
            if node\role = 'input [
                unless key? feeds name -> panic ~"learn: CPU input |name| has not been provided"
                value: lrAsTensor feeds\[name]
                unless value\device = 'cpu -> panic ~"learn: CPU input |name| must be on cpu"
            ]
            if contains? ['parameter 'constant] node\role -> value: lrTensorFromRecord node\value
            if or? [node\role = 'operation][node\role = 'alias] [
                parentValues: lrFreshBlock
                loop node\parents 'parent [
                    parentValue: lrParentValue environment parent
                    'parentValues ++ @[parentValue]
                ]
                value: lrExecuteDataNode node parentValues
            ]
            if null? value -> panic ~"learn: CPU backend cannot load node |name|"
            set environment name value
        ]
    ]
    outputValue: environment\[schedule\output]
    if key? callAttrs 'all -> return #[value: outputValue values: environment schedule: schedule]
    return outputValue
]

lrTrainingNodeName: function [data prefix sourceName][
    candidate: to :literal ~"|prefix|_|sourceName|"
    if key? data\nodes candidate -> panic ~"learn: generated training node |candidate| already exists"
    return candidate
]

lrTrainingScalarNode: function [value][
    return #[
        role: 'constant
        operation: 'constant
        shape: lrFreshBlock
        device: 'cpu
        parents: lrFreshBlock
        context: null
        value: #[shape: lrFreshBlock device: 'cpu data: @[(to :floating value)]]
    ]
]

differentiateGraph: function [data outputName][
    optimized: optimizeGraph data outputName
    lossName: to :literal outputName
    lossShape: optimized\nodes\[lossName]\shape
    lossCount: lrCount lossShape
    unless lossCount = 1 -> panic "learn: differentiateGraph requires a scalar output"
    nextNodes: lrFreshDictionary
    loop optimized\order 'name -> set nextNodes name optimized\nodes\[name]
    nextOrder: new optimized\order
    gradientNames: lrFreshDictionary
    loop optimized\parameters 'parameterName [
        gradientName: lrTrainingNodeName optimized "lrGradient" parameterName
        parameterNode: optimized\nodes\[parameterName]
        gradientNode: #[
            role: 'operation
            operation: 'automaticGradient
            shape: new parameterNode\shape
            device: parameterNode\device
            parents: @[lossName parameterName]
            context: #[loss: lossName parameter: parameterName]
            value: null
        ]
        set nextNodes gradientName gradientNode
        'nextOrder ++ gradientName
        set gradientNames parameterName gradientName
    ]
    return #[
        format: "learn.graph"
        version: "0.26"
        inputs: new optimized\inputs
        parameters: new optimized\parameters
        order: nextOrder
        nodes: nextNodes
        differentiation: #[loss: lossName gradients: gradientNames]
    ]
]

lrOptimizerGraphDescriptor: function [optimizer][
    if is? :learnSgd optimizer -> return #[kind: 'sgd rate: optimizer\rate beta: 0.0]
    if is? :learnMomentum optimizer -> return #[kind: 'momentum rate: optimizer\rate beta: optimizer\beta]
    panic "learn: compiled optimizerGraph currently supports SGD and momentum"
]

lrOptimizerGraphFromDescriptor: function [differentiated descriptor][
    validateGraphData differentiated
    unless key? differentiated 'differentiation -> panic "learn: optimizerGraph expects differentiated graph data"
    nextNodes: lrFreshDictionary
    loop differentiated\order 'name -> set nextNodes name differentiated\nodes\[name]
    nextOrder: new differentiated\order
    rateName: lrTrainingNodeName differentiated "lrOptimizer" "rate"
    set nextNodes rateName lrTrainingScalarNode descriptor\rate
    'nextOrder ++ rateName
    betaName: null
    if descriptor\kind = 'momentum [
        betaName: lrTrainingNodeName differentiated "lrOptimizer" "beta"
        set nextNodes betaName lrTrainingScalarNode descriptor\beta
        'nextOrder ++ betaName
    ]

    parameterUpdates: lrFreshDictionary
    optimizerUpdates: lrFreshDictionary
    optimizerNames: lrFreshBlock
    loop differentiated\parameters 'parameterName [
        gradientName: differentiated\differentiation\gradients\[parameterName]
        updateSource: gradientName
        if descriptor\kind = 'momentum [
            velocityName: lrTrainingNodeName differentiated "lrVelocity" parameterName
            parameterNode: differentiated\nodes\[parameterName]
            zeros: map parameterNode\value\data 'unused -> 0.0
            velocityNode: #[role: 'optimizer operation: 'optimizer shape: new parameterNode\shape device: parameterNode\device parents: lrFreshBlock context: #[parameter: parameterName] value: #[shape: new parameterNode\shape device: parameterNode\device data: zeros]]
            set nextNodes velocityName velocityNode
            'nextOrder ++ velocityName
            retainedName: lrTrainingNodeName differentiated "lrRetainedVelocity" parameterName
            retainedNode: #[role: 'operation operation: 'mul shape: new parameterNode\shape device: parameterNode\device parents: @[betaName velocityName] context: null value: null]
            set nextNodes retainedName retainedNode
            'nextOrder ++ retainedName
            velocityUpdateName: lrTrainingNodeName differentiated "lrVelocityUpdate" parameterName
            velocityUpdateNode: #[role: 'operation operation: 'add shape: new parameterNode\shape device: parameterNode\device parents: @[retainedName gradientName] context: null value: null]
            set nextNodes velocityUpdateName velocityUpdateNode
            'nextOrder ++ velocityUpdateName
            set optimizerUpdates velocityName velocityUpdateName
            'optimizerNames ++ velocityName
            updateSource: velocityUpdateName
        ]
        parameterNode: differentiated\nodes\[parameterName]
        scaledName: lrTrainingNodeName differentiated "lrScaledUpdate" parameterName
        scaledNode: #[role: 'operation operation: 'mul shape: new parameterNode\shape device: parameterNode\device parents: @[rateName updateSource] context: null value: null]
        set nextNodes scaledName scaledNode
        'nextOrder ++ scaledName
        nextName: lrTrainingNodeName differentiated "lrParameterUpdate" parameterName
        nextNode: #[role: 'operation operation: 'sub shape: new parameterNode\shape device: parameterNode\device parents: @[parameterName scaledName] context: null value: null]
        set nextNodes nextName nextNode
        'nextOrder ++ nextName
        set parameterUpdates parameterName nextName
    ]
    return #[
        format: "learn.graph"
        version: "0.26"
        inputs: new differentiated\inputs
        parameters: new differentiated\parameters
        order: nextOrder
        nodes: nextNodes
        differentiation: differentiated\differentiation
        training: #[optimizer: descriptor parameterUpdates: parameterUpdates optimizerUpdates: optimizerUpdates optimizerNames: optimizerNames]
    ]
]

optimizerGraph: function [differentiated optimizer][
    descriptor: lrOptimizerGraphDescriptor optimizer
    return lrOptimizerGraphFromDescriptor differentiated descriptor
]

graphDot: function [source][
    data: (is? :learnGraph source)? -> graphData source -> source
    validateGraphData data
    lines: @["digraph learn {"]
    loop data\order 'name [
        node: data\nodes\[name]
        label: ~"|name|\\n|node\role|: |node\operation|"
        'lines ++ ~"  \"|name|\" [label=\"|label|\"] ;"
        if key? node 'parents [
            loop node\parents 'parent [
                if literal? parent -> 'lines ++ ~"  \"|parent|\" -> \"|name|\" ;"
            ]
        ]
    ]
    'lines ++ "}"
    return join.with: "\n" lines
]
