; Dense, owned, row-major tensors of arbitrary rank.

lrFreshDictionary: function [][
    ; Empty literals are reused by Arturo 0.10. A dynamically allocated block
    ; prevents mutable state from leaking between calls.
    return to :dictionary array 0
]

lrFreshBlock: function [][
    return remove (array 0) 0
]

lrArgs: function [count][
    result: lrFreshBlock
    if count > 0 [loop 1..count 'unused -> 'result ++ null]
    return result
]

define :learnTensor [
    init: constructor [shape strides data device]

    add: method [that][(is? :learnValue that)? -> lrValueBinary this that 'add -> lrTensorBinary this that 'add]
    sub: method [that][(is? :learnValue that)? -> lrValueBinary this that 'sub -> lrTensorBinary this that 'sub]
    mul: method [that][(is? :learnValue that)? -> lrValueBinary this that 'mul -> lrTensorBinary this that 'mul]
    div: method [that][(is? :learnValue that)? -> lrValueBinary this that 'div -> lrTensorBinary this that 'div]
    pow: method [that][(is? :learnValue that)? -> lrValueBinary this that 'pow -> lrTensorBinary this that 'pow]
    neg: method [][lrTensorUnary this 'neg]

    string: method [][lrTensorString this]
]

lrNumeric?: function [value][
    return or? [integer? value][floating? value]
]

lrFloat: function [value][
    unless lrNumeric? value -> panic ~"learn: tensor values must be numeric, got |type value|"
    return to :floating value
]

lrRandomSmall: function [][
    return (random 0.0 0.2) - 0.1
]

lrCount: function [dims][
    if empty? dims -> return 1
    count: 1
    loop dims 'dim -> count: count * dim
    return count
]

lrStrides: function [dims][
    result: lrFreshBlock
    running: 1
    loop reverse dims 'dim [
        'result ++ running
        running: running * dim
    ]
    return reverse result
]

lrValidateShape: function [dims][
    unless block? dims -> panic "learn: a tensor shape must be a block"
    loop dims 'dim [
        unless integer? dim -> panic "learn: tensor dimensions must be integers"
        if dim < 0 -> panic "learn: tensor dimensions cannot be negative"
    ]
    return dims
]

lrNormalizeDevice: function [requested][
    device: requested
    if string? device -> device: to :literal device
    unless literal? device -> panic "learn: a tensor device must be a literal or string"
    unless device = 'cpu -> panic ~"learn: device |device| is not available"
    return device
]

availableDevices: function [][
    return new ['cpu]
]

lrInferShape: function [source][
    if lrNumeric? source -> return lrFreshBlock
    unless block? source -> panic ~"learn: tensor values must be numeric or nested blocks, got |type source|"
    if empty? source -> return [0]

    childShape: lrInferShape first source
    loop source 'item [
        itemShape: lrInferShape item
        unless itemShape = childShape -> panic "learn: tensor blocks must have a rectangular shape"
    ]
    result: @[(size source)]
    loop childShape 'dim -> 'result ++ dim
    return result
]

lrFlattenTensorData: function [source output][
    if lrNumeric? source [
        'output ++ lrFloat source
        return null
    ]
    loop source 'item -> lrFlattenTensorData item output
    return null
]

lrMakeTensor: function [dims data][
    return lrMakeTensorOn dims data 'cpu
]

lrMakeTensorOn: function [dims data requestedDevice][
    lrValidateShape dims
    device: lrNormalizeDevice requestedDevice
    unless (lrCount dims) = (size data) ->
        panic ~"learn: shape |dims| requires |lrCount dims| values, got |size data|"

    floats: lrFreshBlock
    loop data 'item -> 'floats ++ lrFloat item
    args: lrArgs 4
    set args 0 new dims
    set args 1 lrStrides dims
    set args 2 floats
    set args 3 device
    result: to :learnTensor args
    ; Arturo may intern structurally equal constructor arguments. Reinstall
    ; owned blocks so equal tensors never share mutable storage.
    set result 'shape new dims
    set result 'strides lrStrides dims
    set result 'data new floats
    set result 'device device
    return result
]

lrTensorFromData: function [source][
    if lrNumeric? source -> return lrMakeTensor [] @[source]
    unless block? source -> panic "learn: tensor expects a number or a block"
    dims: lrInferShape source
    flat: lrFreshBlock
    lrFlattenTensorData source flat
    return lrMakeTensor dims flat
]

tensor: function [source][
    callAttrs: attrs
    requestedDevice: 'cpu
    if key? callAttrs 'device -> requestedDevice: lrNormalizeDevice callAttrs\device
    makeZeros: key? callAttrs 'zeros
    makeOnes: key? callAttrs 'ones
    makeRandom: key? callAttrs 'random
    makeFilled: or? [makeZeros][or? [makeOnes][makeRandom]]

    if makeFilled [
        dims: lrValidateShape source
        data: lrFreshBlock
        count: lrCount dims
        if count > 0 [
            loop 1..count 'unused [
                value: 0.0
                if makeOnes -> value: 1.0
                if makeRandom -> value: lrRandomSmall
                'data ++ value
            ]
        ]
        return lrMakeTensorOn dims data requestedDevice
    ]
    result: lrTensorFromData source
    return lrMakeTensorOn result\shape result\data requestedDevice
]

lrAsTensor: function [value][
    if is? :learnTensor value -> return value
    if lrNumeric? value -> return lrTensorFromData value
    panic ~"learn: expected a tensor or number, got |type value|"
]

shape: function [value][
    if is? :learnTensor value -> return new value\shape
    if is? :learnValue value -> return new value\value\shape
    panic ~"learn: shape expects a tensor or differentiable value, got |type value|"
]

deviceOf: function [value][
    if is? :learnTensor value -> return value\device
    if is? :learnValue value -> return value\value\device
    panic ~"learn: deviceOf expects a tensor or differentiable value, got |type value|"
]

lrTensorTransfer: function [value requestedDevice][
    source: lrAsTensor value
    device: lrNormalizeDevice requestedDevice
    return lrMakeTensorOn source\shape source\data device
]

toDevice: function [value requestedDevice][
    if is? :learnValue value -> return lrValueTransfer value requestedDevice
    return lrTensorTransfer value requestedDevice
]

tensorBuffer: function [value][
    source: (is? :learnValue value)? -> value\value -> lrAsTensor value
    return #[
        format: "learn.buffer"
        version: "0.9"
        device: source\device
        dtype: 'float64
        count: size source\data
        data: new source\data
    ]
]

tensorFromBuffer: function [dims buffer][
    lrValidateShape dims
    unless dictionary? buffer -> panic "learn: tensorFromBuffer expects a buffer dictionary"
    unless and? [key? buffer 'format][buffer\format = "learn.buffer"] -> panic "learn: unsupported tensor buffer format"
    loop ['version 'device 'dtype 'count 'data] 'field [
        unless key? buffer field -> panic ~"learn: tensor buffer is missing |field|"
    ]
    unless buffer\version = "0.9" -> panic ~"learn: tensor buffer version |buffer\version| is unsupported"
    unless buffer\dtype = 'float64 -> panic ~"learn: tensor buffer dtype |buffer\dtype| is unsupported"
    unless block? buffer\data -> panic "learn: tensor buffer data must be a block"
    unless and? [integer? buffer\count][buffer\count >= 0] -> panic "learn: tensor buffer count must be a non-negative integer"
    unless buffer\count = (size buffer\data) -> panic "learn: tensor buffer count does not match its data"
    unless buffer\count = (lrCount dims) -> panic ~"learn: shape |dims| does not match buffer count |buffer\count|"
    return lrMakeTensorOn dims buffer\data buffer\device
]

lrBroadcastShape: function [left right][
    rank: max @[(size left) (size right)]
    result: lrFreshBlock
    if rank > 0 [loop 0..(rank - 1) 'axis [
        leftOffset: axis - (rank - (size left))
        rightOffset: axis - (rank - (size right))
        a: (leftOffset < 0)? -> 1 -> left\[leftOffset]
        b: (rightOffset < 0)? -> 1 -> right\[rightOffset]
        unless or? [a = b][or? [a = 1][b = 1]] ->
            panic ~"learn: cannot broadcast shapes |left| and |right|"
        outputDim: a
        if a = 1 -> outputDim: b
        if b = 1 -> outputDim: a
        'result ++ outputDim
    ]]
    return result
]

lrBroadcastIndex: function [dims outDims flatIndex][
    if empty? dims -> return 0
    outStrides: lrStrides outDims
    sourceStrides: lrStrides dims
    offset: (size outDims) - (size dims)
    sourceIndex: 0
    loop 0..((size dims) - 1) 'sourceAxis [
        outAxis: sourceAxis + offset
        coordinate: to :integer floor (flatIndex / outStrides\[outAxis])
        coordinate: coordinate % outDims\[outAxis]
        if dims\[sourceAxis] = 1 -> coordinate: 0
        sourceIndex: sourceIndex + (coordinate * sourceStrides\[sourceAxis])
    ]
    return sourceIndex
]

lrNormalizeAxis: function [axis rank][
    unless integer? axis -> panic "learn: tensor axis must be an integer"
    normalized: axis
    if normalized < 0 -> normalized: normalized + rank
    unless and? [normalized >= 0][normalized < rank] ->
        panic ~"learn: axis |axis| is out of bounds for rank |rank|"
    return normalized
]

lrCoordinates: function [dims flatIndex][
    strides: lrStrides dims
    result: lrFreshBlock
    if not? empty? dims [loop 0..((size dims) - 1) 'axis [
        coordinate: to :integer floor (flatIndex / strides\[axis])
        'result ++ (coordinate % dims\[axis])
    ]]
    return result
]

lrFlatIndex: function [dims coordinates][
    unless (size dims) = (size coordinates) ->
        panic ~"learn: expected |size dims| indices, got |size coordinates|"
    strides: lrStrides dims
    result: 0
    if not? empty? dims [loop 0..((size dims) - 1) 'axis [
        coordinate: coordinates\[axis]
        unless integer? coordinate -> panic "learn: tensor indices must be integers"
        if coordinate < 0 -> coordinate: coordinate + dims\[axis]
        unless and? [coordinate >= 0][coordinate < dims\[axis]] ->
            panic ~"learn: index |coordinates\[axis]| is out of bounds for axis |axis| of size |dims\[axis]|"
        result: result + (coordinate * strides\[axis])
    ]]
    return result
]

tensorAt: function [value indices][
    if is? :learnValue value -> return lrValueAt value indices
    source: lrAsTensor value
    coordinates: indices
    if and? [integer? indices][(size source\shape) = 1] -> coordinates: @[indices]
    unless block? coordinates -> panic "learn: tensorAt expects an index block"
    offset: lrFlatIndex source\shape coordinates
    return lrMakeTensorOn [] @[source\data\[offset]] source\device
]

lrTensorBinary: function [left right operation][
    a: lrAsTensor left
    b: lrAsTensor right
    unless a\device = b\device -> panic ~"learn: tensor devices |a\device| and |b\device| do not match"
    dims: lrBroadcastShape a\shape b\shape
    data: lrFreshBlock
    count: lrCount dims

    if count > 0 [
        loop 0..(count - 1) 'i [
            av: a\data\[lrBroadcastIndex a\shape dims i]
            bv: b\data\[lrBroadcastIndex b\shape dims i]
            value: null
            if operation = 'add -> value: av + bv
            if operation = 'sub -> value: av - bv
            if operation = 'mul -> value: av * bv
            if operation = 'div -> value: av / bv
            if operation = 'pow -> value: av ^ bv
            if null? value -> panic ~"learn: unknown tensor operation |operation|"
            'data ++ value
        ]
    ]
    return lrMakeTensorOn dims data a\device
]

lrTensorUnary: function [value operation][
    source: lrAsTensor value
    data: lrFreshBlock
    loop source\data 'item [
        result: null
        if operation = 'neg -> result: 0.0 - item
        if operation = 'exp -> result: exp item
        if operation = 'log -> result: ln item
        if operation = 'abs -> result: abs item
        if operation = 'relu -> result: (item > 0.0)? -> item -> 0.0
        if operation = 'tanh [
            twice: 2.0 * item
            result: (2.0 / (1.0 + exp (0.0 - twice))) - 1.0
        ]
        if operation = 'sigmoid [
            if item >= 0.0 [
                negativeItem: 0.0 - item
                result: 1.0 / (1.0 + exp negativeItem)
            ]
            if item < 0.0 [
                positiveExp: exp item
                result: positiveExp / (1.0 + positiveExp)
            ]
        ]
        if null? result -> panic ~"learn: unknown unary tensor operation |operation|"
        'data ++ result
    ]
    return lrMakeTensorOn source\shape data source\device
]

lrSoftmaxSpec: function [source][
    rank: size source\shape
    classes: (rank = 0)? -> 1 -> last source\shape
    unless classes > 0 -> panic "learn: softmax requires a non-empty class axis"
    groups: (size source\data) / classes
    return @[to :integer groups classes]
]

lrTensorSoftmax: function [value][
    source: lrAsTensor value
    spec: lrSoftmaxSpec source
    groups: spec\0
    classes: spec\1
    output: lrFreshBlock
    if groups > 0 [loop 0..(groups - 1) 'groupIndex [
        offset: groupIndex * classes
        maximum: source\data\[offset]
        if classes > 1 [loop 1..(classes - 1) 'classIndex -> maximum: max @[maximum source\data\[offset + classIndex]]]
        denominator: 0.0
        exponentials: lrFreshBlock
        loop 0..(classes - 1) 'classIndex [
            shifted: source\data\[offset + classIndex] - maximum
            item: exp shifted
            'exponentials ++ item
            denominator: denominator + item
        ]
        loop exponentials 'item -> 'output ++ item / denominator
    ]]
    return lrMakeTensorOn source\shape output source\device
]

lrClassIndex: function [value classes][
    unless lrNumeric? value -> panic "learn: class targets must be numeric indices"
    classIndex: to :integer value
    unless (to :floating classIndex) = (to :floating value) -> panic "learn: class targets must be integer indices"
    unless and? [classIndex >= 0][classIndex < classes] -> panic ~"learn: class target |classIndex| is out of bounds"
    return classIndex
]

lrCrossEntropySpec: function [logits targets][
    rank: size logits\shape
    unless rank =< 2 -> panic "learn: crossEntropy supports a class vector or sample-by-class matrix"
    unless (size targets\shape) =< 1 -> panic "learn: crossEntropy targets must be a scalar or vector"
    softmaxSpec: lrSoftmaxSpec logits
    samples: softmaxSpec\0
    classes: softmaxSpec\1
    unless (size targets\data) = samples -> panic "learn: crossEntropy requires one class target per sample"
    return @[samples classes]
]

lrTensorCrossEntropy: function [logitsValue targetsValue][
    logits: lrAsTensor logitsValue
    targets: lrAsTensor targetsValue
    unless logits\device = targets\device -> panic "learn: crossEntropy operands must be on the same device"
    spec: lrCrossEntropySpec logits targets
    samples: spec\0
    classes: spec\1
    unless samples > 0 -> panic "learn: crossEntropy is undefined for an empty batch"
    total: 0.0
    loop 0..(samples - 1) 'sampleIndex [
        offset: sampleIndex * classes
        maximum: logits\data\[offset]
        if classes > 1 [loop 1..(classes - 1) 'classIndex -> maximum: max @[maximum logits\data\[offset + classIndex]]]
        exponentialSum: 0.0
        loop 0..(classes - 1) 'classIndex -> exponentialSum: exponentialSum + exp (logits\data\[offset + classIndex] - maximum)
        targetIndex: lrClassIndex targets\data\[sampleIndex] classes
        logNormalizer: maximum + ln exponentialSum
        total: total + logNormalizer - logits\data\[offset + targetIndex]
    ]
    return lrMakeTensorOn [] @[total / samples] logits\device
]

reshape: function [value dims][
    if is? :learnValue value -> return lrValueReshape value dims
    source: lrAsTensor value
    lrValidateShape dims
    unless (lrCount dims) = (size source\data) ->
        panic ~"learn: cannot reshape |source\shape| to |dims|"
    return lrMakeTensorOn dims source\data source\device
]

lrTransposeAxes: function [dims requestedAxes][
    rank: size dims
    axes: lrFreshBlock
    if null? requestedAxes [
        if rank > 0 [loop 0..(rank - 1) 'axis -> 'axes ++ axis]
        if rank >= 2 [
            previous: axes\[rank - 2]
            set axes (rank - 2) axes\[rank - 1]
            set axes (rank - 1) previous
        ]
    ]
    unless null? requestedAxes -> axes: new requestedAxes
    unless (size axes) = rank -> panic ~"learn: transpose needs |rank| axes"
    loop axes 'axis [
        normalized: lrNormalizeAxis axis rank
        unless normalized = axis -> panic "learn: transpose axes must use non-negative indices"
        occurrences: size (select axes 'candidate -> candidate = axis)
        unless occurrences = 1 ->
            panic "learn: transpose axes must be a permutation"
    ]
    return axes
]

transpose: function [value][
    callAttrs: attrs
    requestedAxes: null
    if key? callAttrs 'axes -> requestedAxes: callAttrs\axes
    if is? :learnValue value -> return lrValueTranspose value requestedAxes
    source: lrAsTensor value
    rank: size source\shape
    axes: lrTransposeAxes source\shape requestedAxes

    outputShape: lrFreshBlock
    loop axes 'axis -> 'outputShape ++ source\shape\[axis]
    data: lrFreshBlock
    count: lrCount outputShape
    if count > 0 [
        loop 0..(count - 1) 'outputIndex [
            outputCoordinates: lrCoordinates outputShape outputIndex
            sourceCoordinates: lrArgs rank
            if rank > 0 [
                loop 0..(rank - 1) 'outputAxis [
                    sourceAxis: axes\[outputAxis]
                    coordinate: outputCoordinates\[outputAxis]
                    set sourceCoordinates sourceAxis coordinate
                ]
            ]
            sourceIndex: lrFlatIndex source\shape sourceCoordinates
            'data ++ source\data\[sourceIndex]
        ]
    ]
    return lrMakeTensorOn outputShape data source\device
]

tensorSum: function [value][
    requestedAxis: attr 'axis
    if is? :learnValue value -> return lrValueReduce value 'sum requestedAxis
    source: lrAsTensor value
    unless null? requestedAxis -> return lrTensorReduceAxis source requestedAxis 'sum
    total: 0.0
    loop source\data 'item -> total: total + item
    return lrMakeTensorOn [] @[total] source\device
]

mean: function [value][
    requestedAxis: attr 'axis
    if is? :learnValue value -> return lrValueReduce value 'mean requestedAxis
    source: lrAsTensor value
    unless null? requestedAxis -> return lrTensorReduceAxis source requestedAxis 'mean
    if empty? source\data -> panic "learn: mean is undefined for an empty tensor"
    total: 0.0
    loop source\data 'item -> total: total + item
    return lrMakeTensorOn [] @[total / size source\data] source\device
]

lrTensorReduceAxis: function [source requestedAxis operation][
    rank: size source\shape
    axis: lrNormalizeAxis requestedAxis rank
    if and? [operation = 'mean][source\shape\[axis] = 0] ->
        panic "learn: mean is undefined over an empty axis"
    outputShape: lrFreshBlock
    if rank > 1 [loop 0..(rank - 1) 'candidate [
        unless candidate = axis -> 'outputShape ++ source\shape\[candidate]
    ]]
    outputData: lrFreshBlock
    outputCount: lrCount outputShape
    if outputCount > 0 [loop 1..outputCount 'unused -> 'outputData ++ 0.0]
    if not? empty? source\data [loop 0..((size source\data) - 1) 'inputIndex [
        coordinates: lrCoordinates source\shape inputIndex
        outputCoordinates: lrFreshBlock
        loop 0..(rank - 1) 'candidate [
            unless candidate = axis -> 'outputCoordinates ++ coordinates\[candidate]
        ]
        outputIndex: lrFlatIndex outputShape outputCoordinates
        set outputData outputIndex (outputData\[outputIndex] + source\data\[inputIndex])
    ]]
    if operation = 'mean [
        divisor: source\shape\[axis]
        outputData: map outputData 'item -> item / divisor
    ]
    return lrMakeTensorOn outputShape outputData source\device
]

square: function [value][
    return value ^ 2.0
]

sigmoid: function [value][
    if is? :learnValue value -> return lrValueUnary value 'sigmoid
    return lrTensorUnary value 'sigmoid
]

relu: function [value][
    if is? :learnValue value -> return lrValueUnary value 'relu
    return lrTensorUnary value 'relu
]

tensorTanh: function [value][
    if is? :learnValue value -> return lrValueUnary value 'tanh
    return lrTensorUnary value 'tanh
]

tensorExp: function [value][
    if is? :learnValue value -> return lrValueUnary value 'exp
    return lrTensorUnary value 'exp
]

tensorLog: function [value][
    if is? :learnValue value -> return lrValueUnary value 'log
    return lrTensorUnary value 'log
]

tensorAbs: function [value][
    if is? :learnValue value -> return lrValueUnary value 'abs
    return lrTensorUnary value 'abs
]

lrDropoutTensor: function [value context][
    source: lrAsTensor value
    unless context\training [
        context\mask: lrOnesLike source
        return lrMakeTensorOn source\shape source\data source\device
    ]
    context\pass: context\pass + 1
    state: context\seed + (context\pass * 104729) + 1
    scale: 1.0 / (1.0 - context\rate)
    maskData: lrFreshBlock
    loop source\data 'item [
        state: ((state * 1103515245) + 12345) % 2147483648
        fraction: (to :floating state) / 2147483648.0
        maskValue: (fraction >= context\rate)? -> scale -> 0.0
        'maskData ++ maskValue
    ]
    mask: lrMakeTensorOn source\shape maskData source\device
    context\mask: mask
    return lrTensorBinary source mask 'mul
]

dropout: function [value][
    callAttrs: attrs
    rate: 0.5
    seed: 0
    if key? callAttrs 'rate -> rate: callAttrs\rate
    if key? callAttrs 'seed -> seed: callAttrs\seed
    unless and? [lrNumeric? rate][and? [rate >= 0.0][rate < 1.0]] -> panic "learn: dropout rate must be in [0, 1)"
    unless and? [integer? seed][seed >= 0] -> panic "learn: dropout seed must be a non-negative integer"
    if is? :learnValue value -> return lrValueDropout value (to :floating rate) seed
    context: #[rate: to :floating rate seed: seed pass: 0 training: true mask: null]
    return lrDropoutTensor value context
]

lrValidatePenaltyParameters: function [parameterList label][
    unless and? [block? parameterList][not? empty? parameterList] -> panic ~"learn: |label| expects a non-empty parameter block"
    loop parameterList 'item [
        unless and? [is? :learnValue item][item\parameter] -> panic ~"learn: |label| expects parameter values"
    ]
    return parameterList
]

l1Penalty: function [parameterList][
    rate: attr 'rate
    if null? rate -> rate: 1.0
    unless and? [lrNumeric? rate][rate >= 0.0] -> panic "learn: l1Penalty rate must be non-negative"
    lrValidatePenaltyParameters parameterList "l1Penalty"
    total: tensorSum tensorAbs parameterList\0
    if (size parameterList) > 1 [loop 1..((size parameterList) - 1) 'itemIndex [
        itemPenalty: tensorSum tensorAbs parameterList\[itemIndex]
        total: total + itemPenalty
    ]]
    return total * rate
]

l2Penalty: function [parameterList][
    rate: attr 'rate
    if null? rate -> rate: 1.0
    unless and? [lrNumeric? rate][rate >= 0.0] -> panic "learn: l2Penalty rate must be non-negative"
    lrValidatePenaltyParameters parameterList "l2Penalty"
    total: tensorSum square parameterList\0
    if (size parameterList) > 1 [loop 1..((size parameterList) - 1) 'itemIndex [
        itemPenalty: tensorSum square parameterList\[itemIndex]
        total: total + itemPenalty
    ]]
    return total * rate
]

softmax: function [value][
    if is? :learnValue value -> return lrValueUnary value 'softmax
    return lrTensorSoftmax value
]

crossEntropy: function [logits targets][
    if or? [is? :learnValue logits][is? :learnValue targets] -> return lrValueCrossEntropy logits targets
    return lrTensorCrossEntropy logits targets
]

classPrediction: function [logitsValue][
    logits: (is? :learnValue logitsValue)? -> logitsValue\value -> lrAsTensor logitsValue
    spec: lrSoftmaxSpec logits
    groups: spec\0
    classes: spec\1
    predictions: lrFreshBlock
    if groups > 0 [loop 0..(groups - 1) 'groupIndex [
        offset: groupIndex * classes
        bestIndex: 0
        bestValue: logits\data\[offset]
        if classes > 1 [loop 1..(classes - 1) 'classIndex [
            candidate: logits\data\[offset + classIndex]
            if candidate > bestValue [bestValue: candidate bestIndex: classIndex]
        ]]
        'predictions ++ to :floating bestIndex
    ]]
    outputShape: lrLeadingShape logits\shape 1
    return lrMakeTensorOn outputShape predictions logits\device
]

multiclassAccuracy: function [actual predicted][
    targets: lrAsTensor actual
    classes: lrAsTensor predicted
    unless targets\shape = classes\shape -> panic "learn: multiclass accuracy values must have equal shape"
    if empty? targets\data -> panic "learn: multiclass accuracy is undefined for empty values"
    correct: 0
    loop 0..((size targets\data) - 1) 'itemIndex [
        expected: lrClassIndex targets\data\[itemIndex] 2147483647
        actualClass: lrClassIndex classes\data\[itemIndex] 2147483647
        if expected = actualClass -> correct: correct + 1
    ]
    return (to :floating correct) / size targets\data
]

binaryCrossEntropy: function [prediction target][
    p: lrAsValue prediction
    y: lrAsValue target
    one: lrOnesLike p\value
    epsilonValue: tensor 0.0000001
    safeP: p + epsilonValue
    oneMinusP: one - p
    safeOneMinusP: oneMinusP + epsilonValue
    logP: tensorLog safeP
    positive: y * logP
    oneMinusY: one - y
    logOneMinusP: tensorLog safeOneMinusP
    negative: oneMinusY * logOneMinusP
    combined: positive + negative
    negativeCombined: neg combined
    return mean negativeCombined
]

lrLeadingShape: function [dims trailingCount][
    result: lrFreshBlock
    leadingCount: (size dims) - trailingCount
    if leadingCount > 0 [loop 0..(leadingCount - 1) 'axis -> 'result ++ dims\[axis]]
    return result
]

lrMatmulSpec: function [leftShape rightShape][
    leftRank: size leftShape
    rightRank: size rightShape
    if leftRank < 1 -> panic "learn: matmul left operand must have rank at least 1"
    if rightRank < 1 -> panic "learn: matmul right operand must have rank at least 1"

    leftVector: leftRank = 1
    rightVector: rightRank = 1
    rows: 1
    unless leftVector -> rows: leftShape\[leftRank - 2]
    inner: leftShape\[leftRank - 1]
    rightInner: rightShape\0
    unless rightVector -> rightInner: rightShape\[rightRank - 2]
    cols: 1
    unless rightVector -> cols: rightShape\[rightRank - 1]
    unless inner = rightInner -> panic ~"learn: matmul shapes |leftShape| and |rightShape| are incompatible"

    leftBatch: lrFreshBlock
    unless leftVector -> leftBatch: lrLeadingShape leftShape 2
    rightBatch: lrFreshBlock
    unless rightVector -> rightBatch: lrLeadingShape rightShape 2
    batchShape: lrBroadcastShape leftBatch rightBatch
    outputShape: new batchShape
    unless leftVector -> 'outputShape ++ rows
    unless rightVector -> 'outputShape ++ cols
    return #[
        leftVector: leftVector
        rightVector: rightVector
        rows: rows
        inner: inner
        cols: cols
        leftBatch: leftBatch
        rightBatch: rightBatch
        batchShape: batchShape
        outputShape: outputShape
    ]
]

lrMatmulIndices: function [spec batchIndex row col k][
    leftBatchIndex: lrBroadcastIndex spec\leftBatch spec\batchShape batchIndex
    rightBatchIndex: lrBroadcastIndex spec\rightBatch spec\batchShape batchIndex
    leftMatrixSize: spec\rows * spec\inner
    rightMatrixSize: spec\inner * spec\cols
    leftIndex: (leftBatchIndex * leftMatrixSize) + (row * spec\inner) + k
    rightIndex: (rightBatchIndex * rightMatrixSize) + (k * spec\cols) + col
    outputIndex: (batchIndex * spec\rows * spec\cols) + (row * spec\cols) + col
    return @[leftIndex rightIndex outputIndex]
]

matmul: function [left right][
    if or? [is? :learnValue left][is? :learnValue right] ->
        return lrValueMatmul left right

    a: lrAsTensor left
    b: lrAsTensor right
    unless a\device = b\device -> panic ~"learn: tensor devices |a\device| and |b\device| do not match"
    spec: lrMatmulSpec a\shape b\shape
    data: lrFreshBlock
    batchCount: lrCount spec\batchShape
    if and? [batchCount > 0][and? [spec\rows > 0][spec\cols > 0]] [
        loop 0..(batchCount - 1) 'batchIndex [
            loop 0..(spec\rows - 1) 'row [
                loop 0..(spec\cols - 1) 'col [
                    total: 0.0
                    if spec\inner > 0 [loop 0..(spec\inner - 1) 'k [
                        indices: lrMatmulIndices spec batchIndex row col k
                        total: total + (a\data\[indices\0] * b\data\[indices\1])
                    ]]
                    'data ++ total
                ]
            ]
        ]
    ]
    return lrMakeTensorOn spec\outputShape data a\device
]

lrTensorString: function [value][
    dims: value\shape
    if empty? dims -> return to :string value\data\0
    if (size dims) = 1 -> return to :string value\data
    if (size dims) = 2 [
        rows: lrFreshBlock
        cols: dims\1
        if dims\0 > 0 [
            loop 0..(dims\0 - 1) 'row [
                rowValues: lrFreshBlock
                if cols > 0 [
                    loop 0..(cols - 1) 'col [
                        offset: (row * cols) + col
                        'rowValues ++ value\data\[offset]
                    ]
                ]
                'rows ++ @[rowValues]
            ]
        ]
        return to :string rows
    ]
    return ~"tensor(shape: |dims|, data: |value\data|)"
]
