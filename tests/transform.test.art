import'unitt!
import relative {../src/learn}!

suite "graph transformations" [
    test "validates, prunes, and finds repeated expressions" [
        model: graph [
            x: input
            w: parameter 2.0
            firstProduct: x * w
            repeatedProduct: x * w
            unused: square repeatedProduct
            loss: mean firstProduct
        ]
        data: graphData model
        valid?: validateGraphData data
        duplicates: commonSubexpressions data
        optimized: optimizeGraph data 'loss
        optimizedOrder: optimized\order
        assert -> valid?
        assert -> 1 = size duplicates
        assert -> contains? optimizedOrder 'firstProduct
        assert -> not? contains? optimizedOrder 'unused
        assert -> not? contains? optimizedOrder 'repeatedProduct
    ]

    test "exports graph data as DOT" [
        model: graph [
            x: input
            result: square x
        ]
        dot: graphDot model
        hasHeader?: contains? dot "digraph learn"
        hasEdge?: contains? dot "x\" -> \"result"
        assert -> hasHeader?
        assert -> hasEdge?
    ]

    test "rejects missing outputs" [
        model: graph [x: input result: square x]
        data: graphData model
        rejected?: throws? [deadCodeEliminate data 'missing]
        assert -> rejected?
    ]

    test "folds operations whose parents are constants" [
        nodes: lrFreshDictionary
        set nodes 'left #[role: 'constant operation: 'constant shape: [] parents: [] value: #[shape: [] data: [2.0]]]
        set nodes 'right #[role: 'constant operation: 'constant shape: [] parents: [] value: #[shape: [] data: [3.0]]]
        set nodes 'total #[role: 'operation operation: 'add shape: [] parents: ['left 'right] value: null]
        data: #[format: "learn.graph" version: "0.2" inputs: [] parameters: [] order: ['left 'right 'total] nodes: nodes]
        folded: constantFold data
        totalNode: folded\nodes\total
        foldedValue: totalNode\value\data\0
        assert -> 'constant = totalNode\role
        assert -> 5.0 = foldedValue
    ]

    test "preserves duplicate names with aliases" [
        model: graph [
            x: input
            w: parameter 2.0
            firstProduct: x * w
            repeatedProduct: x * w
            total: firstProduct + repeatedProduct
            loss: mean total
        ]
        data: graphData model
        deduplicated: eliminateCommonSubexpressions data
        aliasNode: deduplicated\nodes\repeatedProduct
        totalParents: deduplicated\nodes\total\parents
        assert -> 'alias = aliasNode\role
        assert -> ['firstProduct] = aliasNode\parents
        assert -> ['firstProduct 'firstProduct] = totalParents
    ]

    test "schedules fused work and executes it on CPU" [
        model: graph [
            x: input
            w: parameter 2.0
            firstProduct: x * w
            repeatedProduct: x * w
            total: firstProduct + repeatedProduct
            loss: mean total
        ]
        feed: #[x: tensor [1.0 2.0]]
        forward.with: feed model
        eagerLoss: model\loss\value\data\0
        data: graphData model
        schedule: scheduleGraph data 'loss
        cpuLoss: executeCpu.with: feed schedule
        fullResult: executeCpu.all.with: feed schedule
        cpuLossValue: cpuLoss\data\0
        intermediateValues: fullResult\values
        groups: schedule\fusionGroups
        steps: schedule\steps
        assert -> eagerLoss = cpuLossValue
        assert -> key? intermediateValues 'total
        assert -> 1 = size groups
        assert -> (size steps) >= 4
    ]

    test "executes matrix kernels and reports missing feeds" [
        xSeed: tensor.zeros [2 2]
        xNode: lrInputFrom xSeed
        model: graph [
            x: xNode
            w: parameter tensor [[2.0] [3.0]]
            product: matmul x w
            b: parameter tensor [1.0]
            prediction: product + b
        ]
        data: graphData model
        schedule: scheduleGraph data 'prediction
        feed: #[x: tensor [[1.0 2.0] [3.0 4.0]]]
        result: executeCpu.with: feed schedule
        resultData: result\data
        missingRejected: throws? [executeCpu schedule]
        unknownRejected: throws? [executeCpu.with: #[unknown: 1.0] schedule]
        assert -> [9.0 19.0] = resultData
        assert -> missingRejected
        assert -> unknownRejected
    ]

    test "freezes parameter values into the schedule" [
        model: graph [
            x: input
            w: parameter 2.0
            prediction: x * w
        ]
        data: graphData model
        schedule: scheduleGraph data 'prediction
        model\w\value\data: [3.0]
        feed: #[x: tensor [2.0]]
        scheduled: executeCpu.with: feed schedule
        scheduledValue: scheduled\data\0
        assert -> 4.0 = scheduledValue
    ]

    test "executes arbitrary-rank reductions and indexing" [
        xNode: lrInputFrom tensor.zeros [2 2 2]
        model: graph [
            x: xNode
            reduced: tensorSum.axis: 1 x
            picked: tensorAt reduced [1 0]
            result: square picked
        ]
        feed: #[x: tensor [[[1 2] [3 4]] [[5 6] [7 8]]]]
        forward.with: feed model
        eager: model\result\value
        data: graphData model
        schedule: scheduleGraph data 'result
        cpu: executeCpu.with: feed schedule
        assert -> eager\data = cpu\data
        assert -> [144.0] = cpu\data
    ]

    test "keeps axis-sensitive operations distinct during CSE" [
        xNode: lrInputFrom tensor.zeros [2 2]
        model: graph [
            x: xNode
            columns: tensorSum.axis: 0 x
            rows: tensorSum.axis: 1 x
            total: columns + rows
        ]
        data: graphData model
        deduplicated: eliminateCommonSubexpressions data
        assert -> 'operation = deduplicated\nodes\columns\role
        assert -> 'operation = deduplicated\nodes\rows\role
    ]
]
